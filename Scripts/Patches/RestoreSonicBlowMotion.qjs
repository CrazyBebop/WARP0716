///
/// \brief Gives AS_SONICBLOW (136) back the attacker's sprite animation that
///        Gravity unhooked. Self-contained static EXE patch, constant size, no
///        code cave.
///
///        NOTHING of the animation itself was removed. The client plays an
///        actor's attack animation by posting MESSAGE 108 to it; that handler
///        (case 108 of the CActorSprite message switch @ 0x00C4AFD7, block
///        0x00C4CF4C) is still byte-for-byte what it was in 2018:
///            [vtable+0x3C](2, 1)        // 2 = ACTOR_STATE.ST_ATTACK
///            [vtable+0x94]() -> float   -> [actor+0x378]  (attack sound frame)
///            timeGetTime                -> [actor+0x8C]
///            [actor+0x3C] = 4
///            Actor_UpdateMaxField58Scaled(actor, 1.0f)
///            [vtable+0x10]([actor+0x4C]) -> add [actor+0x38]
///
///        What was removed is the COMPARISON that selected it. In the skill-hit
///        handler (CActorSprite_OnMsg37_SkillHitVisual, 0x00C600F0) a 2018-06-20
///        client still reads:
///            0x009E0BCD  cmp esi, 88h          ; 136 = AS_SONICBLOW
///            0x009E0C51  mov [ebp+var_7C], 6Ch ; 108 = deferred message id
///                        mov [ebp+var_60], 7Ah ; 122 = EF_SONICBLOWHIT
///        In 2025-07-16 that whole chain survives -- 0x7E6, 0x110 and 0x174 are
///        all still tested at 0x00C617DF -- but the 136 test is gone, so the
///        message id never becomes 108 and the sprite keeps its plain attack.
///        The 122 survived through the session skill->effect table (+0x6E0),
///        which is why the sound and the particles still play today.
///
///        The fix routes skill 136 into the branch that still posts message 108:
///        the one of CH_CHAINCRUSH (0x174 / 372), another rapid multi-hit melee
///        skill whose animation was never lost. Rewriting the id at this exact
///        point is safe because every skill->effect lookup already happened
///        upstream (0x00C608B6); only the deferred-message build reads it after.
///
///        The 12 bytes come from the GC_CROSSIMPACT branch (0x7E6), which is
///        inert here: it jumps into a switch keyed on (skillId - 0x1464) that
///        does not cover 0x7E6, so it lands in the generic default anyway.
///
///        Verified live on 2026-08-13: patched in memory, Sonic Blow's sprite
///        animation came back.
///
///        Target: 2025-07-16 Ragexe, image base 0x00400000.
///

const SonicBlowMotion = {
	BuildDate: 20250716,

	// Unique in the whole image (checked: exactly one occurrence).
	//   81 FF E6 07 00 00    cmp edi, 7E6h        ; GC_CROSSIMPACT
	//   0F 84 65 02 00 00    jz  0x00C61A50
	// The trailing `8B 45 D8` (mov eax,[ebp-28h]) is the untouched fall-through
	// and is matched too, so we can never patch a lookalike.
	Stolen: "81 FF E6 07 00 00 0F 84 65 02 00 00 8B 45 D8",

	// Same 12 bytes, replaced in place:
	//   66 81 FF 88 00    cmp di, 88h        ; AS_SONICBLOW ?
	//   75 05             jne +5
	//   BF 74 01 00 00    mov edi, 174h      ; -> take the CH_CHAINCRUSH path
	// The jne lands exactly on the original fall-through instruction.
	Patch: "66 81 FF 88 00 75 05 BF 74 01 00 00"
};

SonicBlowMotion.hexNorm = function(hex)
{
	return (hex || "").replace(/\s+/g, " ").trim().toUpperCase();
};

///
/// \brief Locates the stolen bytes by signature (never by hardcoded address, so
///        the patch survives a client rebuild that shifts the function).
///
SonicBlowMotion.findSite = function()
{
	const addrs = Exe.FindHexN(SonicBlowMotion.Stolen);
	if (!addrs || addrs.length === 0)
		throw Error("RestoreSonicBlowMotion: skill-id chain not found");

	// A second match would mean the signature no longer identifies the skill-hit
	// handler on its own; patching blind there could hit an unrelated function.
	if (addrs.length > 1)
		throw Error(`RestoreSonicBlowMotion: skill-id chain is not unique (${addrs.length} matches)`);

	return addrs[0];
};

RestoreSonicBlowMotion = function(_)
{
	if (Exe.BuildDate !== SonicBlowMotion.BuildDate)
		throw Error("RestoreSonicBlowMotion supports only the 2025-07-16 client");

	$$(_, 1, `Locate the skill-id chain of the skill-hit handler`)
	const addr = SonicBlowMotion.findSite();

	$$(_, 2, `Route AS_SONICBLOW (136) into the branch that still posts message 108`)
	Exe.SetHex(addr, SonicBlowMotion.Patch);

	return true;
};

RestoreSonicBlowMotion.validate = function()
{
	if (Exe.BuildDate !== SonicBlowMotion.BuildDate)
		return false;
	try
	{
		SonicBlowMotion.findSite();
		return true;
	}
	catch (error)
	{
		return false;
	}
};
