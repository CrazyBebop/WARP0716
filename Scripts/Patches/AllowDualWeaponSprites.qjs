AllowDualWeaponSprites = function(_)
{
	return AllowDualCustomWeaponSprites(_ || "AllowDualWeaponSprites");
};

AllowDualWeaponSprites.validate = function()
{
	return AllowDualCustomWeaponSprites.validate();
};
