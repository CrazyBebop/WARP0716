	$$(_, 2.1, `Allocate the strings, the state and the vtables`)
	/// a std::string record (24 bytes: the text inline below 16 bytes, else a pointer to it), read-only
	const stdStr = (hex) =>
	{
		const [p, v] = Exe.Allocate(0x18, 4);
		const n = hex.byteCount();
		if (n < 16)
			Exe.SetHex(p, hex + " 00".repeat(16 - n) + n.toHex(4) + (15).toHex(4));
		else
		{
			const [tp, tv] = Exe.Allocate(n + 1, 4);
			Exe.SetHex(tp, hex + " 00");
			Exe.SetHex(p, tv.toHex(4) + " 00".repeat(12) + n.toHex(4) + n.toHex(4));
		}
		return v;
	};
	const cStr = (hex) =>
	{
		const [p, v] = Exe.Allocate(hex.byteCount() + 1, 4);
		Exe.SetHex(p, hex + " 00");
		return v;
	};
