	robeBuild.h(" 39 7D EC");                       // CMP DWORD [EBP - 0x14], EDI
	robeBuild.j(JLE, ".Lf44480");               // JLE .Lf44480
	robeBuild.at(".Lf443e2");
	robeBuild.h(" 8D 45 F3");                       // LEA EAX, [EBP - 0xD]
	robeBuild.h(" C6 45 F3 00");                    // MOV BYTE [EBP - 0xD], 0
	robeBuild.h(" 50");                             // PUSH EAX
	robeBuild.h(" 57");                             // PUSH EDI
	robeBuild.h(" 68 " + (sDB).toHex(4));           // PUSH sDB
	robeBuild.h(" 83 EC 18");                       // SUB ESP, 0x18
	robeBuild.h(" 89 E6");                          // MOV ESI, ESP
	robeBuild.h(" 89 65 E0");                       // MOV DWORD [EBP - 0x20], ESP
	robeBuild.h(" 6A 0A");                          // PUSH 0xA
	robeBuild.h(" 68 " + (sIsTop).toHex(4));        // PUSH sIsTop
	robeBuild.h(" C7 06 00 00 00 00");              // MOV DWORD [ESI], 0
	robeBuild.h(" C7 46 10 00 00 00 00");           // MOV DWORD [ESI + 0x10], 0
	robeBuild.h(" C7 46 14 0F 00 00 00");           // MOV DWORD [ESI + 0x14], 0xF
	robeBuild.h(" 56");                             // PUSH ESI
	robeBuild.h(" C7 46 10 0A 00 00 00");           // MOV DWORD [ESI + 0x10], 0xA
