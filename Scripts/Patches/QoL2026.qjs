	/// Asm: code with labelled jumps in one allocation. h(hex) the bytes, j(kind, to) a jump or call
	/// to a label (".name") or an address, at(".name") a label here, put() places it -> its address.
	function Asm()
	{
		this.c = "";
		this.n = 0;
		this.t = {};
		this.l = {};
	}
	Asm.prototype.h = function(hex) { this.c += hex; };
	Asm.prototype.j = function(kind, to) { this.n++; this.t[this.n] = to; this.c += kind(Filler(this.n)); };
	Asm.prototype.at = function(name) { this.l[name] = this.c.byteCount(); };
	Asm.prototype.put = function()
	{
		const [p, v] = Exe.Allocate(this.c.byteCount(), 0x10);
		const t = {start: v};
		for (const k in this.t)
		{
			const to = this.t[k];
			if (typeof to === "string" && this.l[to] === undefined)
				throw Error("Quality of Life Changes (2026), Render Scaling: no label " + to);
			t[k] = (typeof to === "string") ? v + this.l[to] : to;
		}
		Exe.SetHex(p, SetFillTargets(this.c, t));
		return v;
	};

