	const sBg = stdStr(" C0 AF C0 FA C0 CE C5 CD C6 E4 C0 CC BD BA 5C 65 71 75 69 70 5F 70 72 65 76 69 65 77 5C 62 67 5F 6D 6F 75 6E 74 69 6E 67 32 2E 62 6D 70");
