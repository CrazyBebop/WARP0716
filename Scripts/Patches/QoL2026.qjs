	/// std::vector<bool>::resize(n, false) (2026 0x00605CF0; 07-16 has no instance): the one case the builders use, an empty vector grown to n zero bits (a vector that already has storage is left as it is)
	const bitsResize = new Asm();
	bitsResize.h(" 55");                             // PUSH EBP
	bitsResize.h(" 89 E5");                          // MOV EBP, ESP
	bitsResize.h(" 56");                             // PUSH ESI
	bitsResize.h(" 57");                             // PUSH EDI
	bitsResize.h(" 89 CE");                          // MOV ESI, ECX
	bitsResize.h(" 8B 7D 08");                       // MOV EDI, DWORD [EBP + 8]
	bitsResize.h(" 3B 7E 0C");                       // CMP EDI, DWORD [ESI + 0xC]
