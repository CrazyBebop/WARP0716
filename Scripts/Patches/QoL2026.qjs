	cvLoad.h(loadStolen);                        // the client's own displaced bytes
	cvLoad.j(JMP, loadBackV);                // JMP loadBackV
	const cvLoadV = cvLoad.put();

	/// COptions::SaveSettings: RenderScalingPercent written after bQuickSlot, before the file closes (2026 0x00F07453)
	const cvSave = new Asm();
	cvSave.h(" FF 35 " + (rsSaved).toHex(4));    // PUSH DWORD [rsSaved]
	cvSave.h(" 68 " + (rsKey).toHex(4));         // PUSH rsKey
