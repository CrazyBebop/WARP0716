	robeBuild.j(JE, ".Lf44566");                // JE .Lf44566
	robeBuild.h(" BF 01 00 00 00");                 // MOV EDI, 1
	robeBuild.h(" 39 7D EC");                       // CMP DWORD [EBP - 0x14], EDI
	robeBuild.j(JLE, ".Lf44566");               // JLE .Lf44566
	robeBuild.h(" 0F 1F 00");                       // NOP DWORD [EAX]
	robeBuild.at(".Lf444b0");
	robeBuild.h(" 8D 45 E4");                       // LEA EAX, [EBP - 0x1C]
	robeBuild.h(" C7 45 E4 00 00 00 00");           // MOV DWORD [EBP - 0x1C], 0
	robeBuild.h(" 50");                             // PUSH EAX
	robeBuild.h(" 57");                             // PUSH EDI
	robeBuild.h(" 68 " + (sDD).toHex(4));           // PUSH sDD
	robeBuild.h(" 83 EC 18");                       // SUB ESP, 0x18
	robeBuild.h(" 89 E6");                          // MOV ESI, ESP
	robeBuild.h(" 89 65 DC");                       // MOV DWORD [EBP - 0x24], ESP
	robeBuild.h(" 6A 20");                          // PUSH 0x20
	robeBuild.h(" C7 06 00 00 00 00");              // MOV DWORD [ESI], 0
	robeBuild.h(" C7 46 10 00 00 00 00");           // MOV DWORD [ESI + 0x10], 0
	robeBuild.h(" C7 46 14 0F 00 00 00");           // MOV DWORD [ESI + 0x14], 0xF
	robeBuild.j(CALL, opNewV);                  // CALL opNewV
	robeBuild.h(" C7 46 10 10 00 00 00");           // MOV DWORD [ESI + 0x10], 0x10
	robeBuild.h(" 83 C4 04");                       // ADD ESP, 4
	robeBuild.h(" C7 46 14 1F 00 00 00");           // MOV DWORD [ESI + 0x14], 0x1F
	robeBuild.h(" 0F 10 05 " + (sSaveRobe).toHex(4)); // MOVUPS XMM0, XMMWORD PTR [sSaveRobe]
	robeBuild.h(" 0F 11 00");                       // MOVUPS XMMWORD PTR [EAX], XMM0
	robeBuild.h(" C6 40 10 00");                    // MOV BYTE [EAX + 0x10], 0
	robeBuild.h(" 89 06");                          // MOV DWORD [ESI], EAX
	robeBuild.h(" C7 45 FC 02 00 00 00");           // MOV DWORD [EBP - 4], 2
	robeBuild.h(" FF 35 " + (luaObj).toHex(4));     // PUSH DWORD [luaObj]
	robeBuild.h(" C7 45 FC FF FF FF FF");           // MOV DWORD [EBP - 4], 0xFFFFFFFF
	robeBuild.j(CALL, luaCallV);                // CALL luaCallV
	robeBuild.h(" 8B 75 E4");                       // MOV ESI, DWORD [EBP - 0x1C]
	robeBuild.h(" 83 C4 28");                       // ADD ESP, 0x28
	robeBuild.h(" 85 F6");                          // TEST ESI, ESI
	robeBuild.j(JE, ".Lf44566");                // JE .Lf44566
	robeBuild.h(" 3B 75 EC");                       // CMP ESI, DWORD [EBP - 0x14]
	robeBuild.j(JB, ".Lrobeok");                // JB .Lrobeok
	robeBuild.h(" 47");                             // INC EDI
	robeBuild.j(JMP, ".Lrobecmp");              // JMP .Lrobecmp
	robeBuild.at(".Lrobeok");
	robeBuild.h(" 8B 0D " + (robeTop).toHex(4));    // MOV ECX, DWORD [robeTop]
	robeBuild.h(" 89 F0");                          // MOV EAX, ESI
	robeBuild.h(" C1 E8 05");                       // SHR EAX, 5
	robeBuild.h(" 83 E6 1F");                       // AND ESI, 0x1F
	robeBuild.h(" 8D 14 81");                       // LEA EDX, [ECX + EAX*4]
	robeBuild.h(" 8B 04 81");                       // MOV EAX, DWORD [ECX + EAX*4]
	robeBuild.h(" 89 55 E0");                       // MOV DWORD [EBP - 0x20], EDX
	robeBuild.h(" 89 F1");                          // MOV ECX, ESI
	robeBuild.h(" BA 01 00 00 00");                 // MOV EDX, 1
	robeBuild.h(" D3 E2");                          // SHL EDX, CL
	robeBuild.h(" 85 D0");                          // TEST EAX, EDX
	robeBuild.j(JNE, ".Lf44554");               // JNE .Lf44554
	robeBuild.h(" 0F AB F0");                       // BTS EAX, ESI
	robeBuild.j(JMP, ".Lf44557");               // JMP .Lf44557
	robeBuild.at(".Lf44554");
	robeBuild.h(" 0F B3 F0");                       // BTR EAX, ESI
	robeBuild.at(".Lf44557");
	robeBuild.h(" 8B 4D E0");                       // MOV ECX, DWORD [EBP - 0x20]
	robeBuild.h(" 47");                             // INC EDI
	robeBuild.h(" 89 01");                          // MOV DWORD [ECX], EAX
	robeBuild.at(".Lrobecmp");
	robeBuild.h(" 3B 7D EC");                       // CMP EDI, DWORD [EBP - 0x14]
	robeBuild.j(JL, ".Lf444b0");                // JL .Lf444b0
	robeBuild.at(".Lf44566");
	robeBuild.h(" 8B 4D F4");                       // MOV ECX, DWORD [EBP - 0xC]
	robeBuild.h(" 64 89 0D 00 00 00 00");           // MOV DWORD FS:[0], ECX
	robeBuild.h(" 59");                             // POP ECX
	robeBuild.h(" 5F");                             // POP EDI
	robeBuild.h(" 5E");                             // POP ESI
	robeBuild.h(" 89 EC");                          // MOV ESP, EBP
	robeBuild.h(" 5D");                             // POP EBP
	robeBuild.h(" C3");                             // RET
	const robeBuildV = robeBuild.put();

	/// the side-layer bitset (2026 0x00F441D0, right after): ReqRobSprTopId() + 1 bits, Lua IsSideLayer(i) each
	const robeSideBuild = new Asm();
	robeSideBuild.h(" 55");                             // PUSH EBP
	robeSideBuild.h(" 89 E5");                          // MOV EBP, ESP
	robeSideBuild.h(" 6A FF");                          // PUSH -1
	robeSideBuild.h(" 68 " + (ehNoneV).toHex(4));       // PUSH ehNoneV
	robeSideBuild.h(" 64 A1 00 00 00 00");              // MOV EAX, DWORD FS:[0]
	robeSideBuild.h(" 50");                             // PUSH EAX
	robeSideBuild.h(" 83 EC 0C");                       // SUB ESP, 0xC
	robeSideBuild.h(" 53");                             // PUSH EBX
	robeSideBuild.h(" 56");                             // PUSH ESI
	robeSideBuild.h(" 57");                             // PUSH EDI
	robeSideBuild.h(" A1 " + (cookie).toHex(4));        // MOV EAX, DWORD [cookie]
	robeSideBuild.h(" 31 E8");                          // XOR EAX, EBP
	robeSideBuild.h(" 50");                             // PUSH EAX
	robeSideBuild.h(" 8D 45 F4");                       // LEA EAX, [EBP - 0xC]
	robeSideBuild.h(" 64 A3 00 00 00 00");              // MOV DWORD FS:[0], EAX
	robeSideBuild.h(" 89 CB");                          // MOV EBX, ECX
	robeSideBuild.h(" 8D 45 EC");                       // LEA EAX, [EBP - 0x14]
	robeSideBuild.h(" C7 45 EC 00 00 00 00");           // MOV DWORD [EBP - 0x14], 0
	robeSideBuild.h(" 50");                             // PUSH EAX
	robeSideBuild.h(" 68 " + (sOutD).toHex(4));         // PUSH sOutD
	robeSideBuild.h(" 83 EC 18");                       // SUB ESP, 0x18
	robeSideBuild.h(" 89 E6");                          // MOV ESI, ESP
	robeSideBuild.h(" 89 65 E8");                       // MOV DWORD [EBP - 0x18], ESP
	robeSideBuild.h(" 6A 0E");                          // PUSH 0xE
	robeSideBuild.h(" 68 " + (sReqTopId).toHex(4));     // PUSH sReqTopId
	robeSideBuild.h(" C7 06 00 00 00 00");              // MOV DWORD [ESI], 0
	robeSideBuild.h(" C7 46 10 00 00 00 00");           // MOV DWORD [ESI + 0x10], 0
	robeSideBuild.h(" C7 46 14 0F 00 00 00");           // MOV DWORD [ESI + 0x14], 0xF
	robeSideBuild.h(" 56");                             // PUSH ESI
	robeSideBuild.h(" C7 46 10 0E 00 00 00");           // MOV DWORD [ESI + 0x10], 0xE
	robeSideBuild.h(" FF 15 " + (memcpyIat).toHex(4));  // CALL DWORD [memcpyIat]
	robeSideBuild.h(" 83 C4 0C");                       // ADD ESP, 0xC
	robeSideBuild.h(" C6 46 0E 00");                    // MOV BYTE [ESI + 0xE], 0
	robeSideBuild.h(" C7 45 FC 00 00 00 00");           // MOV DWORD [EBP - 4], 0
	robeSideBuild.h(" FF 35 " + (luaObj).toHex(4));     // PUSH DWORD [luaObj]
	robeSideBuild.h(" C7 45 FC FF FF FF FF");           // MOV DWORD [EBP - 4], 0xFFFFFFFF
	robeSideBuild.j(CALL, luaCallV);                // CALL luaCallV
	robeSideBuild.h(" 8B 45 EC");                       // MOV EAX, DWORD [EBP - 0x14]
	robeSideBuild.h(" B9 " + (sideVec).toHex(4));       // MOV ECX, sideVec
	robeSideBuild.h(" 83 C4 24");                       // ADD ESP, 0x24
	robeSideBuild.h(" 40");                             // INC EAX
	robeSideBuild.h(" 89 45 EC");                       // MOV DWORD [EBP - 0x14], EAX
	robeSideBuild.h(" 6A 00");                          // PUSH 0
	robeSideBuild.h(" 50");                             // PUSH EAX
	robeSideBuild.j(CALL, bitsResizeV);             // CALL bitsResizeV
	robeSideBuild.h(" BF 01 00 00 00");                 // MOV EDI, 1
	robeSideBuild.h(" 39 7D EC");                       // CMP DWORD [EBP - 0x14], EDI
	robeSideBuild.j(JLE, ".Lf44310");               // JLE .Lf44310
	robeSideBuild.at(".Lf44280");
	robeSideBuild.h(" 8D 45 F3");                       // LEA EAX, [EBP - 0xD]
	robeSideBuild.h(" C6 45 F3 00");                    // MOV BYTE [EBP - 0xD], 0
	robeSideBuild.h(" 50");                             // PUSH EAX
	robeSideBuild.h(" 57");                             // PUSH EDI
	robeSideBuild.h(" 68 " + (sDB).toHex(4));           // PUSH sDB
	robeSideBuild.h(" 83 EC 18");                       // SUB ESP, 0x18
	robeSideBuild.h(" 89 E6");                          // MOV ESI, ESP
	robeSideBuild.h(" 89 65 E8");                       // MOV DWORD [EBP - 0x18], ESP
	robeSideBuild.h(" 6A 0B");                          // PUSH 0xB
	robeSideBuild.h(" 68 " + (sIsSide).toHex(4));       // PUSH sIsSide
	robeSideBuild.h(" C7 06 00 00 00 00");              // MOV DWORD [ESI], 0
	robeSideBuild.h(" C7 46 10 00 00 00 00");           // MOV DWORD [ESI + 0x10], 0
	robeSideBuild.h(" C7 46 14 0F 00 00 00");           // MOV DWORD [ESI + 0x14], 0xF
	robeSideBuild.h(" 56");                             // PUSH ESI
	robeSideBuild.h(" C7 46 10 0B 00 00 00");           // MOV DWORD [ESI + 0x10], 0xB
	robeSideBuild.h(" FF 15 " + (memcpyIat).toHex(4));  // CALL DWORD [memcpyIat]
	robeSideBuild.h(" 83 C4 0C");                       // ADD ESP, 0xC
	robeSideBuild.h(" C6 46 0B 00");                    // MOV BYTE [ESI + 0xB], 0
	robeSideBuild.h(" C7 45 FC 01 00 00 00");           // MOV DWORD [EBP - 4], 1
	robeSideBuild.h(" FF 35 " + (luaObj).toHex(4));     // PUSH DWORD [luaObj]
	robeSideBuild.h(" C7 45 FC FF FF FF FF");           // MOV DWORD [EBP - 4], 0xFFFFFFFF
	robeSideBuild.j(CALL, luaCallV);                // CALL luaCallV
	robeSideBuild.h(" A1 " + (sideTop).toHex(4));       // MOV EAX, DWORD [sideTop]
	robeSideBuild.h(" 89 F9");                          // MOV ECX, EDI
	robeSideBuild.h(" C1 E9 05");                       // SHR ECX, 5
	robeSideBuild.h(" 83 C4 28");                       // ADD ESP, 0x28
	robeSideBuild.h(" 8D 14 88");                       // LEA EDX, [EAX + ECX*4]
	robeSideBuild.h(" 89 F9");                          // MOV ECX, EDI
	robeSideBuild.h(" 8B 02");                          // MOV EAX, DWORD [EDX]
	robeSideBuild.h(" 83 E1 1F");                       // AND ECX, 0x1F
	robeSideBuild.h(" 80 7D F3 00");                    // CMP BYTE [EBP - 0xD], 0
	robeSideBuild.j(JE, ".Lf44301");                // JE .Lf44301
	robeSideBuild.h(" 0F AB C8");                       // BTS EAX, ECX
	robeSideBuild.j(JMP, ".Lf44304");               // JMP .Lf44304
	robeSideBuild.at(".Lf44301");
	robeSideBuild.h(" 0F B3 C8");                       // BTR EAX, ECX
	robeSideBuild.at(".Lf44304");
	robeSideBuild.h(" 47");                             // INC EDI
	robeSideBuild.h(" 89 02");                          // MOV DWORD [EDX], EAX
	robeSideBuild.h(" 3B 7D EC");                       // CMP EDI, DWORD [EBP - 0x14]
	robeSideBuild.j(JL, ".Lf44280");                // JL .Lf44280
	robeSideBuild.at(".Lf44310");
	robeSideBuild.h(" 8B 4D F4");                       // MOV ECX, DWORD [EBP - 0xC]
	robeSideBuild.h(" 64 89 0D 00 00 00 00");           // MOV DWORD FS:[0], ECX
	robeSideBuild.h(" 59");                             // POP ECX
	robeSideBuild.h(" 5F");                             // POP EDI
	robeSideBuild.h(" 5E");                             // POP ESI
	robeSideBuild.h(" 5B");                             // POP EBX
	robeSideBuild.h(" 89 EC");                          // MOV ESP, EBP
	robeSideBuild.h(" 5D");                             // POP EBP
	robeSideBuild.h(" C3");                             // RET
	const robeSideBuildV = robeSideBuild.put();

	/// the two bitsets read once (ecx = the session), when the client's Lua is up: 2026 calls robeBuild and robeSideBuild at its Lua start (0x00EEB79D), 07-16's Lua start comes here too (step 4.4), and a garment question before that asks again
	const pvRobeInit = new Asm();
	pvRobeInit.h(" 80 3D " + (robeTried).toHex(4) + " 00"); // CMP BYTE [robeTried], 0
	pvRobeInit.j(JNE, ".Lout");                  // JNE .Lout
	pvRobeInit.h(" A1 " + (luaObj).toHex(4));        // MOV EAX, DWORD [luaObj]
	pvRobeInit.h(" 85 C0");                          // TEST EAX, EAX
	pvRobeInit.j(JE, ".Lout");                   // JE .Lout
	pvRobeInit.h(" 83 38 00");                       // CMP DWORD [EAX], 0
	pvRobeInit.j(JE, ".Lout");                   // JE .Lout
	pvRobeInit.h(" C6 05 " + (robeTried).toHex(4) + " 01"); // MOV BYTE [robeTried], 1
	pvRobeInit.h(" 56");                             // PUSH ESI
	pvRobeInit.h(" 89 CE");                          // MOV ESI, ECX
	pvRobeInit.j(CALL, robeBuildV);              // CALL robeBuildV
	pvRobeInit.h(" 89 F1");                          // MOV ECX, ESI
	pvRobeInit.j(CALL, robeSideBuildV);          // CALL robeSideBuildV
	pvRobeInit.h(" 5E");                             // POP ESI
	pvRobeInit.at(".Lout");
	pvRobeInit.h(" C3");                             // RET
	const pvRobeInitV = pvRobeInit.put();

	/// SaveData\SpriteRobeTopLayer.lua written (2026 0x00F503C0, ecx = the session): 'Save_RobeTopLayer = { id, ... }' with every garment whose bit differs from the Lua IsTopLayer answer, through 07-16's own CFile as its writers build it (0x00D78B40); 2026 writes an empty list when the bits could not be read, this writes nothing then (the saved choices are kept)
	const robeSave = new Asm();
	robeSave.h(" 55");                             // PUSH EBP
	robeSave.h(" 89 E5");                          // MOV EBP, ESP
	robeSave.h(" 83 EC 50");                       // SUB ESP, 0x50
	robeSave.h(" 53");                             // PUSH EBX
	robeSave.h(" 56");                             // PUSH ESI
	robeSave.h(" 57");                             // PUSH EDI
	robeSave.j(CALL, pvRobeInitV);             // CALL pvRobeInitV
	robeSave.h(" 83 3D " + (robeCount).toHex(4) + " 00"); // CMP DWORD [robeCount], 0
	robeSave.j(JE, ".Lout");                   // JE .Lout
	robeSave.h(" C7 45 D0 " + (vtFile).toHex(4));  // MOV DWORD [EBP - 0x30], vtFile
	robeSave.h(" C7 45 D4 FF FF FF FF");           // MOV DWORD [EBP - 0x2C], -1
	robeSave.h(" C7 45 D8 00 00 00 00");           // MOV DWORD [EBP - 0x28], 0
	robeSave.h(" C7 45 DC 00 00 00 00");           // MOV DWORD [EBP - 0x24], 0
	robeSave.h(" C7 45 E0 00 00 00 00");           // MOV DWORD [EBP - 0x20], 0
	robeSave.h(" C7 45 F4 00 00 00 00");           // MOV DWORD [EBP - 0xC], 0
	robeSave.h(" C7 45 F8 0F 00 00 00");           // MOV DWORD [EBP - 0x8], 0xF
	robeSave.h(" C6 45 E4 00");                    // MOV BYTE [EBP - 0x1C], 0
	robeSave.h(" 6A 01");                          // PUSH 1
	robeSave.h(" 6A 01");                          // PUSH 1
	robeSave.h(" 68 01 10 00 00");                 // PUSH 0x1001
	robeSave.h(" 68 " + (sRobeFile).toHex(4));     // PUSH sRobeFile
	robeSave.h(" 8D 4D D0");                       // LEA ECX, [EBP - 0x30]
	robeSave.j(CALL, fileOpenV);               // CALL fileOpenV
	robeSave.h(" 84 C0");                          // TEST AL, AL
	robeSave.j(JE, ".Lclose");                 // JE .Lclose
	robeSave.h(" 6A 19");                          // PUSH 0x19
	robeSave.h(" 68 " + (sRobeHead).toHex(4));     // PUSH sRobeHead
	robeSave.h(" 8D 4D D0");                       // LEA ECX, [EBP - 0x30]
	robeSave.j(CALL, fileWriteV);              // CALL fileWriteV
	robeSave.h(" BF 01 00 00 00");                 // MOV EDI, 1
	robeSave.h(" 39 3D " + (robeCount).toHex(4));  // CMP DWORD [robeCount], EDI
	robeSave.j(JBE, ".Ltail");                 // JBE .Ltail
	robeSave.at(".Lloop");
	robeSave.h(" C6 45 CF 00");                    // MOV BYTE [EBP - 0x31], 0
	robeSave.h(" 8D 45 CF");                       // LEA EAX, [EBP - 0x31]
	robeSave.h(" 50");                             // PUSH EAX
	robeSave.h(" 57");                             // PUSH EDI
	robeSave.h(" 68 " + (sDB).toHex(4));           // PUSH sDB
	robeSave.h(" 83 EC 18");                       // SUB ESP, 0x18
	robeSave.h(" 89 E6");                          // MOV ESI, ESP
	robeSave.h(" C7 06 00 00 00 00");              // MOV DWORD [ESI], 0
	robeSave.h(" C7 46 10 0A 00 00 00");           // MOV DWORD [ESI + 0x10], 0xA
	robeSave.h(" C7 46 14 0F 00 00 00");           // MOV DWORD [ESI + 0x14], 0xF
	robeSave.h(" 6A 0A");                          // PUSH 0xA
	robeSave.h(" 68 " + (sIsTop).toHex(4));        // PUSH sIsTop
	robeSave.h(" 56");                             // PUSH ESI
	robeSave.h(" FF 15 " + (memcpyIat).toHex(4));  // CALL DWORD [memcpyIat]
	robeSave.h(" 83 C4 0C");                       // ADD ESP, 0xC
	robeSave.h(" C6 46 0A 00");                    // MOV BYTE [ESI + 0xA], 0
	robeSave.h(" FF 35 " + (luaObj).toHex(4));     // PUSH DWORD [luaObj]
	robeSave.j(CALL, luaCallV);                // CALL luaCallV
	robeSave.h(" 83 C4 28");                       // ADD ESP, 0x28
	robeSave.h(" 89 F9");                          // MOV ECX, EDI
	robeSave.h(" 83 E1 1F");                       // AND ECX, 0x1F
	robeSave.h(" BA 01 00 00 00");                 // MOV EDX, 1
	robeSave.h(" D3 E2");                          // SHL EDX, CL
	robeSave.h(" 8B 35 " + (robeTop).toHex(4));    // MOV ESI, DWORD [robeTop]
	robeSave.h(" 89 F8");                          // MOV EAX, EDI
	robeSave.h(" C1 E8 05");                       // SHR EAX, 5
	robeSave.h(" 85 14 86");                       // TEST DWORD [ESI + EAX*4], EDX
	robeSave.h(" 0F 95 C0");                       // SETNE AL
	robeSave.h(" 38 45 CF");                       // CMP BYTE [EBP - 0x31], AL
	robeSave.j(JE, ".Lnext");                  // JE .Lnext
	robeSave.h(" 57");                             // PUSH EDI
	robeSave.h(" 68 " + (sRobeLine).toHex(4));     // PUSH sRobeLine
	robeSave.h(" 8D 45 B0");                       // LEA EAX, [EBP - 0x50]
	robeSave.h(" 50");                             // PUSH EAX
	robeSave.j(CALL, fmtV);                    // CALL fmtV
	robeSave.h(" 83 C4 0C");                       // ADD ESP, 0xC
	robeSave.h(" 8D 45 B0");                       // LEA EAX, [EBP - 0x50]
	robeSave.h(" 83 7D C4 10");                    // CMP DWORD [EBP - 0x3C], 0x10
	robeSave.h(" 0F 43 45 B0");                    // CMOVAE EAX, DWORD [EBP - 0x50]
	robeSave.h(" FF 75 C0");                       // PUSH DWORD [EBP - 0x40]
	robeSave.h(" 50");                             // PUSH EAX
	robeSave.h(" 8D 4D D0");                       // LEA ECX, [EBP - 0x30]
	robeSave.j(CALL, fileWriteV);              // CALL fileWriteV
	robeSave.h(" 8D 4D B0");                       // LEA ECX, [EBP - 0x50]
	robeSave.j(CALL, strDtorV);                // CALL strDtorV
	robeSave.at(".Lnext");
	robeSave.h(" 47");                             // INC EDI
	robeSave.h(" 3B 3D " + (robeCount).toHex(4));  // CMP EDI, DWORD [robeCount]
	robeSave.j(JB, ".Lloop");                  // JB .Lloop
	robeSave.at(".Ltail");
	robeSave.h(" 6A 01");                          // PUSH 1
	robeSave.h(" 68 " + (sBrace).toHex(4));        // PUSH sBrace
	robeSave.h(" 8D 4D D0");                       // LEA ECX, [EBP - 0x30]
	robeSave.j(CALL, fileWriteV);              // CALL fileWriteV
	robeSave.at(".Lclose");
	robeSave.h(" 8D 4D D0");                       // LEA ECX, [EBP - 0x30]
	robeSave.j(CALL, fileCloseV);              // CALL fileCloseV
	robeSave.h(" 8D 4D E4");                       // LEA ECX, [EBP - 0x1C]
	robeSave.j(CALL, strDtorV);                // CALL strDtorV
	robeSave.at(".Lout");
	robeSave.h(" 5F");                             // POP EDI
	robeSave.h(" 5E");                             // POP ESI
	robeSave.h(" 5B");                             // POP EBX
	robeSave.h(" 89 EC");                          // MOV ESP, EBP
	robeSave.h(" 5D");                             // POP EBP
	robeSave.h(" C3");                             // RET
	const robeSaveV = robeSave.put();

	/// the garment layer toggle (2026 0x00C08840), (checked): the previewed garment's top-layer bit, saved, redrawn
	const pvLayer = new Asm();
	pvLayer.h(" 55");                             // PUSH EBP
	pvLayer.h(" 89 E5");                          // MOV EBP, ESP
	pvLayer.h(" 51");                             // PUSH ECX
	pvLayer.h(" 56");                             // PUSH ESI
	pvLayer.h(" 57");                             // PUSH EDI
	pvLayer.h(" 89 CF");                          // MOV EDI, ECX
	pvLayer.h(" C7 45 FC 04 00 00 00");           // MOV DWORD [EBP - 4], 4
	pvLayer.h(" 8D 45 FC");                       // LEA EAX, [EBP - 4]
	pvLayer.h(" 50");                             // PUSH EAX
	pvLayer.h(" 8D 8F 4C 01 00 00");              // LEA ECX, [EDI + 0x14C]
	pvLayer.j(CALL, pvMapAtV);                // CALL pvMapAtV
	pvLayer.h(" 83 38 00");                       // CMP DWORD [EAX], 0
	pvLayer.j(JLE, ".Lc088db");               // JLE .Lc088db
	pvLayer.h(" 8D 45 FC");                       // LEA EAX, [EBP - 4]
	pvLayer.h(" C7 45 FC 04 00 00 00");           // MOV DWORD [EBP - 4], 4
	pvLayer.h(" 50");                             // PUSH EAX
	pvLayer.h(" 8D 8F 4C 01 00 00");              // LEA ECX, [EDI + 0x14C]
	pvLayer.j(CALL, pvMapAtV);                // CALL pvMapAtV
	pvLayer.h(" 8B 00");                          // MOV EAX, DWORD [EAX]
	pvLayer.h(" 3B 05 " + (robeCount).toHex(4));  // CMP EAX, DWORD [robeCount]
	pvLayer.j(JAE, ".Lc088db");               // JAE .Lc088db
	pvLayer.h(" 8D 45 FC");                       // LEA EAX, [EBP - 4]
	pvLayer.h(" C7 45 FC 04 00 00 00");           // MOV DWORD [EBP - 4], 4
	pvLayer.h(" 50");                             // PUSH EAX
	pvLayer.h(" 8D 8F 4C 01 00 00");              // LEA ECX, [EDI + 0x14C]
	pvLayer.j(CALL, pvMapAtV);                // CALL pvMapAtV
	pvLayer.h(" 8B 10");                          // MOV EDX, DWORD [EAX]
	pvLayer.h(" 89 D1");                          // MOV ECX, EDX
	pvLayer.h(" A1 " + (robeTop).toHex(4));       // MOV EAX, DWORD [robeTop]
	pvLayer.h(" 83 E2 1F");                       // AND EDX, 0x1F
	pvLayer.h(" C1 E9 05");                       // SHR ECX, 5
	pvLayer.h(" 80 7D 08 00");                    // CMP BYTE [EBP + 8], 0
	pvLayer.h(" 8D 0C 88");                       // LEA ECX, [EAX + ECX*4]
	pvLayer.h(" 8B 01");                          // MOV EAX, DWORD [ECX]
	pvLayer.j(JE, ".Lc088b8");                // JE .Lc088b8
	pvLayer.h(" 0F AB D0");                       // BTS EAX, EDX
	pvLayer.j(JMP, ".Lc088bb");               // JMP .Lc088bb
	pvLayer.at(".Lc088b8");
	pvLayer.h(" 0F B3 D0");                       // BTR EAX, EDX
	pvLayer.at(".Lc088bb");
	pvLayer.h(" 89 01");                          // MOV DWORD [ECX], EAX
	pvLayer.h(" B9 " + (session).toHex(4));       // MOV ECX, session
	pvLayer.j(CALL, robeSaveV);               // CALL robeSaveV
	pvLayer.h(" 8B 07");                          // MOV EAX, DWORD [EDI]
	pvLayer.h(" 8B B0 98 00 00 00");              // MOV ESI, DWORD [EAX + 0x98]
	pvLayer.h(" 89 F1");                          // MOV ECX, ESI
	pvLayer.h(" 89 F9");                          // MOV ECX, EDI
	pvLayer.h(" FF D6");                          // CALL ESI
	pvLayer.at(".Lc088db");
	pvLayer.h(" 5F");                             // POP EDI
	pvLayer.h(" 5E");                             // POP ESI
	pvLayer.h(" 89 EC");                          // MOV ESP, EBP
	pvLayer.h(" 5D");                             // POP EBP
	pvLayer.h(" C2 04 00");                       // RET 4
	const pvLayerV = pvLayer.put();

	/// IsSideLayer(garment view, -1 = the session's current) (2026 0x00F38F00, 2026-only): the side-layer bitset's bit, false past it
	const robeIsSide = new Asm();
	robeIsSide.h(" 55");                             // PUSH EBP
	robeIsSide.h(" 89 E5");                          // MOV EBP, ESP
	robeIsSide.h(" 89 CA");                          // MOV EDX, ECX
	robeIsSide.h(" 8B 4D 08");                       // MOV ECX, DWORD [EBP + 8]
	robeIsSide.h(" 83 F9 FF");                       // CMP ECX, -1
	robeIsSide.j(JNE, ".Lf38f13");               // JNE .Lf38f13
	robeIsSide.h(" 8B 8A E0 0E 00 00");              // MOV ECX, DWORD [EDX + 0xEE0]
	robeIsSide.at(".Lf38f13");
	robeIsSide.h(" 85 C9");                          // TEST ECX, ECX
	robeIsSide.j(JS, ".Lf38f40");                // JS .Lf38f40
	robeIsSide.h(" 3B 0D " + (sideCount).toHex(4));  // CMP ECX, DWORD [sideCount]
	robeIsSide.j(JGE, ".Lf38f40");               // JGE .Lf38f40
	robeIsSide.h(" 8B 15 " + (sideTop).toHex(4));    // MOV EDX, DWORD [sideTop]
	robeIsSide.h(" B8 01 00 00 00");                 // MOV EAX, 1
	robeIsSide.h(" 56");                             // PUSH ESI
	robeIsSide.h(" 89 CE");                          // MOV ESI, ECX
	robeIsSide.h(" 83 E1 1F");                       // AND ECX, 0x1F
	robeIsSide.h(" C1 EE 05");                       // SHR ESI, 5
	robeIsSide.h(" D3 E0");                          // SHL EAX, CL
	robeIsSide.h(" 85 04 B2");                       // TEST DWORD [EDX + ESI*4], EAX
	robeIsSide.h(" 5E");                             // POP ESI
	robeIsSide.h(" 0F 95 C0");                       // SETNE AL
	robeIsSide.h(" 5D");                             // POP EBP
	robeIsSide.h(" C2 04 00");                       // RET 4
	robeIsSide.at(".Lf38f40");
	robeIsSide.h(" 30 C0");                          // XOR AL, AL
	robeIsSide.h(" 5D");                             // POP EBP
	robeIsSide.h(" C2 04 00");                       // RET 4
	const robeIsSideV = robeIsSide.put();

	/// a side-layer garment goes on top in this action (2026 0x00F44890): standing, walking or sitting, seen from the side (2, 6, 10, 14, 18, 22)
	const robeSideAct = new Asm();
	robeSideAct.h(" 55");                             // PUSH EBP
	robeSideAct.h(" 89 E5");                          // MOV EBP, ESP
	robeSideAct.h(" 8B 45 08");                       // MOV EAX, DWORD [EBP + 8]
	robeSideAct.h(" 83 F8 02");                       // CMP EAX, 2
	robeSideAct.j(JE, ".Lf448b8");                // JE .Lf448b8
