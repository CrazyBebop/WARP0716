	cvApply.h(" 85 C0");                          // TEST EAX, EAX
	cvApply.j(JE, ".Lnone");                  // JE .Lnone
	cvApply.h(" 8B 80 84 00 00 00");              // MOV EAX, DWORD [EAX + 0x84]
	cvApply.h(" 8B 80 9C 00 00 00");              // MOV EAX, DWORD [EAX + 0x9C]
	cvApply.h(" 83 C0 64");                       // ADD EAX, 0x64
	cvApply.h(" A3 " + (rsSaved).toHex(4));       // MOV DWORD [rsSaved], EAX
	cvApply.at(".Lnone");
	cvApply.h(applyStolen);                       // the client's own displaced bytes
	cvApply.j(JMP, applyBackV);               // JMP applyBackV
	const cvApplyV = cvApply.put();

	/// CUIGameSettingsUI slot 16's two page loops (each child's slot 55, load): the filtered loop instead, as 2026 calls it for both pages (0x00BF818A / 0x00BF8195); the Graphics page's scroll bar is not a CUIGroup
	const cvWinLoad = new Asm();
	cvWinLoad.h(" 89 F9");                          // MOV ECX, EDI
	cvWinLoad.j(CALL, pgEach55V);               // CALL pgEach55V
	cvWinLoad.h(" 8B 8B E0 00 00 00");              // MOV ECX, DWORD [EBX + 0xE0]
	cvWinLoad.j(CALL, pgEach55V);               // CALL pgEach55V
	cvWinLoad.j(JMP, winLoadBackV);             // JMP winLoadBackV
	const cvWinLoadV = cvWinLoad.put();

	/// CUIGroupGraphics' resolution pick, after the Apply refresh: the Render Scaling slider re-ranged for the new resolution (2026 0x00BF69E7)
	const cvRes = new Asm();
	cvRes.h(" 85 C0");                          // TEST EAX, EAX
	cvRes.j(JE, ".Lnowin");                 // JE .Lnowin
	cvRes.h(" 89 C1");                          // MOV ECX, EAX
	cvRes.j(CALL, updApplyV);               // CALL updApplyV
	cvRes.at(".Lnowin");
	cvRes.h(" 6A 00");                          // PUSH 0
	cvRes.h(" 68 " + (tdPage).toHex(4));        // PUSH tdPage
	cvRes.h(" 68 " + (tdUIWindow).toHex(4));    // PUSH tdUIWindow
	cvRes.h(" 6A 00");                          // PUSH 0
	cvRes.h(" FF 76 10");                       // PUSH DWORD [ESI + 0x10]
	cvRes.j(CALL, rtDynCastV);              // CALL rtDynCastV
	cvRes.h(" 83 C4 14");                       // ADD ESP, 0x14
	cvRes.h(" 85 C0");                          // TEST EAX, EAX
	cvRes.j(JE, ".Lout");                   // JE .Lout
	cvRes.h(" 8B 88 98 00 00 00");              // MOV ECX, DWORD [EAX + 0x98]
	cvRes.h(" 85 C9");                          // TEST ECX, ECX
	cvRes.j(JE, ".Lout");                   // JE .Lout
	cvRes.h(" 8B 81 84 00 00 00");              // MOV EAX, DWORD [ECX + 0x84]
	cvRes.h(" FF B0 9C 00 00 00");              // PUSH DWORD [EAX + 0x9C]
	cvRes.j(CALL, rsSetValueV);             // CALL rsSetValueV
	cvRes.at(".Lout");
	cvRes.j(JMP, resBackV);                 // JMP resBackV
	const cvResV = cvRes.put();

	$$(_, 4.1, `Hook the modes, the end of frame, the cursor and the options`)
	const hook = (p, size, to) =>
	{
		Exe.SetJMP(p, to);
		if (size > 5)
			Exe.SetHex(p + 5, " 90".repeat(size - 5));
	};
	hook(loginP, 6, cvLoginV);
	hook(gameP, 5, cvGameV);
	hook(dx9P, 10, cvDX9V);
	hook(dx7P, 10, cvDX7V);
	hook(mouseP, 12, cvMouseV);
	hook(loadP, 10, cvLoadV);
	hook(saveP, 8, cvSaveV);

	$$(_, 4.2, `Centre the loading picture and the cursor on the drawn size, as 2026 does`)
	Exe.SetJMP(wallP, rsDrawWallpaperV);
	Exe.SetJMP(centerP, rsCenterMouseV);

	$$(_, 4.3, `Release the scale target with its renderer`)
	Exe.SetInt32(vtDX9P, rsDtorDX9V);
	Exe.SetInt32(vtDX7P, rsDtorDX7V);

	$$(_, 4.4, `Fill the four vtables: CUIGroup's, CUIControl's and the lambdas' slots, 2026's overrides on them`)
	const fillVt = (dstP, srcP, n, own) =>
	{
		for (let k = 0; k < n; k++)
			Exe.SetInt32(dstP + 4 * k, own[k] !== undefined ? own[k] : Exe.GetInt32(srcP + 4 * k));
	};
	fillVt(vtRSP, vtGroupP, 56, {0: rsDtorV, 15: rsOnCreateV, 16: rsSlot16V, 20: grpFillV, 55: rsLoadV});
	fillVt(vtBgP, vtCtrlP, 54, {0: bgDtorV, 1: bgResizeV, 20: bgDrawV, 53: bgLoadV});
	fillVt(vtRsFnP, 0, 6, [rsFnCopyV, rsFnCopyV, rsFnCallV, fnTypeV, fnDelV, fnGetV]);
	fillVt(vtPgFnP, 0, 6, [pgFnCopyV, pgFnCopyV, pgFnCallV, fnTypeV, fnDelV, fnGetV]);

	$$(_, 4.5, `The Graphics page: 0xA0 bytes, the group and scroll bar added, its loops kept to CUIGroups`)
	Exe.SetInt32(allocP + 1, 0xA0);
	Exe.SetInt32(pgDtorP + 0x4F, 0xA0);
	hook(pgTailP, 10, cvPgCtorV);
	Exe.SetInt32(vtPageP + 4 * 15, pgOnCreateV);
	Exe.SetInt32(vtPageP + 4 * 16, pgSlot16V);
	Exe.SetInt32(vtPageP + 4 * 35, pgWheelV);
	Exe.SetInt32(vtPageP + 4 * 54, pgEach54V);
	Exe.SetInt32(vtPageP + 4 * 55, pgEach55V);

	$$(_, 4.6, `The percent in the change check, the Apply and the resolution pick`)
	hook(chkHookP, 5, cvCheckV);
	hook(applyP, 7, cvApplyV);
	hook(resHookP, 11, cvResV);
	hook(winLoopP, 0x3A, cvWinLoadV);

	return true;
};

///
/// \brief Quality of Life Changes (2026), two of its choices: kRO 2026's Equipment Preview V2 (CUIPreviewEquipV2)
///        and its garment layer order. parts.preview = the window, parts.layers = the layer order (the
///        window's layer button needs it, so QoL2026 asks for it with the window).
///
/// The item description's preview button opens kRO's newer preview instead of the old one: the items you
/// preview stack (a headgear, then a garment, then another headgear, each in its own slot), and six pose
/// buttons show them sitting, walking, attacking, standing by, dead or picking up, turned with the two
/// arrows; Reset puts back what you wear. A seventh button switches the previewed garment's layer (in front
/// of or behind the headgear).
///
/// The garment layer order is kRO's too (devnote 2026 Q2 #3): the client reads which garments draw on top
/// once from the robe Lua (IsTopLayer, and IsSideLayer for the ones that go on top only seen from the side)
/// instead of asking Lua on every draw, the button's choice is kept in SaveData\SpriteRobeTopLayer.lua, and
/// it applies to every garment the client draws, yours and other players', as kRO's does.
///
/// Every routine is kRO 2026-10-21's (2026 first shipped it 2026-06-19), translated one for one by
/// tools/pv2_re/pv2_port.py: the window, its message handler (message 0x17 adds an item), the per-frame pose
/// animation, the reset to the player's own look, the handlers and the std::set / std::map code they use,
/// and kRO's registration of the window (id 0x273A) in the client's window factory registry. OnCreate and
/// the texts are written after kRO's instructions (pv2_hand.py) since kRO builds them from XOR-hidden
/// strings; the pose tooltips are ROenglishRE's English, the other texts the client's own messages.
///
QoL2026_EquipPreview = function(_, parts)
{
	$$(_, 1.1, `Find the classes (RTTI) and the helpers`)
	const find1 = (sig, what) =>
	{
		const p = Exe.FindHex(sig);
		if (p < 0 || Exe.FindHex(sig, p + 1) >= 0)
			throw Error("Quality of Life Changes (2026), Equipment Preview: " + what + " missing or not unique");
		return p;
	};
	const relAt = (p) => Exe.Phy2Vir(p + 4, CODE) + Exe.GetInt32(p);   //the target of the rel32 at p
	const vir = (p) => Exe.Phy2Vir(p, CODE);
	const hexIs = (p, re) => new RegExp("^" + re + "$", "i").test(Exe.GetHex(p, re.trim().split(/\s+/).length).trim());
	const vtableOf = (cls) =>
	{
		const nameVir = Exe.FindText(cls);
		if (nameVir < 0)
			throw Error("Quality of Life Changes (2026), Equipment Preview: " + cls + " not found");
		const colCode = " 00 00 00 00 00 00 00 00 00 00 00 00" + (nameVir - 8).toHex(4);
		const colPhy = Exe.FindHex(colCode, Exe.GetSectBegin(DATA), Exe.FileSize);
		if (colPhy < 0 || Exe.FindHex(colCode, colPhy + 1, Exe.FileSize) >= 0)
			throw Error("Quality of Life Changes (2026), Equipment Preview: " + cls + " object locator missing or not unique");
		const vtPhy = Exe.FindHex(Exe.Phy2Vir(colPhy).toHex(4), Exe.GetSectBegin(DATA), Exe.FileSize);
		if (vtPhy < 0)
			throw Error("Quality of Life Changes (2026), Equipment Preview: " + cls + " vtable not found");
		return vtPhy + 4;
	};
	const vtFrameP = vtableOf(".?AVCUIFrameWnd@@");
	const vtFrame = Exe.Phy2Vir(vtFrameP);
	const vtCtrl = Exe.Phy2Vir(vtableOf(".?AVCUIControl@@"));
	const vtTitle = Exe.Phy2Vir(vtableOf(".?AVCUITitleBar@@"));
	const vtCheck = Exe.Phy2Vir(vtableOf(".?AVCUICheckBox@@"));

	$$(_, 1.2, `Find the 07-16 functions the window calls (tools/pv2_re/gen_sigs.py)`)
	const opNewV = vir(find1(" 55 8B EC EB 0D", "operator new"));
	const opDeleteV = vir(find1(" 55 8B EC FF 75 08 E8 ?? ?? ?? ?? 59 5D C3 E8 ?? ?? ?? ??", "operator delete (sized)"));
	const cookieCheckV = vir(find1(" 3B 0D ?? ?? ?? ?? 75 01 C3", "__security_check_cookie"));
	const opNewNothrowV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 51 53 56 57 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 ?? ?? ?? ?? 89 65 F0 FF 75 08", "operator new (nothrow)"));
	const strCtorV = vir(find1(" 55 8B EC 8B 55 08 8B C2 56 8B F1 57 8D 78 01", "std::string(const char*)"));
	const strAssignV = vir(find1(" 55 8B EC 51 53 56 8B F1 57 8B 7D 0C", "std::string::assign"));
	const strDtorV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 56 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 ?? ?? ?? ?? 8B F1 8B 4E 14 83 F9 10", "std::string's destructor"));
	const msgV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 83 EC 14 56 57 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 ?? ?? ?? ?? 8B 7D 08 57", "GetMsgString"));
	const frameCtorV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 51 56 57 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 ?? ?? ?? ?? 8B F9 89 7D F0 FF 75 08", "UIFrameWnd's constructor"));
	const frameDtorV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 83 EC 28 56 57 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 ?? ?? ?? ?? 8B F1 89 75 E8", "CUIFrameWnd's destructor"));
	const frameDrawV = vir(find1(" 56 8B F1 80 BE B6 00 00 00 00", "CUIFrameWnd's draw"));
	const frameSendMsgV = vir(find1(" 55 8B EC 8B 55 0C 8B C2 83 E8 00", "the frame windows' SendMsg"));
	const closeWndV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 83 EC 20 A1 ?? ?? ?? ?? 33 C5 89 45 F0 53 56 57 50 8D 45 F4 64 A3 ?? ?? ?? ?? 8B F9 8B 75 08 56", "UIWindowMgr's close by id"));
	const drawBmpV = vir(find1(" 55 8B EC 56 8B 71 24 85 F6 74 37", "CUIControl::DrawBitmap"));
	const resGetV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 81 EC 60 01 00 00 A1 ?? ?? ?? ?? 33 C5 89 45 F0 56 57 50 8D 45 F4 64 A3 ?? ?? ?? ?? 8B F9 89 BD A8 FE FF FF 8B 75 08", "the resource manager's get"));
	const resMgrV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 83 EC 08 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 ?? ?? ?? ?? 64 A1 ?? ?? ?? ??", "the resource manager"));
	const avCtorV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 83 EC 18 56 57 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 ?? ?? ?? ?? 8B F9 89 7D F0 8B 45 08", "the UI avatar renderer's constructor"));
	const avDrawV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 81 EC CC 00 00 00 56", "the UI avatar renderer's draw"));
	const avDtorV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 83 EC 0C 56 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 ?? ?? ?? ?? 8B F1 89 75 F0 C7 06 ?? ?? ?? ?? C7 45 FC 02 00 00 00 8D 8E 80 00 00 00", "the UI avatar renderer's destructor"));
	const gameModeV = vir(find1(" 83 79 58 01 75 04 8B 41 04", "the mode manager's game mode"));
	const actJobV = vir(find1(" 55 8B EC 56 8B 75 08 57 8B F9 83 FE FF", "the actor's job"));
	const actResV = vir(find1(" 8B 81 08 01 00 00 C3 CC", "the actor's act resource"));
	const actActionV = vir(find1(" 55 8B EC 51 8B 45 08 33 D2 57", "the actor's action for a motion"));
	const actFramesV = vir(find1(" 55 8B EC FF 75 08 E8 ?? ?? ?? ?? 8B 48 04", "an act's frame count"));
	const actSitV = vir(find1(" 55 8B EC 8B 45 08 56 33 F6", "the actor's sit action"));
	const isTopLayerV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 51 56 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 ?? ?? ?? ?? 8B 45 08", "the session's IsTopLayer"));
	const registryCtorV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 83 EC 10 56 57 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 ?? ?? ?? ?? 8B F9 89 7D F0 8D 77 04", "the window registry's constructor"));
	const registerV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 83 EC 48 A1 ?? ?? ?? ?? 33 C5 89 45 F0 56 57 50 8D 45 F4 64 A3 ?? ?? ?? ?? C7 45 FC 00 00 00 00", "the window registry's register"));
	const xlenMapV = vir(find1(" 68 ?? ?? ?? ?? E8 ?? ?? ?? ?? CC CC CC CC CC CC 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 56 A1 ?? ?? ?? ??", "std::_Xlength_error(map/set too long)"));
	const xlenVecV = vir(find1(" 55 8B EC 83 EC 0C 8D 4D F4 E8 ?? ?? ?? ?? 68 ?? ?? ?? ?? 8D 45 F4 50 E8 ?? ?? ?? ?? CC CC CC CC 56", "std::bad_array_new_length"));
	const winCtorV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 51 56 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 ?? ?? ?? ?? 8B F1 89 75 F0 E8 ?? ?? ?? ?? C7 45 FC 00 00 00 00 C7 06 ?? ?? ?? ?? C7 46 10 00 00 00 00", "UIWindow's constructor"));
	const createV = vir(find1(" 55 8B EC 53 8B D9 56 57 8B 4B 24 85 C9 74 06 8B 01 6A 01 FF 10 8B 7D 0C 8B 75 08 6A 01 57 56 E8 ?? ?? ?? ?? 89 43 24 83 C4 0C 8B 03 8B CB 89 73 14 89 7B 18 FF 90 ?? ?? ?? ?? 8B 03", "CUIControl::Create"));
	const addChildV = vir(find1(" 55 8B EC 8B 45 08 89 48 10 83 C1 50 8D 45 08 50 FF 31", "CUIControl::AddChild"));
	const imgCtorV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 51 56 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 ?? ?? ?? ?? 8B F1 89 75 F0 6A 00 E8 ?? ?? ?? ?? C7 45 FC 00 00 00 00 C7 06 ?? ?? ?? ?? C6 46 7C 01 C7 45 FC 01 00 00 00 C7 06 ?? ?? ?? ?? C7 86 80 00 00 00 00 00 00 00 C6 45 FC 02", "CUIStaticImage's constructor"));
	const imgSetV = vir(find1(" 55 8B EC 8B 45 08 56 8B F1 8D 8E A0 00 00 00", "CUIStaticImage::SetImage"));
	const titleImgsV = vir(find1(" 55 8B EC 8B 45 08 56 8B F1 8D 8E 90 00 00 00", "CUITitleBar's images"));
	const titleAddBtnV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 83 EC 24 A1 ?? ?? ?? ?? 33 C5 89 45 F0 56 57 50 8D 45 F4 64 A3 ?? ?? ?? ?? 8B F9 8B 45 08", "CUITitleBar's button"));
	const titleTextV = vir(find1(" 55 8B EC 8B 89 D8 00 00 00 85 C9 74 0B", "CUITitleBar's title"));
	const textCtorV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 51 56 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 ?? ?? ?? ?? 8B F1 89 75 F0 6A 00 E8 ?? ?? ?? ?? C7 45 FC 00 00 00 00 C7 06 ?? ?? ?? ?? C6 46 7C 01 C7 45 FC 01 00 00 00 C7 06 ?? ?? ?? ?? C7 86 80 00 00 00 00 00 00 00 C7 86 90 00 00 00 00 00 00 00", "CUIStaticText's constructor"));
	const textSetV = vir(find1(" 55 8B EC 56 FF 75 0C 8B F1 FF 75 08 8D 8E 80 00 00 00", "CUIStaticText::SetText"));
	const textAV = vir(find1(" 55 8B EC 8A 45 08 88 81 C8 00 00 00", "CUIStaticText style a"));
	const textBV = vir(find1(" 55 8B EC 8B 45 08 89 81 CC 00 00 00", "CUIStaticText style b"));
	const textFontV = vir(find1(" 55 8B EC 56 FF 75 08 8B F1 E8 ?? ?? ?? ?? 83 C4 04 89 86 D4 00 00 00", "CUIStaticText's font"));
	const textSizeV = vir(find1(" 55 8B EC 8B 45 08 89 81 D8 00 00 00", "CUIStaticText's font size"));
	const textCV = vir(find1(" 55 8B EC 8A 45 08 88 81 DC 00 00 00", "CUIStaticText style c"));
	const textDV = vir(find1(" 55 8B EC 8B 45 08 89 81 E0 00 00 00 8B 01", "CUIStaticText style d"));
	const textColorV = vir(find1(" 55 8B EC 8A 45 08 88 81 E4 00 00 00", "CUIStaticText's colour"));
	const textShadowV = vir(find1(" 55 8B EC 8A 45 08 88 81 EC 00 00 00", "CUIStaticText's shadow"));
	const imgBtnCtorV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 83 EC 10 56 57 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 ?? ?? ?? ?? 8B F9 89 7D F0 6A 00 E8 ?? ?? ?? ?? C7 45 FC 00 00 00 00 C7 07 ?? ?? ?? ?? C6 47 7C 01 C7 45 FC 01 00 00 00 C7 07 ?? ?? ?? ?? C7 87 80 00 00 00 00 00 00 00 C6 87 84 00 00 00 00", "CUIImageButton's constructor"));
	const btnSetCbV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 83 EC 2C A1 ?? ?? ?? ?? 33 C5 89 45 F0 56 50 8D 45 F4 64 A3 ?? ?? ?? ?? C7 45 FC 00 00 00 00 8D B1 A0 00 00 00", "CUIButton's click callback"));
	const btnImgsV = vir(find1(" 55 8B EC 51 56 8B F1 C7 45 FC 00 00 00 00 57 8D 45 FC 50 8D 8E D8 00 00 00", "CUIImageButton's four images"));
	const basicCtorV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 83 EC 10 56 57 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 ?? ?? ?? ?? 8B F9 89 7D EC E8 ?? ?? ?? ??", "CUIBasicButton's constructor"));
	const basicCreateV = vir(find1(" 55 8B EC 53 57 8B 7D 08 8B D9 6A 06", "CUIBasicButton::Create"));
	const basicTextV = vir(find1(" 55 8B EC 8B 45 08 56 8B F1 8D 8E C8 00 00 00 3B C8", "CUIBasicButton's text"));
	const basicStyleV = vir(find1(" 55 8B EC 8A 45 08 56 8B F1 57", "CUIBasicButton's style"));
	const checkSetCbV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 83 EC 2C A1 ?? ?? ?? ?? 33 C5 89 45 F0 56 50 8D 45 F4 64 A3 ?? ?? ?? ?? C7 45 FC 00 00 00 00 8D B1 00 01 00 00", "CUICheckBox's callback"));
	const luaCallV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 83 EC 28 A1 ?? ?? ?? ?? 33 C5 89 45 F0 53 56 57 50 8D 45 F4 64 A3 ?? ?? ?? ?? 8B 7D 08 C7 45 FC 00 00 00 00", "CLua::CallScriptFunction"));
	const luaLoadV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 81 EC BC 00 00 00 A1 ?? ?? ?? ?? 33 C5 89 45 F0 56 57 50 8D 45 F4 64 A3 ?? ?? ?? ?? 89 8D 38 FF FF FF", "the Lua manager's file loader"));
	const fmtV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 B8 0C 10 00 00", "the std::string printf"));
	const fileOpenV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 83 EC 2C A1 ?? ?? ?? ?? 33 C5 89 45 F0 56 57 50 8D 45 F4 64 A3 ?? ?? ?? ?? 8B F9 8A 45 14", "CFile::Open"));
	const fileWriteV = vir(find1(" 55 8B EC 51 8B 41 04", "CFile::Write"));
	const fileCloseV = vir(find1(" 56 8B F1 8B 46 04 83 F8 FF 74 10", "CFile::Close"));
	const avDrawOnTopV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 83 EC 0C 56 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 ?? ?? ?? ?? 8B F1 80 3D ?? ?? ?? ?? 01", "the UI avatar's Lua _New_DrawOnTop"));
	const actDrawOnTopV = vir(find1(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 83 EC 0C 56 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 ?? ?? ?? ?? 8B F1 80 3D ?? ?? ?? ?? 00", "the actor's garment-on-top answer"));
	const siteWorldTopV = vir(find1(" E8 ?? ?? ?? ?? 84 C0 0F 84 ?? ?? ?? ?? 0F 10 85 44 FF FF FF", "the world actor draw's IsTopLayer call"));
	const siteAvLayerV = vir(find1(" E8 ?? ?? ?? ?? 8B 75 F0 8D 4D B8", "the UI avatar layer list's IsTopLayer call"));
	const siteAvCtorV = vir(find1(" E8 ?? ?? ?? ?? 88 47 45 8D 8F 80 00 00 00", "the UI avatar constructor's _New_DrawOnTop call"));
	const robeInitAnchorV = vir(find1(" C6 87 E4 0E 00 00 01 EB 0E 68 ?? ?? ?? ??", "the Lua start's 2D layer flag (the hook is 0x17 on)"));
	const siteRobeSaveV = vir(find1(" 8B F9 89 BD 6C FF FF FF C7 45 AC 00 00 00 00", "the OptionInfo.lua writer's first instructions"));
	const siteFileVtV = vir(find1(" C7 45 C4 ?? ?? ?? ?? C7 45 C8 FF FF FF FF C7 45 CC 00 00 00 00 C7 45 D0 00 00 00 00 C7 45 D4 00 00 00 00 C7 45 E8 00 00 00 00 C7 45 EC 0F 00 00 00 C6 45 D8 00 C6 45 FC 05 8D 45 AC", "the OptionInfo.lua writer's CFile"));
	const avDeadSiteV = vir(find1(" 8B 4F 3C 50 8D 85 3C FF FF FF", "the UI avatar draw's layer kinds 0 and 7"));
	const avDeadNextV = vir(find1(" 8B 7D F0 C6 45 FC 00 8B 36", "the UI avatar draw's next layer"));
	const avJobSiteV = vir(find1(" 80 7F 28 01 75 19 0F BF 47 12", "the UI avatar's rider remap"));

	$$(_, 1.3, `Find the globals: the cookie, the registry, the session, the mode manager, the clock`)
	const cookieCheckP = Exe.Vir2Phy(cookieCheckV);
	const cookie = Exe.GetInt32(cookieCheckP + 2);                     //cmp ecx,[cookie]
	/// MakeWindow, ids above 0x2730: call the registry getter / mov esi,[ebp+8] / mov ecx,eax / push esi / call IsRegistered
	const regP = find1(" E8 ?? ?? ?? ?? 8B 75 08 8B C8 56 E8 ?? ?? ?? ?? 84 C0 0F 84 ?? ?? ?? ?? 56 8B CF E8", "MakeWindow's registry branch");
	const regBackV = vir(regP + 5);
	const regGetV = relAt(regP + 1);
	/// the window registry's getter: mov eax,[registry] / ... / push nothrow / push 0x34 / call new(nothrow)
	const regGetP = Exe.Vir2Phy(regGetV);
	if (!hexIs(regGetP, "55 8B EC 6A FF 68 .. .. .. .. 64 A1 .. .. .. .. 50 51 A1 .. .. .. .. 33 C5 50 8D 45 F4 64 A3"
		+ " .. .. .. .. A1 .. .. .. .. 85 C0 75 34 68 .. .. .. .. 6A 34 E8"))
		throw Error("Quality of Life Changes (2026), Equipment Preview: the window registry's getter changed");
	const registry = Exe.GetInt32(regGetP + 0x24);
	const nothrow = Exe.GetInt32(regGetP + 0x2D);
	if (relAt(regGetP + 0x34) !== opNewNothrowV || relAt(regGetP + 0x4C) !== registryCtorV)
		throw Error("Quality of Life Changes (2026), Equipment Preview: the window registry's getter changed");
	/// every window registration stores the plain-function functor's vtable, then the factory
	let vtFnPtr = 0;
	for (const p of Exe.FindHexN(" C7 45 C4 ?? ?? ?? ?? C7 45 C8 ?? ?? ?? ?? 89 45 E8 C7 45 FC 01 00 00 00"))
	{
		const v = Exe.GetInt32(p + 3);
		if (vtFnPtr && v !== vtFnPtr)
			throw Error("Quality of Life Changes (2026), Equipment Preview: the registrations disagree on the functor");
		vtFnPtr = v;
	}
	if (!vtFnPtr)
		throw Error("Quality of Life Changes (2026), Equipment Preview: the window registrations not found");
	const vtFnPtrP = Exe.Vir2Phy(vtFnPtr);
	const [fnTypeV, fnDelV, fnGetV, fnCol] = [12, 16, 20, -4].map(o => Exe.GetInt32(vtFnPtrP + o));
	const ecxOf = (target, what) =>                                     //mov ecx,imm32 / call target: the imm
	{
		/// a byte search also matches inside other instructions, so the object is the one nearly every call names
		const n = {};
		let total = 0;
		for (const p of Exe.FindHexN(" B9 ?? ?? ?? ?? E8"))
		{
			if (relAt(p + 6) !== target)
				continue;
			const v = Exe.GetInt32(p + 1);
			n[v] = (n[v] || 0) + 1;
			total++;
		}
		const best = Object.keys(n).sort((a, b) => n[b] - n[a])[0];
		if (!total || n[best] < 5 || n[best] * 10 < total * 9)
			throw Error("Quality of Life Changes (2026), Equipment Preview: " + what + "'s object not found");
		return Number(best);
	};
	const session = ecxOf(isTopLayerV, "IsTopLayer");
	const modeMgr = ecxOf(gameModeV, "the game mode getter");
	/// the actor's motion clock: timeGetTime - start, + the unsigned fixup, / the frame length
	const clockP = find1(" 55 8B EC 51 56 8B F1 FF 15 ?? ?? ?? ?? 2B 86 8C 00 00 00 8B CE 66 0F 6E C0 F3 0F E6 C0 C1 E8 1F"
		+ " F2 0F 58 04 C5 ?? ?? ?? ?? 8B 46 34 89 46 38 F2 0F 5E 05", "the actor's motion clock");
	const timeIat = Exe.GetInt32(clockP + 9);
	const u32Fix = Exe.GetInt32(clockP + 0x25);
	const msPerFrame = Exe.GetInt32(clockP + 0x33);
	if (relAt(clockP + 0x41) !== actResV || relAt(clockP + 0x4B) !== actFramesV)
		throw Error("Quality of Life Changes (2026), Equipment Preview: the actor's motion clock changed");
	const iat = (name) =>
	{
		const v = Exe.FindFunc(name);
		if (v < 0)
			throw Error("Quality of Life Changes (2026), Equipment Preview: the import " + name + " missing");
		return v;
	};
