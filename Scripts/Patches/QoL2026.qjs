///
/// \brief Quality of Life Changes (2026): kRO's 2026 quality-of-life changes on the 2025-07-16 client, each one
///        chosen when the patch is applied (every one by default).
///
/// Each change is kRO 2026-10-21's own code, translated one for one (the tools are under tools/ in the
/// warp0716 project; the list of kRO's 2026 changes and which are ported is docs/KRO2026_QOL.md):
///
///     Render Scaling          Game Settings > Graphics > Render Scaling: the game drawn at the window size
///                             divided by a percent and stretched back, so the UI reads larger on a big window
///     Equipment Preview V2    the item description's preview button opens kRO's newer preview: previews
///                             stack, six poses, rotate, reset, and a button for the garment's layer (which
///                             needs the garment layer order, so choosing the preview brings that with it)
///     Garment layer order     which garments draw over the headgear, read once from kRO's robe Lua (with
///                             kRO's side layer), the preview button's choices kept in
///                             SaveData\SpriteRobeTopLayer.lua, for every garment the client draws
///
QoL2026 = function(_)
{
	$$(_, 0.1, `Ask which of kRO 2026's changes to add`)
	const ALL = QoL2026.Changes;
	let pick = Exe.GetUserInput("$qol2026Changes", D_MultiChoice, "Quality of Life Changes (2026)",
		"Choose kRO 2026's changes to add (all of them by default). Equipment Preview V2 brings the Garment layer"
		+ " order with it: its layer button needs it.", ALL, {choices: ALL});

	/// false is the default: an unattended build that has no answer, and, as WARP's window does for a choice,
	/// a default accepted unchanged. WARP saves nothing then and keeps any older answer, which the checklist
	/// would reopen with (and "Select Previous" would build), so that older answer is cleared here.
	/// A profile may hand the answer back as text.
	if (pick === false)
	{
		pick = ALL;
		Exe.ClearSavedInput("$qol2026Changes");
	}
	else if (typeof pick === "string")
		pick = pick.split(/\s*[,;\r\n]+\s*/);
	pick = ALL.filter(name => pick.includes(name));
	if (pick.length === 0)
		Cancel("No change was chosen");
	const has = (name) => pick.includes(name);

	if (has("Render Scaling"))
		QoL2026_RenderScaling(_ + " (Render Scaling)");
	if (has("Equipment Preview V2") || has("Garment layer order"))
		QoL2026_EquipPreview(_ + " (" + (has("Equipment Preview V2") ? "Equipment Preview V2, " : "") + "Garment layer order)",
			{preview: has("Equipment Preview V2"), layers: true});
	return true;
};

/// the choices, in the order the dialog lists them
QoL2026.Changes = [
	"Render Scaling",
	"Equipment Preview V2",
	"Garment layer order",
];

///
/// \brief The 2025-07-16 client only (every change matches its sites exactly).
///
QoL2026.validate = () =>
	Exe.BuildDate === 20250716;

///
/// \brief Quality of Life Changes (2026), one of its choices: kRO 2026's render scaling (Game Settings,
///        MSI_GAME_SETTINGS_RENDER_SCALING) on the 2025-07-16 client.
///
/// 2026 draws the whole frame at the window size divided by a scale and stretches it back up, so the UI
/// (and the world) read larger on a big window, a little soft at high ratios. The scale is a percent,
/// 100 to 300 in steps of 5, saved as OptionInfoList["RenderScalingPercent"] beside the client's other
/// options, and capped so the drawn size stays at least 934 x 540 (975 x 626 on the login screen).
///
/// Every routine is kRO 2026-10-21's, translated one for one by tools/renderscale_re/rs_port.py (the
/// 2026 calls, globals and constants mapped to their 07-16 twins, found below by signature):
///
///     ApplyRenderScaling   (2026 0x006AEC00)  at the start of the login and game modes' OnInit
///     CreateScale target   (2026 0x006B6A30 DX9, 0x006A6330 DX7)  a logical-size render target
///     PresentRenderScaled  (2026 0x006B6AF0 DX9, 0x006A6710 DX7)  at the end of each frame: the
///                          drawn corner of the back buffer copied out and stretched over all of it
///     the cursor           (2026 0x0077F5D5)  window pixels divided back to drawn pixels
///     CenterOnRenderer     (2026 0x0077F4E0)  the cursor recentred when the scale changes; 07-16's own
///                          centring (sized from the real window) is replaced by it, as in 2026
///     DrawWallpaper        (2026 0x00C74370)  the loading picture centred on the drawn size, not the window
///
/// 2026 keeps the percent, the scale and the target in the renderer; the 07-16 renderer has no room, so
/// they live in this patch's state block, owned by one renderer at a time and freed by its destructor.
/// With the percent at 100 (the default) nothing is drawn differently.
///
/// The setting is 2026's too (tools/renderscale_re/ui_port.py): Game Settings > Graphics gains the Render
/// Scaling group (CUIGroupRenderScaling: a title, a slider with the percent on its thumb, a framed preview
/// zoomed to the chosen scale) under the six 07-16 has, and the page scrolls (CUIVScrollBar, the groups
/// stacked under it, the wheel passed to it), as 2026 builds them. Apply stores the percent with the other
/// graphics settings and resets the display; the Apply button lights when it differs from the saved one;
/// a new resolution re-ranges the slider to that resolution's ceiling. The 9-slice frame (CUIBackground)
/// is 2026-only, so it is built here from 2026's draw.
///
QoL2026_RenderScaling = function(_)
{
	$$(_, 1.1, `Find the renderer, the window manager and the size calls`)
	const find1 = (sig, what) =>
	{
		const p = Exe.FindHex(sig);
		if (p < 0 || Exe.FindHex(sig, p + 1) >= 0)
			throw Error("Quality of Life Changes (2026), Render Scaling: " + what + " missing or not unique");
		return p;
	};
	const relAt = (p) => Exe.Phy2Vir(p + 4, CODE) + Exe.GetInt32(p);   //the target of the rel32 at p
	const vir = (p) => Exe.Phy2Vir(p, CODE);
	const hexIs = (p, re) => new RegExp("^" + re + "$", "i").test(Exe.GetHex(p, re.trim().split(/\s+/).length).trim());

	/// WinMain's resize: mov eax,[renderer] / mov ecx,windowMgr / push [eax+0x2C] / push [eax+0x28] /
	/// call UIWindowMgr::SetScreenSize / mov ecx,windowMgr
	const sizeP = find1(" A1 ?? ?? ?? ?? B9 ?? ?? ?? ?? FF 70 2C FF 70 28 E8 ?? ?? ?? ?? B9", "the window resize");
	const renderer = Exe.GetInt32(sizeP + 1);
	const windowMgr = Exe.GetInt32(sizeP + 6);
	const setScreenSizeV = relAt(sizeP + 0x11);
	const setViewportV = relAt(find1(" 8B CE 8B 47 04 FF B0 E4 04 00 00 FF B0 E0 04 00 00 E8", "the viewport call") + 0x12);

	$$(_, 1.2, `Find the display settings and its width / height`)
	const dispWidthV = vir(find1(" 8B 09 85 C9 74 05 8B 01 FF 60 14 33 C0 C3", "the display width"));
	const dispHeightV = vir(find1(" 8B 09 85 C9 74 05 8B 01 FF 60 18 33 C0 C3", "the display height"));
	let dispGetV = 0;
	for (const p of Exe.FindHexN(" E8 ?? ?? ?? ?? 8B C8 E8"))
	{
		if (relAt(p + 8) !== dispWidthV)
			continue;
		const g = relAt(p + 1);
		if (dispGetV && g !== dispGetV)
			throw Error("Quality of Life Changes (2026), Render Scaling: the display width is reached from two getters");
		dispGetV = g;
	}
	if (!dispGetV)
		throw Error("Quality of Life Changes (2026), Render Scaling: the display settings getter not found");

	$$(_, 1.3, `Find the mouse and its move store`)
	const mouseFnV = vir(find1(" 55 8B EC 83 EC 08 80 3D ?? ?? ?? ?? 01 56 8B F1 74 25", "the mouse handler"));
	let mouse = 0;
	for (const p of Exe.FindHexN(" B9 ?? ?? ?? ?? E8"))
	{
		if (relAt(p + 6) !== mouseFnV)
			continue;
		if (mouse && Exe.GetInt32(p + 1) !== mouse)
			throw Error("Quality of Life Changes (2026), Render Scaling: the mouse handler has two objects");
		mouse = Exe.GetInt32(p + 1);
	}
	if (!mouse)
		throw Error("Quality of Life Changes (2026), Render Scaling: the mouse object not found");
	const mouseP = find1(" 8D 45 F8 50 FF 15 ?? ?? ?? ?? 8D 45 F8 50 FF 35 ?? ?? ?? ?? FF 15 ?? ?? ?? ?? 8B 45 F8 89 46 20"
		+ " 8B 45 FC 89 46 24 5E", "the mouse move store") + 0x1A;
	const mouseBackV = vir(mouseP + 12);

	$$(_, 1.4, `Find the login and game modes' OnInit`)
	const loginP = find1(" 56 8B F1 8B 0D ?? ?? ?? ?? 57 E8 ?? ?? ?? ?? C7 46 58 05 00 00 00 C7 46 5C 05 00 00 00", "CLoginMode::OnInit") + 3;
	const gameP = find1(" 8B 7D 08 B9 ?? ?? ?? ?? C7 85 ?? FE FF FF 00 00 00 00 C6 86 ?? 06 00 00 01 C7 86 ?? 04 00 00 00 00 00 00",
		"CGameMode::OnInit") + 3;
	const loginStolen = Exe.GetHex(loginP, 6);         //mov ecx,[the sound manager]
	const gameStolen = Exe.GetHex(gameP, 5);           //mov ecx,<the game mode>
	const loginBackV = vir(loginP + 6);
	const gameBackV = vir(gameP + 5);

	$$(_, 1.5, `Find the options' load and save`)
	const getIntV = relAt(find1(" 8B B5 3C FF FF FF 8B CE 6A 01 68 ?? ?? ?? ?? E8", "the options reader") + 0x10);
	const loadEnd = find1(" 68 ?? ?? ?? ?? 68 0E 01 00 00 8B C8 E8 ?? ?? ?? ?? 8B 4D F4 64 89 0D 00 00 00 00", "the options load's end");
	const loadP = loadEnd + 0x11;
	if (!hexIs(loadEnd + 0x1E, "8B 4D F0 33 CD E8"))
		throw Error("Quality of Life Changes (2026), Render Scaling: the options load's epilogue changed");
	const cookieCheckV = relAt(loadEnd + 0x24);
	const loadStolen = Exe.GetHex(loadP, 10);          //mov ecx,[ebp-0xC] / mov fs:[0],ecx
	const loadBackV = vir(loadP + 10);
	const saveQ = find1(" 68 ?? ?? ?? ?? 8D 45 C4 50 E8 ?? ?? ?? ?? 8D 4D C4 E8", "the options save's bQuickSlot");
	if (Exe.GetInt32(saveQ + 1) !== Exe.GetInt32(loadEnd + 1))
		throw Error("Quality of Life Changes (2026), Render Scaling: the load and save name different options");
	const writeIntV = relAt(saveQ + 0xA);
	const closeFnV = relAt(saveQ + 0x12);
	const saveP = saveQ + 0xE;                         //lea ecx,[ebp-0x3C] / call close
	const saveBackV = vir(saveP + 8);

	$$(_, 1.6, `Find the two renderers' vtables (RTTI) and their end of frame`)
	const vtableOf = (cls) =>
	{
		const nameVir = Exe.FindText(cls);
		if (nameVir < 0)
			throw Error("Quality of Life Changes (2026), Render Scaling: " + cls + " not found");
		const colCode = " 00 00 00 00 00 00 00 00 00 00 00 00" + (nameVir - 8).toHex(4);
		const colPhy = Exe.FindHex(colCode, Exe.GetSectBegin(DATA), Exe.FileSize);
		if (colPhy < 0 || Exe.FindHex(colCode, colPhy + 1, Exe.FileSize) >= 0)
			throw Error("Quality of Life Changes (2026), Render Scaling: " + cls + " object locator missing or not unique");
		const vtPhy = Exe.FindHex(Exe.Phy2Vir(colPhy).toHex(4), Exe.GetSectBegin(DATA), Exe.FileSize);
		if (vtPhy < 0)
			throw Error("Quality of Life Changes (2026), Render Scaling: " + cls + " vtable not found");
		return vtPhy + 4;
	};
	const vtDX9P = vtableOf(".?AVCRendererDX9@@");
	const vtDX7P = vtableOf(".?AVCRendererDX7@@");
	const vtDX9 = Exe.Phy2Vir(vtDX9P);
	const vtDX7 = Exe.Phy2Vir(vtDX7P);
	const dtorDX9V = Exe.GetInt32(vtDX9P);
	const dtorDX7V = Exe.GetInt32(vtDX7P);

	/// slot 7 draws the batches and ends the frame; 2026 calls slot 22 (PresentRenderScaled) between them
	const dx9P = Exe.Vir2Phy(Exe.GetInt32(vtDX9P + 28)) + 0x5C;
	const dx7P = Exe.Vir2Phy(Exe.GetInt32(vtDX7P + 28)) + 0x75;
	if (Exe.GetUint8(dx9P - 5) !== 0xE8 || Exe.GetUint8(dx7P - 5) !== 0xE8 || relAt(dx9P - 4) !== relAt(dx7P - 4))
		throw Error("Quality of Life Changes (2026), Render Scaling: the end of frame's batch call not found");
	if (!hexIs(dx9P, "C7 05 .. .. .. .. 71 00 00 00") || !hexIs(dx9P + 0x14, "8B 8E 5C 02 00 00 E8"))
		throw Error("Quality of Life Changes (2026), Render Scaling: CRendererDX9's end of frame changed");
	if (!hexIs(dx7P, "C7 05 .. .. .. .. 26 01 00 00") || !hexIs(dx7P + 0x14, "8B 86 74 02 00 00 50 8B 08 FF 51 18"))
		throw Error("Quality of Life Changes (2026), Render Scaling: CRendererDX7's end of frame changed");
	const dx9Stolen = Exe.GetHex(dx9P, 10);            //mov [the line marker], ..
	const dx7Stolen = Exe.GetHex(dx7P, 10);
	const dx9BackV = vir(dx9P + 10);
	const dx7BackV = vir(dx7P + 10);

	/// DX7 slot 7 opens with mov eax,[the DirectDraw context]; DX9 slot 0 has the stack cookie
	const s7 = Exe.Vir2Phy(Exe.GetInt32(vtDX7P + 28));
	if (Exe.GetUint8(s7) !== 0xA1)
		throw Error("Quality of Life Changes (2026), Render Scaling: CRendererDX7's end of frame opens differently");
	const ddCtx = Exe.GetInt32(s7 + 1);
	const d9 = Exe.Vir2Phy(dtorDX9V);
	if (Exe.GetUint8(d9 + 0x13) !== 0xA1 || !hexIs(d9 + 0x18, "33 C5"))
		throw Error("Quality of Life Changes (2026), Render Scaling: the stack cookie not found");
	const cookie = Exe.GetInt32(d9 + 0x14);

	$$(_, 1.7, `Find 07-16's wallpaper draw and mouse centring (both sized from the real window)`)
	/// 2026 centres both on the drawn size (the renderer's +0x28 / +0x2C and +0x30 / +0x34); 07-16 asks the
	/// display settings for the window's own width and height, which puts the loading picture off centre
	const wallP = find1(" 53 8B D9 83 BB 78 04 00 00 00 C7 83 FC 04 00 00 00 00 00 00 74 4A", "the wallpaper draw");
	if (relAt(wallP + 0x19) !== dispGetV || relAt(wallP + 0x20) !== dispWidthV)
		throw Error("Quality of Life Changes (2026), Render Scaling: the wallpaper draw no longer reads the window width");
	const centerP = find1(" 56 8B F1 E8 ?? ?? ?? ?? 8B C8 E8 ?? ?? ?? ?? 99 2B C2 D1 F8 89 46 20 89 46 04", "the mouse centring");
	if (relAt(centerP + 4) !== dispGetV || relAt(centerP + 0xB) !== dispWidthV)
		throw Error("Quality of Life Changes (2026), Render Scaling: the mouse centring no longer reads the window width");

	const roundfIat = Exe.FindFunc("roundf");
	const memsetIat = Exe.FindFunc("memset");
	const ceilIat = Exe.FindFunc("ceil");
	if (roundfIat < 0 || memsetIat < 0 || ceilIat < 0)
		throw Error("Quality of Life Changes (2026), Render Scaling: roundf / memset / ceil imports missing");

	$$(_, 1.8, `Find the Graphics page, the UI classes and the type descriptors (RTTI)`)
	const vtPageP = vtableOf(".?AVCUIGraphicsPage@GameSettingsUI@@");
	const vtGroupP = vtableOf(".?AVCUIGroup@GameSettingsUI@@");
	const vtSpriteP = vtableOf(".?AVCUIGroupSpriteDetailLevel@GameSettingsUI@@");
	const vtCtrlP = vtableOf(".?AVCUIControl@@");
	const vtImgP = vtableOf(".?AVCUIStaticImage@@");
	const vtHsbP = vtableOf(".?AVCUIHScrollBar@@");
	const vtPage = Exe.Phy2Vir(vtPageP);
	const vtCtrl = Exe.Phy2Vir(vtCtrlP);
	const vtImg = Exe.Phy2Vir(vtImgP);
	const tdOf = (cls) =>
	{
		const v = Exe.FindText(cls);
		if (v < 0 || Exe.GetUint8(Exe.Vir2Phy(v) + cls.length) !== 0)
			throw Error("Quality of Life Changes (2026), Render Scaling: " + cls + " not found");
		return v - 8;
	};
	const tdUIWindow = tdOf(".?AVUIWindow@@");
	const tdGroup = tdOf(".?AVCUIGroup@GameSettingsUI@@");
	const tdPage = tdOf(".?AVCUIGraphicsPage@GameSettingsUI@@");
	const tdGSUI = tdOf(".?AVCUIGameSettingsUI@@");
	const callAt = (p, what) =>
	{
		if (Exe.GetUint8(p) !== 0xE8)
			throw Error("Quality of Life Changes (2026), Render Scaling: " + what + " is not a call");
		return relAt(p + 1);
	};
	const slotP = (vtP, k) => Exe.Vir2Phy(Exe.GetInt32(vtP + 4 * k));

	$$(_, 1.9, `Find the controls' calls in the Sprite group, the client's own slider group`)
	/// GameSettingsUI::CUIGroupSpriteDetailLevel::OnCreate builds a title and a slider exactly as 2026's
	/// Render Scaling group starts, so its calls are the 07-16 twins of the ones 2026 makes
	const spOnP = slotP(vtSpriteP, 15);
	if (!hexIs(spOnP, "55 8B EC 6A FF 68"))
		throw Error("Quality of Life Changes (2026), Render Scaling: the Sprite group's OnCreate changed");
	const opNewV = callAt(spOnP + 0x31, "operator new");
	const textCtorV = callAt(spOnP + 0x49, "CUIStaticText's constructor");
	const createV = callAt(spOnP + 0x68, "CUIControl::Create");
	const setTextV = callAt(spOnP + 0x94, "CUIStaticText::SetText");
	const tx1V = callAt(spOnP + 0xA1, "the title's first style");
	const tx2V = callAt(spOnP + 0xB0, "the title's second style");
	const fontV = callAt(spOnP + 0x108, "the title's font");
	const opDeleteV = callAt(spOnP + 0x142, "operator delete");
	const fontSizeV = callAt(spOnP + 0x164, "the title's font size");
	const tx3V = callAt(spOnP + 0x171, "the title's third style");
	const tx4V = callAt(spOnP + 0x17E, "the title's fourth style");
	const tx5V = callAt(spOnP + 0x190, "the title's colour");
	const tx6V = callAt(spOnP + 0x1A2, "the title's shadow colour");
	const addChildV = callAt(spOnP + 0x1AF, "CUIControl::AddChild");
	const vsbCtorV = callAt(spOnP + 0x1D3, "CUIVScrollBar's constructor");
	const setCbV = callAt(spOnP + 0x250, "the scroll bar's callback");
	const setRangeV = callAt(spOnP + 0x260, "CUIVScrollBar::SetRange");
	const setPageV = callAt(spOnP + 0x270, "CUIVScrollBar::SetPage");
	const hArrowsV = callAt(spOnP + 0x38E, "CUIHScrollBar's arrows");
	const thumbV = callAt(spOnP + 0x4AB, "the scroll bar's thumb");
	const hBarV = callAt(spOnP + 0x5FE, "CUIHScrollBar's bar");
	if (callAt(spOnP + 0x1B9, "operator new") !== opNewV || !hexIs(spOnP + 0x1DC, "C7 06") || !hexIs(spOnP + 0x236, "C7 00"))
		throw Error("Quality of Life Changes (2026), Render Scaling: the Sprite group's slider changed");
	const vtHsb = Exe.GetInt32(spOnP + 0x1DE);
	const vtSpriteFn = Exe.GetInt32(spOnP + 0x238);
	if (vtHsb !== Exe.Phy2Vir(vtHsbP))
		throw Error("Quality of Life Changes (2026), Render Scaling: the Sprite group's slider is not a CUIHScrollBar");
	const setPosV = callAt(slotP(vtSpriteP, 55) + 0x33, "CUIVScrollBar::SetPos");
	const ctrlDtorV = callAt(slotP(vtSpriteP, 0) + 0x43, "CUIControl's destructor");
	const grpFillV = Exe.GetInt32(vtSpriteP + 80);                    //slot 20: cleared to the colour key
	if (!hexIs(Exe.Vir2Phy(grpFillV), "68 FF 00 FF FF E8"))
		throw Error("Quality of Life Changes (2026), Render Scaling: the Sprite group's slot 20 changed");
	const fillV = callAt(Exe.Vir2Phy(grpFillV) + 5, "CUIControl::Clear");
	const fnP = Exe.Vir2Phy(vtSpriteFn);
	const [fnTypeV, fnDelV, fnGetV, fnCol] = [12, 16, 20, -4].map(o => Exe.GetInt32(fnP + o));
	const ctrlResizeV = Exe.GetInt32(vtCtrlP + 4);

	$$(_, "1.10", `Find CUIStaticImage, the scroll bars' vertical textures, the tooltip and the bitmap draw`)
	/// the store also sits in two functions that build one inline; the constructor is the one it opens
	const imgCtors = Exe.FindHexN(" C7 06 " + vtImg.toHex(4) + " C7 86 80 00 00 00 00 00 00 00").map(p => p - 0x48)
		.filter(p => hexIs(p, "55 8B EC 6A FF 68"));
	if (imgCtors.length !== 1)
		throw Error("Quality of Life Changes (2026), Render Scaling: CUIStaticImage's constructor not found");
	const imgCtorP = imgCtors[0];
	const imgCtorV = vir(imgCtorP);
	const ctrlCtorV = callAt(imgCtorP + 0x2B, "CUIControl's constructor");
	const imgLoadP = slotP(vtImgP, 53);
	const bmpLoadV = callAt(imgLoadP + 0x31, "the UI bitmap loader");
	const bmpAddRefV = callAt(imgLoadP + 0x41, "the bitmap's AddRef");
	const bmpReleaseV = callAt(imgLoadP + 0x72, "the bitmap's Release");
	const setBitmapV = vir(find1(" 55 8B EC 8B 45 08 56 8B F1 8D 8E A0 00 00 00 3B C8 74 12", "CUIStaticImage::SetBitmap"));
	const thumbTextV = vir(find1(" 55 8B EC 8B 89 88 00 00 00 8B 45 08 81 C1 98 00 00 00", "the thumb's text"));
	const setTipV = vir(find1(" 55 8B EC FF 75 0C 81 C1 B0 00 00 00 FF 75 08 E8", "CUIStaticText::SetTooltip"));
	const drawBmpV = vir(find1(" 55 8B EC 56 8B 71 24 85 F6 74 37", "CUIControl::DrawBitmap"));
	const vBarV = vir(find1(" 55 8B EC 56 57 8B F9 66 0F 6E 8F 94 00 00 00 66 0F 6E 87 90 00 00 00 8B 87 84 00 00 00 8B 57 18",
		"CUIVScrollBar's bar"));
	/// the vertical arrows are the horizontal ones' code for their first 24 instructions
	const arrows = Exe.FindHexN(" 55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 ?? ?? ?? ?? 50 51 53 56 57 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3"
		+ " ?? ?? ?? ?? 8B F9 E8 ?? ?? ?? ?? 8B 5D 08 83 EC 18 8B CC 89 65 F0 8B F0 53 E8").map(vir);
	if (arrows.length !== 2 || arrows.indexOf(hArrowsV) < 0)
		throw Error("Quality of Life Changes (2026), Render Scaling: the scroll bars' arrows not found");
	const vArrowsV = arrows[0] === hArrowsV ? arrows[1] : arrows[0];

	$$(_, "1.11", `Find the Graphics page's constructor, allocation, change check, Apply and resolution pick`)
	const pgOnCreateOrigV = Exe.GetInt32(vtPageP + 60);
	if (!hexIs(Exe.Vir2Phy(pgOnCreateOrigV) + 0x26, "68 90 00 00 00 E8"))
		throw Error("Quality of Life Changes (2026), Render Scaling: the Graphics page's OnCreate changed");
	const pgDtorP = slotP(vtPageP, 0);
	if (!hexIs(pgDtorP + 0x4E, "68 98 00 00 00 56 E8"))
		throw Error("Quality of Life Changes (2026), Render Scaling: the Graphics page's destructor changed");
	const pgCtorW = find1(" C7 06 " + vtPage.toHex(4) + " C7 86 80 00 00 00 00 00 00 00", "CUIGraphicsPage's constructor");
	const pgCtorP = pgCtorW - 0x55;
	const pgTailP = pgCtorW + 0x38;
