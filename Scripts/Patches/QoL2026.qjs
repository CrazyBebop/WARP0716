	cvSave.j(CALL, writeIntV);               // CALL writeIntV
	cvSave.h(" 8D 4D C4");                       // LEA ECX, [EBP - 0x3C]
	cvSave.j(CALL, closeFnV);                // CALL closeFnV
	cvSave.j(JMP, saveBackV);                // JMP saveBackV
	const cvSaveV = cvSave.put();

