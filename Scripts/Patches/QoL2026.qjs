	robeBuild.h(" 8B 0E");                          // MOV ECX, DWORD [ESI]
	robeBuild.j(JE, ".Lf4446c");                // JE .Lf4446c
	robeBuild.h(" 09 D1");                          // OR ECX, EDX
	robeBuild.j(JMP, ".Lf44474");               // JMP .Lf44474
	robeBuild.at(".Lf4446c");
	robeBuild.h(" F7 D2");                          // NOT EDX
	robeBuild.h(" 89 C8");                          // MOV EAX, ECX
	robeBuild.h(" 89 D1");                          // MOV ECX, EDX
	robeBuild.h(" 21 C1");                          // AND ECX, EAX
	robeBuild.at(".Lf44474");
	robeBuild.h(" 47");                             // INC EDI
	robeBuild.h(" 89 0E");                          // MOV DWORD [ESI], ECX
	robeBuild.h(" 3B 7D EC");                       // CMP EDI, DWORD [EBP - 0x14]
	robeBuild.j(JL, ".Lf443e2");                // JL .Lf443e2
	robeBuild.at(".Lf44480");
	robeBuild.h(" 8B 45 E8");                       // MOV EAX, DWORD [EBP - 0x18]
	robeBuild.h(" 6A 01");                          // PUSH 1
	robeBuild.h(" 6A 00");                          // PUSH 0
