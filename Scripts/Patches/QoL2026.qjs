	rsDtorDX9.h(" C7 05 " + (rsRT).toHex(4) + " 00 00 00 00"); // MOV DWORD [rsRT], 0
	rsDtorDX9.at(".Lnone");
	rsDtorDX9.h(" C7 05 " + (rsOwner).toHex(4) + " 00 00 00 00"); // MOV DWORD [rsOwner], 0
	rsDtorDX9.h(" C7 05 " + (rsScale).toHex(4) + " 00 00 80 3F"); // MOV DWORD [rsScale], 0x3F800000
	rsDtorDX9.h(" 59");                             // POP ECX
	rsDtorDX9.j(JMP, dtorDX9V);                 // JMP dtorDX9V
	const rsDtorDX9V = rsDtorDX9.put();

	/// CRendererDX7 slot 0 (scalar deleting destructor) first: its scale surface released, the state freed
	const rsDtorDX7 = new Asm();
	rsDtorDX7.h(" 3B 0D " + (rsOwner).toHex(4));    // CMP ECX, DWORD [rsOwner]
	rsDtorDX7.j(JNE, dtorDX7V);                 // JNE dtorDX7V
	rsDtorDX7.h(" 51");                             // PUSH ECX
	rsDtorDX7.h(" A1 " + (rsSurf).toHex(4));        // MOV EAX, DWORD [rsSurf]
	rsDtorDX7.h(" 85 C0");                          // TEST EAX, EAX
	rsDtorDX7.j(JE, ".Lnone");                  // JE .Lnone
	rsDtorDX7.h(" 50");                             // PUSH EAX
	rsDtorDX7.h(" 8B 10");                          // MOV EDX, DWORD [EAX]
	rsDtorDX7.h(" FF 52 08");                       // CALL DWORD [EDX + 8]
	rsDtorDX7.h(" C7 05 " + (rsSurf).toHex(4) + " 00 00 00 00"); // MOV DWORD [rsSurf], 0
	rsDtorDX7.at(".Lnone");
	rsDtorDX7.h(" C7 05 " + (rsOwner).toHex(4) + " 00 00 00 00"); // MOV DWORD [rsOwner], 0
	rsDtorDX7.h(" C7 05 " + (rsScale).toHex(4) + " 00 00 80 3F"); // MOV DWORD [rsScale], 0x3F800000
	rsDtorDX7.h(" 59");                             // POP ECX
	rsDtorDX7.j(JMP, dtorDX7V);                 // JMP dtorDX7V
	const rsDtorDX7V = rsDtorDX7.put();

	/// CLoginMode::OnInit: ApplyRenderScaling(0) first, as 2026 does (2026 0x00E9443C)
	const cvLogin = new Asm();
	cvLogin.h(" 8B 0D " + (renderer).toHex(4));   // MOV ECX, DWORD [renderer]
	cvLogin.h(" 6A 00");                          // PUSH 0
	cvLogin.j(CALL, rsApplyV);                // CALL rsApplyV
	cvLogin.h(loginStolen);                       // the client's own displaced bytes
	cvLogin.j(JMP, loginBackV);               // JMP loginBackV
	const cvLoginV = cvLogin.put();

	/// CGameMode::OnInit: ApplyRenderScaling(1) first, as 2026 does (2026 0x00519170)
	const cvGame = new Asm();
	cvGame.h(" 8B 0D " + (renderer).toHex(4));   // MOV ECX, DWORD [renderer]
	cvGame.h(" 6A 01");                          // PUSH 1
	cvGame.j(CALL, rsApplyV);                // CALL rsApplyV
	cvGame.h(gameStolen);                        // the client's own displaced bytes
	cvGame.j(JMP, gameBackV);                // JMP gameBackV
	const cvGameV = cvGame.put();

	/// CRendererDX9 slot 7 (end of frame): slot 22 PresentRenderScaled after the batches, as 2026 (0x006B2CA5)
	const cvDX9 = new Asm();
	cvDX9.h(" 89 F1");                          // MOV ECX, ESI
	cvDX9.j(CALL, rsPresentDX9V);           // CALL rsPresentDX9V
	cvDX9.h(dx9Stolen);                         // the client's own displaced bytes
	cvDX9.j(JMP, dx9BackV);                 // JMP dx9BackV
	const cvDX9V = cvDX9.put();

	/// CRendererDX7 slot 7 (end of frame): slot 22 PresentRenderScaled before EndScene, as 2026 (0x006A0618)
	const cvDX7 = new Asm();
	cvDX7.h(" 89 F1");                          // MOV ECX, ESI
	cvDX7.j(CALL, rsPresentDX7V);           // CALL rsPresentDX7V
	cvDX7.h(dx7Stolen);                         // the client's own displaced bytes
	cvDX7.j(JMP, dx7BackV);                 // JMP dx7BackV
	const cvDX7V = cvDX7.put();

	/// CMouse WM_MOUSEMOVE: the client position divided by the scale (2026 0x0077F5D5); the state's owner must be the renderer
	const cvMouse = new Asm();
	cvMouse.h(" A1 " + (renderer).toHex(4));      // MOV EAX, DWORD [renderer]
	cvMouse.h(" 85 C0");                          // TEST EAX, EAX
	cvMouse.j(JE, ".Lplain");                 // JE .Lplain
	cvMouse.h(" 3B 05 " + (rsOwner).toHex(4));    // CMP EAX, DWORD [rsOwner]
	cvMouse.j(JNE, ".Lplain");                // JNE .Lplain
	cvMouse.h(" F3 0F 10 15 " + (rsScale).toHex(4)); // MOVSS XMM2, DWORD [rsScale]
	cvMouse.h(" 0F 2F 15 " + (c1).toHex(4));      // COMISS XMM2, DWORD [c1]
	cvMouse.j(JBE, ".Lplain");                // JBE .Lplain
	cvMouse.h(" 66 0F 6E 45 F8");                 // MOVD XMM0, DWORD [EBP - 8]
	cvMouse.h(" 0F 5B C0");                       // CVTDQ2PS XMM0, XMM0
	cvMouse.h(" F3 0F 5E C2");                    // DIVSS XMM0, XMM2
	cvMouse.h(" F3 0F 58 05 " + (cHalf).toHex(4)); // ADDSS XMM0, DWORD [cHalf]
	cvMouse.h(" F3 0F 2C C0");                    // CVTTSS2SI EAX, XMM0
	cvMouse.h(" 66 0F 6E 45 FC");                 // MOVD XMM0, DWORD [EBP - 4]
	cvMouse.h(" 0F 5B C0");                       // CVTDQ2PS XMM0, XMM0
	cvMouse.h(" 89 46 20");                       // MOV DWORD [ESI + 0x20], EAX
	cvMouse.h(" F3 0F 5E C2");                    // DIVSS XMM0, XMM2
	cvMouse.h(" F3 0F 58 05 " + (cHalf).toHex(4)); // ADDSS XMM0, DWORD [cHalf]
	cvMouse.h(" F3 0F 2C C0");                    // CVTTSS2SI EAX, XMM0
	cvMouse.h(" 89 46 24");                       // MOV DWORD [ESI + 0x24], EAX
	cvMouse.j(JMP, mouseBackV);               // JMP mouseBackV
	cvMouse.at(".Lplain");
	cvMouse.h(" 8B 45 F8");                       // MOV EAX, DWORD [EBP - 8]
	cvMouse.h(" 89 46 20");                       // MOV DWORD [ESI + 0x20], EAX
	cvMouse.h(" 8B 45 FC");                       // MOV EAX, DWORD [EBP - 4]
	cvMouse.h(" 89 46 24");                       // MOV DWORD [ESI + 0x24], EAX
	cvMouse.j(JMP, mouseBackV);               // JMP mouseBackV
	const cvMouseV = cvMouse.put();

	/// COptions::LoadSettings' end: RenderScalingPercent read with default 100 (2026 0x00F03E86); ESI = this to the end, as in 2026
	const cvLoad = new Asm();
	cvLoad.h(" 6A 64");                          // PUSH 0x64
	cvLoad.h(" 68 " + (rsKey).toHex(4));         // PUSH rsKey
	cvLoad.h(" 89 F1");                          // MOV ECX, ESI
