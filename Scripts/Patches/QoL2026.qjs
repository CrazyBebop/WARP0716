	rsMaxPct.h(" 89 EC");                          // MOV ESP, EBP
	rsMaxPct.h(" 5D");                             // POP EBP
	rsMaxPct.h(" C2 08 00");                       // RET 8
	const rsMaxPctV = rsMaxPct.put();

