	bitsResize.h(" 89 7E 08");                       // MOV DWORD [ESI + 8], EDI
	bitsResize.h(" 29 C7");                          // SUB EDI, EAX
	bitsResize.h(" 57");                             // PUSH EDI
	bitsResize.h(" 6A 00");                          // PUSH 0
	bitsResize.h(" 50");                             // PUSH EAX
	bitsResize.h(" FF 15 " + (memsetIat).toHex(4));  // CALL DWORD [memsetIat]
	bitsResize.h(" 83 C4 0C");                       // ADD ESP, 0xC
	bitsResize.h(" 8B 45 08");                       // MOV EAX, DWORD [EBP + 8]
	bitsResize.h(" 89 46 0C");                       // MOV DWORD [ESI + 0xC], EAX
	bitsResize.at(".Ldone");
	bitsResize.h(" 5F");                             // POP EDI
	bitsResize.h(" 5E");                             // POP ESI
	bitsResize.h(" 5D");                             // POP EBP
	bitsResize.h(" C2 08 00");                       // RET 8
	const bitsResizeV = bitsResize.put();

	/// the top-layer bitset (2026 0x00F44330, at the session's Lua start): Lua ReqRobSprTopId() + 1 bits, IsTopLayer(i) each, then each id in savedata\SpriteRobeTopLayer (SaveRobeTopLayer(k), k = 1.. until 0) flipped
	const robeBuild = new Asm();
	robeBuild.h(" 55");                             // PUSH EBP
