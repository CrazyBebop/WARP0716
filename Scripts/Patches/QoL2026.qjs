	robeBuild.h(" 89 65 E0");                       // MOV DWORD [EBP - 0x20], ESP
	robeBuild.h(" 6A 0E");                          // PUSH 0xE
	robeBuild.h(" 68 " + (sReqTopId).toHex(4));     // PUSH sReqTopId
	robeBuild.h(" C7 06 00 00 00 00");              // MOV DWORD [ESI], 0
	robeBuild.h(" C7 46 10 00 00 00 00");           // MOV DWORD [ESI + 0x10], 0
	robeBuild.h(" C7 46 14 0F 00 00 00");           // MOV DWORD [ESI + 0x14], 0xF
	robeBuild.h(" 56");                             // PUSH ESI
	robeBuild.h(" C7 46 10 0E 00 00 00");           // MOV DWORD [ESI + 0x10], 0xE
	robeBuild.h(" FF 15 " + (memcpyIat).toHex(4));  // CALL DWORD [memcpyIat]
	robeBuild.h(" 83 C4 0C");                       // ADD ESP, 0xC
	robeBuild.h(" C6 46 0E 00");                    // MOV BYTE [ESI + 0xE], 0
