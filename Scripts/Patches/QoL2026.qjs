	const sVecLong = Exe.AddText("vector too long")[1];
	const sMapLong = Exe.AddText("map/set too long")[1];
	/// state: the registration's done flag, the bitsets' read flag, and the two bitsets as 2026's session holds
	/// them (std::vector<bool>: words first, last, end, then the size in bits), empty until read
	const [stP, stV] = Exe.Allocate(0x28, 4);
	Exe.SetHex(stP, " 00".repeat(0x28));
	const [pvRegDone, robeTried, robeVec, sideVec] = [0, 4, 8, 0x18].map(o => stV + o);
	const [robeTop, robeCount] = [robeVec, robeVec + 0xC];               //[robeTop] = the words' address
	const [sideTop, sideCount] = [sideVec, sideVec + 0xC];
	/// [phy, vir] of a vtable of n slots with its object locator before it (filled in step 4.1)
	const newVt = (n, col) =>
	{
		const [p, v] = Exe.Allocate(4 * (n + 1), 4);
		Exe.SetInt32(p, col);
		return [p + 4, v + 4];
	};
	const [vtPvP, vtPv] = newVt(54, Exe.GetInt32(vtFrameP - 4));       //RTTI: a CUIFrameWnd
	const fnVts = {};
	for (const n of ["Base", "Close", "RotL", "RotR", "Reset", "Sit", "Move", "Attack", "Wait", "Dead", "Pickup", "Layer"])
		fnVts[n] = newVt(6, fnCol);
	const [vtFnBase, vtFnClose, vtFnRotL, vtFnRotR, vtFnReset, vtFnSit, vtFnMove, vtFnAttack, vtFnWait, vtFnDead,
		vtFnPickup, vtFnLayer] = ["Base", "Close", "RotL", "RotR", "Reset", "Sit", "Move", "Attack", "Wait", "Dead",
		"Pickup", "Layer"].map(n => fnVts[n][1]);

	$$(_, 3.1, `Place the routines (kRO 2026-10-21's, by tools/pv2_re/pv2_port.py and pv2_hand.py)`)
	/// Asm: code with labelled jumps in one allocation. h(hex) the bytes, j(kind, to) a jump or call
	/// to a label (".name") or an address, at(".name") a label here, put() places it -> its address.
	function Asm()
	{
		this.c = "";
		this.n = 0;
		this.t = {};
		this.l = {};
	}
	Asm.prototype.h = function(hex) { this.c += hex; };
	Asm.prototype.j = function(kind, to) { this.n++; this.t[this.n] = to; this.c += kind(Filler(this.n)); };
	Asm.prototype.at = function(name) { this.l[name] = this.c.byteCount(); };
	Asm.prototype.put = function()
	{
		const [p, v] = Exe.Allocate(this.c.byteCount(), 0x10);
		const t = {start: v};
		for (const k in this.t)
		{
			const to = this.t[k];
			if (typeof to === "string" && this.l[to] === undefined)
				throw Error("Quality of Life Changes (2026), Equipment Preview: no label " + to);
			t[k] = (typeof to === "string") ? v + this.l[to] : to;
		}
		Exe.SetHex(p, SetFillTargets(this.c, t));
		return v;
	};
