	const vtFile = Exe.GetInt32(siteFileVtP + 3);
	const siteWorldTopP = Exe.Vir2Phy(siteWorldTopV), siteAvLayerP = Exe.Vir2Phy(siteAvLayerV), siteAvCtorP = Exe.Vir2Phy(siteAvCtorV);
	if (relAt(siteWorldTopP + 1) !== isTopLayerV || relAt(siteAvLayerP + 1) !== isTopLayerV || relAt(siteAvCtorP + 1) !== avDrawOnTopV)
		throw Error("Quality of Life Changes (2026), Equipment Preview: a garment draw changed");
