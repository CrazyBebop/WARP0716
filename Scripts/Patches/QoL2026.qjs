	/// 07-16's IsTopLayer (the session's, thiscall, ret 4) jumps here: the bitsets read if not yet, then 2026's IsTopLayer; false while there are none (2026 always has them)
	const pvIsTopEntry = new Asm();
	pvIsTopEntry.h(" 80 3D " + (robeTried).toHex(4) + " 00"); // CMP BYTE [robeTried], 0
	pvIsTopEntry.j(JNE, ".Lbuilt");                // JNE .Lbuilt
	pvIsTopEntry.h(" 51");                             // PUSH ECX
	pvIsTopEntry.j(CALL, pvRobeInitV);             // CALL pvRobeInitV
	pvIsTopEntry.h(" 59");                             // POP ECX
	pvIsTopEntry.at(".Lbuilt");
	pvIsTopEntry.h(" 83 3D " + (robeCount).toHex(4) + " 00"); // CMP DWORD [robeCount], 0
	pvIsTopEntry.j(JE, ".Lnone");                  // JE .Lnone
	pvIsTopEntry.j(JMP, robeIsTopV);               // JMP robeIsTopV
	pvIsTopEntry.at(".Lnone");
	pvIsTopEntry.h(" 31 C0");                          // XOR EAX, EAX
	pvIsTopEntry.h(" C2 04 00");                       // RET 4
	const pvIsTopEntryV = pvIsTopEntry.put();

	/// IsSideLayer for the side-layer clauses: the bitsets read if not yet, then 2026's IsSideLayer
	const pvIsSideEntry = new Asm();
	pvIsSideEntry.h(" 80 3D " + (robeTried).toHex(4) + " 00"); // CMP BYTE [robeTried], 0
	pvIsSideEntry.j(JNE, ".Lbuilt");                // JNE .Lbuilt
	pvIsSideEntry.h(" 51");                             // PUSH ECX
	pvIsSideEntry.j(CALL, pvRobeInitV);             // CALL pvRobeInitV
	pvIsSideEntry.h(" 59");                             // POP ECX
	pvIsSideEntry.at(".Lbuilt");
	pvIsSideEntry.j(JMP, robeIsSideV);              // JMP robeIsSideV
	const pvIsSideEntryV = pvIsSideEntry.put();

	/// the world's actor draw (07-16 0x00604AA0 at 0x00604E9E, 2026 0x00789380): the garment on top if IsTopLayer, or IsSideLayer and seen from the side; replaces the IsTopLayer call (edi = the draw's context, its actor at +0x3C, 2026 +0x38)
	const pvTopOrSideW = new Asm();
	pvTopOrSideW.h(" 56");                             // PUSH ESI
	pvTopOrSideW.h(" 53");                             // PUSH EBX
	pvTopOrSideW.h(" 89 CE");                          // MOV ESI, ECX
	pvTopOrSideW.h(" 8B 5C 24 0C");                    // MOV EBX, DWORD [ESP + 0xC]
	pvTopOrSideW.h(" 53");                             // PUSH EBX
	pvTopOrSideW.j(CALL, pvIsTopEntryV);           // CALL pvIsTopEntryV
	pvTopOrSideW.h(" 84 C0");                          // TEST AL, AL
	pvTopOrSideW.j(JNE, ".Lyes");                  // JNE .Lyes
	pvTopOrSideW.h(" 53");                             // PUSH EBX
	pvTopOrSideW.h(" 89 F1");                          // MOV ECX, ESI
	pvTopOrSideW.j(CALL, pvIsSideEntryV);          // CALL pvIsSideEntryV
	pvTopOrSideW.h(" 84 C0");                          // TEST AL, AL
	pvTopOrSideW.j(JE, ".Lno");                    // JE .Lno
	pvTopOrSideW.h(" 8B 47 3C");                       // MOV EAX, DWORD [EDI + 0x3C]
	pvTopOrSideW.h(" FF 70 38");                       // PUSH DWORD [EAX + 0x38]
	pvTopOrSideW.j(CALL, robeSideActV);            // CALL robeSideActV
	pvTopOrSideW.h(" 83 C4 04");                       // ADD ESP, 4
	pvTopOrSideW.h(" 84 C0");                          // TEST AL, AL
	pvTopOrSideW.j(JE, ".Lno");                    // JE .Lno
	pvTopOrSideW.at(".Lyes");
	pvTopOrSideW.h(" B0 01");                          // MOV AL, 1
	pvTopOrSideW.at(".Lno");
	pvTopOrSideW.h(" 5B");                             // POP EBX
	pvTopOrSideW.h(" 5E");                             // POP ESI
	pvTopOrSideW.h(" C2 04 00");                       // RET 4
	const pvTopOrSideWV = pvTopOrSideW.put();

	/// the UI avatar's layer list (07-16 0x007AD0B0 at 0x007AD5D9, 2026 0x00951F10 at 0x00952439): the garment's layer 0x190 (on top) if IsTopLayer, or IsSideLayer and seen from the side; replaces the IsTopLayer call (ebx = the avatar: garment +0x24, action +0x38)
	const pvTopOrSideA = new Asm();
	pvTopOrSideA.h(" 56");                             // PUSH ESI
	pvTopOrSideA.h(" 89 CE");                          // MOV ESI, ECX
	pvTopOrSideA.h(" FF 74 24 08");                    // PUSH DWORD [ESP + 8]
	pvTopOrSideA.j(CALL, pvIsTopEntryV);           // CALL pvIsTopEntryV
	pvTopOrSideA.h(" 3C 01");                          // CMP AL, 1
	pvTopOrSideA.j(JE, ".Lyes");                   // JE .Lyes
	pvTopOrSideA.h(" FF 73 24");                       // PUSH DWORD [EBX + 0x24]
	pvTopOrSideA.h(" 89 F1");                          // MOV ECX, ESI
	pvTopOrSideA.j(CALL, pvIsSideEntryV);          // CALL pvIsSideEntryV
	pvTopOrSideA.h(" 84 C0");                          // TEST AL, AL
	pvTopOrSideA.j(JE, ".Lno");                    // JE .Lno
	pvTopOrSideA.h(" FF 73 38");                       // PUSH DWORD [EBX + 0x38]
	pvTopOrSideA.j(CALL, robeSideActV);            // CALL robeSideActV
	pvTopOrSideA.h(" 83 C4 04");                       // ADD ESP, 4
	pvTopOrSideA.h(" 84 C0");                          // TEST AL, AL
	pvTopOrSideA.j(JNE, ".Lyes");                  // JNE .Lyes
	pvTopOrSideA.at(".Lno");
	pvTopOrSideA.h(" 30 C0");                          // XOR AL, AL
	pvTopOrSideA.h(" 5E");                             // POP ESI
	pvTopOrSideA.h(" C2 04 00");                       // RET 4
	pvTopOrSideA.at(".Lyes");
	pvTopOrSideA.h(" B0 01");                          // MOV AL, 1
	pvTopOrSideA.h(" 5E");                             // POP ESI
	pvTopOrSideA.h(" C2 04 00");                       // RET 4
	const pvTopOrSideAV = pvTopOrSideA.put();

	/// the UI avatar's garment-on-top flag (+0x45) as its constructor sets it (07-16 inlines it at 0x007AC429, 2026 0x009532B0): the Lua _New_DrawOnTop answer (07-16 0x007AD9E0), or IsSideLayer and seen from the side; replaces that call (ecx = the avatar)
	const pvAvDrawOnTop = new Asm();
	pvAvDrawOnTop.h(" 56");                             // PUSH ESI
	pvAvDrawOnTop.h(" 89 CE");                          // MOV ESI, ECX
	pvAvDrawOnTop.j(CALL, avDrawOnTopV);            // CALL avDrawOnTopV
	pvAvDrawOnTop.h(" 84 C0");                          // TEST AL, AL
	pvAvDrawOnTop.j(JNE, ".Lout");                  // JNE .Lout
	pvAvDrawOnTop.h(" FF 76 24");                       // PUSH DWORD [ESI + 0x24]
	pvAvDrawOnTop.h(" B9 " + (session).toHex(4));       // MOV ECX, session
	pvAvDrawOnTop.j(CALL, pvIsSideEntryV);          // CALL pvIsSideEntryV
	pvAvDrawOnTop.h(" 84 C0");                          // TEST AL, AL
	pvAvDrawOnTop.j(JE, ".Lout");                   // JE .Lout
	pvAvDrawOnTop.h(" FF 76 38");                       // PUSH DWORD [ESI + 0x38]
	pvAvDrawOnTop.j(CALL, robeSideActV);            // CALL robeSideActV
	pvAvDrawOnTop.h(" 83 C4 04");                       // ADD ESP, 4
	pvAvDrawOnTop.at(".Lout");
	pvAvDrawOnTop.h(" 5E");                             // POP ESI
	pvAvDrawOnTop.h(" C3");                             // RET
	const pvAvDrawOnTopV = pvAvDrawOnTop.put();

	/// the actor's garment-on-top answer (07-16 0x00D36D60, 2026 0x00EAA170) starts with 2026's side-layer clause: IsSideLayer(the actor's garment, +0x494) and seen from the side gives true, else 07-16's own (step 4.4 jumps here from its first five bytes)
	const pvActorDrawOnTop = new Asm();
	pvActorDrawOnTop.h(" 51");                             // PUSH ECX
	pvActorDrawOnTop.h(" FF B1 94 04 00 00");              // PUSH DWORD [ECX + 0x494]
	pvActorDrawOnTop.h(" B9 " + (session).toHex(4));       // MOV ECX, session
	pvActorDrawOnTop.j(CALL, pvIsSideEntryV);          // CALL pvIsSideEntryV
	pvActorDrawOnTop.h(" 59");                             // POP ECX
	pvActorDrawOnTop.h(" 84 C0");                          // TEST AL, AL
	pvActorDrawOnTop.j(JE, ".Lorig");                  // JE .Lorig
	pvActorDrawOnTop.h(" 51");                             // PUSH ECX
	pvActorDrawOnTop.h(" FF 71 38");                       // PUSH DWORD [ECX + 0x38]
	pvActorDrawOnTop.j(CALL, robeSideActV);            // CALL robeSideActV
	pvActorDrawOnTop.h(" 83 C4 04");                       // ADD ESP, 4
	pvActorDrawOnTop.h(" 59");                             // POP ECX
	pvActorDrawOnTop.h(" 84 C0");                          // TEST AL, AL
	pvActorDrawOnTop.j(JE, ".Lorig");                  // JE .Lorig
	pvActorDrawOnTop.h(" B0 01");                          // MOV AL, 1
	pvActorDrawOnTop.h(" C3");                             // RET
	pvActorDrawOnTop.at(".Lorig");
	pvActorDrawOnTop.h(" 55");                             // PUSH EBP
	pvActorDrawOnTop.h(" 89 E5");                          // MOV EBP, ESP
	pvActorDrawOnTop.h(" 6A FF");                          // PUSH -1
	pvActorDrawOnTop.j(JMP, actDrawOnTopBackV);        // JMP actDrawOnTopBackV
	const pvActorDrawOnTopV = pvActorDrawOnTop.put();

	/// the UI avatar draw's layer loop, kinds 0 and 7 (07-16 0x007AC820 at 0x007ACC80, 2026 0x009516B0 at 0x00951A3E): in the V2 window's dead pose (actions 0x40..0x47) such a layer is not drawn, the loop goes on with the next; else 07-16's own first instructions of the branch (edi = the avatar, its window at +4; eax = the layer kind, pushed by them)
	const pvAvDeadSkip = new Asm();
	pvAvDeadSkip.h(" 8B 4F 04");                       // MOV ECX, DWORD [EDI + 4]
	pvAvDeadSkip.h(" 85 C9");                          // TEST ECX, ECX
	pvAvDeadSkip.j(JE, ".Ldraw");                  // JE .Ldraw
	pvAvDeadSkip.h(" 81 79 2C 3A 27 00 00");           // CMP DWORD [ECX + 0x2C], 0x273A
	pvAvDeadSkip.j(JNE, ".Ldraw");                 // JNE .Ldraw
	pvAvDeadSkip.h(" 8B 4F 38");                       // MOV ECX, DWORD [EDI + 0x38]
	pvAvDeadSkip.h(" 83 F9 40");                       // CMP ECX, 0x40
	pvAvDeadSkip.j(JL, ".Ldraw");                  // JL .Ldraw
	pvAvDeadSkip.h(" 83 F9 47");                       // CMP ECX, 0x47
	pvAvDeadSkip.j(JG, ".Ldraw");                  // JG .Ldraw
	pvAvDeadSkip.j(JMP, avDeadNextV);              // JMP avDeadNextV
	pvAvDeadSkip.at(".Ldraw");
	pvAvDeadSkip.h(" 8B 4F 3C");                       // MOV ECX, DWORD [EDI + 0x3C]
	pvAvDeadSkip.h(" 50");                             // PUSH EAX
	pvAvDeadSkip.h(" 8D 85 3C FF FF FF");              // LEA EAX, [EBP - 0xC4]
	pvAvDeadSkip.j(JMP, avDeadBackV);              // JMP avDeadBackV
	const pvAvDeadSkipV = pvAvDeadSkip.put();

	/// the UI avatar's job for its body (07-16 0x007AE4E0 at 0x007AE58A, 2026 0x00953490 at 0x0095354E, the copy of 0x00952A60 it inlines): in the V2 window's dead pose the Madogear jobs are drawn dismounted (4086 -> 4058, 4087 -> 4064, 4112 -> 4100, 4279 -> 4253) and no rider remap is made; else a rider (+0x28) is remapped as 07-16 does (edi = the avatar; the job ends in ecx and [ebp - 0x134], 2026 [ebp - 0x138])
	const pvAvDeadJob = new Asm();
	pvAvDeadJob.h(" 0F BF 4F 12");                    // MOVSX ECX, WORD PTR [EDI + 0x12]
	pvAvDeadJob.h(" 89 8D CC FE FF FF");              // MOV DWORD [EBP - 0x134], ECX
	pvAvDeadJob.h(" 8B 47 04");                       // MOV EAX, DWORD [EDI + 4]
	pvAvDeadJob.h(" 85 C0");                          // TEST EAX, EAX
	pvAvDeadJob.j(JE, ".Lride");                  // JE .Lride
	pvAvDeadJob.h(" 81 78 2C 3A 27 00 00");           // CMP DWORD [EAX + 0x2C], 0x273A
	pvAvDeadJob.j(JNE, ".Lride");                 // JNE .Lride
	pvAvDeadJob.h(" 8B 47 38");                       // MOV EAX, DWORD [EDI + 0x38]
	pvAvDeadJob.h(" 83 E8 40");                       // SUB EAX, 0x40
	pvAvDeadJob.h(" 83 F8 07");                       // CMP EAX, 7
	pvAvDeadJob.j(JA, ".Lride");                  // JA .Lride
	pvAvDeadJob.h(" 81 F9 F6 0F 00 00");              // CMP ECX, 0xFF6
	pvAvDeadJob.j(JNE, ".L1");                    // JNE .L1
	pvAvDeadJob.h(" B9 DA 0F 00 00");                 // MOV ECX, 0xFDA
	pvAvDeadJob.j(JMP, ".Lset");                  // JMP .Lset
	pvAvDeadJob.at(".L1");
	pvAvDeadJob.h(" 81 F9 F7 0F 00 00");              // CMP ECX, 0xFF7
	pvAvDeadJob.j(JNE, ".L2");                    // JNE .L2
	pvAvDeadJob.h(" B9 E0 0F 00 00");                 // MOV ECX, 0xFE0
	pvAvDeadJob.j(JMP, ".Lset");                  // JMP .Lset
	pvAvDeadJob.at(".L2");
	pvAvDeadJob.h(" 81 F9 10 10 00 00");              // CMP ECX, 0x1010
	pvAvDeadJob.j(JNE, ".L3");                    // JNE .L3
	pvAvDeadJob.h(" B9 04 10 00 00");                 // MOV ECX, 0x1004
	pvAvDeadJob.j(JMP, ".Lset");                  // JMP .Lset
	pvAvDeadJob.at(".L3");
	pvAvDeadJob.h(" 81 F9 B7 10 00 00");              // CMP ECX, 0x10B7
	pvAvDeadJob.j(JNE, ".Lback");                 // JNE .Lback
	pvAvDeadJob.h(" B9 9D 10 00 00");                 // MOV ECX, 0x109D
	pvAvDeadJob.at(".Lset");
	pvAvDeadJob.h(" 89 8D CC FE FF FF");              // MOV DWORD [EBP - 0x134], ECX
	pvAvDeadJob.at(".Lback");
	pvAvDeadJob.j(JMP, avJobBackV);               // JMP avJobBackV
	pvAvDeadJob.at(".Lride");
	pvAvDeadJob.h(" 80 7F 28 01");                    // CMP BYTE [EDI + 0x28], 1
	pvAvDeadJob.j(JNE, ".Lback");                 // JNE .Lback
	pvAvDeadJob.h(" 51");                             // PUSH ECX
	pvAvDeadJob.h(" B9 " + (session).toHex(4));       // MOV ECX, session
	pvAvDeadJob.j(CALL, ridingJobV);              // CALL ridingJobV
	pvAvDeadJob.h(" 89 C1");                          // MOV ECX, EAX
	pvAvDeadJob.h(" 89 85 CC FE FF FF");              // MOV DWORD [EBP - 0x134], EAX
	pvAvDeadJob.j(JMP, avJobBackV);               // JMP avJobBackV
	const pvAvDeadJobV = pvAvDeadJob.put();

	/// 07-16's Lua start (0x00D64530 at 0x00D64CB6, after the 2D layer files, where 2026 0x00EEB79B calls the two builders): the bitsets read, then its own next instruction (edi = the session)
	const pvRobeAtInit = new Asm();
	pvRobeAtInit.h(" 89 F9");                          // MOV ECX, EDI
	pvRobeAtInit.j(CALL, pvRobeInitV);             // CALL pvRobeInitV
	pvRobeAtInit.h(" 8B 8F B8 59 00 00");              // MOV ECX, DWORD [EDI + 0x59B8]
	pvRobeAtInit.j(JMP, robeInitBackV);            // JMP robeInitBackV
	const pvRobeAtInitV = pvRobeAtInit.put();

	/// 07-16's OptionInfo.lua writer (0x00D78970, at the client's end) starts as 2026's (0x00F068D0) does: SaveData\SpriteRobeTopLayer.lua written first, then its own two first instructions
	const pvRobeAtSave = new Asm();
	pvRobeAtSave.h(" 89 CF");                          // MOV EDI, ECX
	pvRobeAtSave.h(" 89 BD 6C FF FF FF");              // MOV DWORD [EBP - 0x94], EDI
	pvRobeAtSave.j(CALL, robeSaveV);               // CALL robeSaveV
	pvRobeAtSave.j(JMP, robeSaveBackV);            // JMP robeSaveBackV
	const pvRobeAtSaveV = pvRobeAtSave.put();

	/// the routines are placed either way (the window's and the layer order's share helpers); only the chosen
	/// parts are wired in below, so an unchosen part is code nothing reaches
	if (parts.preview)
	{
		$$(_, 4.1, `Fill the vtables: CUIFrameWnd's slots with the window's own; the functors' with their copy and call`)
		for (let k = 0; k < 54; k++)
			Exe.SetInt32(vtPvP + 4 * k, Exe.GetInt32(vtFrameP + 4 * k));
		const own = {0: pvDtorV, 15: pvOnCreateV, 16: pvSlot16V, 19: pvAnimateV, 20: pvOnDrawV, 37: pvSendMsgV, 53: pvInitV};
		for (const k in own)
			Exe.SetInt32(vtPvP + 4 * k, own[k]);
		const fnSlots = {Base: [fnBaseCopyV, fnBaseCallV], Close: [fnCloseCopyV, fnCloseCallV], RotL: [fnRotLCopyV, fnRotLCallV],
			RotR: [fnRotRCopyV, fnRotRCallV], Reset: [fnResetCopyV, fnResetCallV], Sit: [fnSitCopyV, fnSitCallV],
			Move: [fnMoveCopyV, fnMoveCallV], Attack: [fnAttackCopyV, fnAttackCallV], Wait: [fnWaitCopyV, fnWaitCallV],
			Dead: [fnDeadCopyV, fnDeadCallV], Pickup: [fnPickupCopyV, fnPickupCallV], Layer: [fnLayerCopyV, fnLayerCallV]};
		for (const n in fnSlots)
		{
			const [copy, call] = fnSlots[n];
			[copy, copy, call, fnTypeV, fnDelV, fnGetV].forEach((v, k) => Exe.SetInt32(fnVts[n][0] + 4 * k, v));
		}

		$$(_, 4.2, `Register the window (id 0x273A) the first time it is asked for, as kRO's static initializer does at start`)
		const reg = new Asm();
		reg.h(" 81 7D 08 3A 27 00 00");                                    // CMP DWORD [EBP+8],0x273A
		reg.j(JNE, ".go");                                                 // JNE .go
		reg.h(" 80 3D" + pvRegDone.toHex(4) + " 00");                      // CMP BYTE [pvRegDone],0
		reg.j(JNE, ".go");                                                 // JNE .go
		reg.h(" C6 05" + pvRegDone.toHex(4) + " 01");                      // MOV BYTE [pvRegDone],1
		reg.j(CALL, pvRegisterV);                                          // CALL pvRegister
		reg.at(".go");
		reg.j(CALL, regGetV);                                              // CALL the registry getter
		reg.j(JMP, regBackV);                                              // JMP back
		Exe.SetJMP(regP, reg.put());

		$$(_, 4.3, `The item description's preview button opens the new preview`)
		Exe.SetInt32(openP + 1, 0x273A);

		$$(_, 4.5, `The UI avatar renderer's two branches for the window's dead pose (a layer left out, Madogear riders dismounted)`)
		Exe.SetJMP(avDeadSiteP, pvAvDeadSkipV, 5);
		Exe.SetJMP(avJobSiteP, pvAvDeadJobV, 1);
	}

	if (parts.layers)
	{
		$$(_, 4.4, `The garment layer order: IsTopLayer reads the bits, the side layer joins the four draws 2026 extended, the bits are read at the Lua start and saved at the end`)
		Exe.SetJMP(isTopLayerP, pvIsTopEntryV);
		const callTo = (p, v) => Exe.SetInt32(p + 1, v - (Exe.Phy2Vir(p, CODE) + 5));
		callTo(siteWorldTopP, pvTopOrSideWV);
		callTo(siteAvLayerP, pvTopOrSideAV);
		callTo(siteAvCtorP, pvAvDrawOnTopV);
		Exe.SetJMP(actDrawOnTopP, pvActorDrawOnTopV);
		Exe.SetJMP(robeInitP, pvRobeAtInitV, 1);
		Exe.SetJMP(siteRobeSaveP, pvRobeAtSaveV, 3);
	}

	return true;
};
