///
/// \brief Remove Doram race from character creation UI.
///        Special thanks to @Ai4Rei for the original hex sequences.
///
NoDoramCreation = function(_)
{
	if (Exe.BuildDate > 20170614)
		return NoDoramCreation.Modern(_);

	$$(_, 1.1, `Find the first pattern`)
	let code =
		PUSH([EDI, WCp]) //push dword ptr [edi + disp8A]
	+	MOV(ECX, EDI)	 //mov ecx, edi
	+	PUSH([EDI, WCp]) //push dword ptr [edi + disp8B]
	+	CALL()           //call func#1
	;
	let addr = Exe.FindHex(code);

	if (addr < 0)
		throw Error("First Pattern missing");

	$$(_, 1.2, `Swap the first PUSH with push 0`)
	Exe.SetHex(addr, NOP + PUSH_0);

	$$(_, 2.1, `Find the second pattern (with the MOV)`)
	code =
		MOV([EBP, NEG1WC], 0) //mov dword ptr [LOCAL.z], 0
	+	MOV([EBP, NEG1WC], 0) //mov dword ptr [LOCAL.y], 0
	+	MOV([EBP, NEG1WC], 0) //mov dword ptr [LOCAL.x], 0
	+	PUSH_1				  //push 1
	;

	addr = Exe.FindHex(code);
	if (addr < 0)
		throw Error("2nd pattern (3 MOV) missing");

	$$(_, 2.2, `Point addr to position of PUSH 1`)
	addr += code.byteCount() - 2;

	$$(_, 2.3, `Find the XOR code to jump to`)
	code =
		XOR(ESI, ESI)			//xor esi, esi
	+	LEA(EAX, [EDI, POS2WC]) //lea eax, [edi + dispA]
	+	LEA(ECX, [ECX, 0])		//lea ecx, [ecx + 0]
	;

	const addr2 = Exe.FindHex(code, addr + 2, addr + 0x300);
	if (addr2 < 0)
		throw Error("XOR pattern missing");

	$$(_, 2.4, `Set a JMP to addr2 from addr`)
	Exe.SetJMP(addr, addr2, PHYSICAL);

	$$(_, 3.1, `Find the 3rd pattern`)
	code =
		MOV(ECX, [EBP, -200]) 	//mov ecx, dword ptr [LOCAL.z]
	+	INC(ECX)				//inc ecx
	+	MOV([EBP, -200], ECX)	//mov dword ptr [LOCAL.z], ECX
	+	MOV(EAX, POS2WC)		//mov eax, offset#1
	+	CMP(ECX, 2)				//cmp eax, 2
	;

	addr = Exe.FindHex(code);
	if (addr < 0)
		throw Error("3rd pattern missing");

	$$(_, 3.2, `NOP out the pattern after it (needs further investigation)`)
	Exe.SetNOPs(addr + code.byteCount(), 6);

	return true;
};

///
/// \brief 2025 clients keep a "Doram is available" byte. When it is 0 the creation window gives the
///        Doram race button img_doram_comingSoon.bmp, ignores clicks on it, and the race panel's own
///        draw skips the Doram label, description and character. Make all five tests of that byte
///        read it as 0, and point the Coming Soon art at an empty name, so the Doram slot is blank.
///
NoDoramCreation.Modern = function(_)
{
	$$(_, 1.1, `Find the Coming Soon art`)
	const soon = Exe.FindText(NoDoramCreation.SoonArt, CASE_INSENSITIVE, false);
	if (soon < 0)
		throw Error("Coming Soon art missing");

	$$(_, 1.2, `Find the flag test in front of it (cmp byte ptr [flag], 0 ; jne short ; mov edi, <art>)`)
	const addr = Exe.FindHex("80 3D ?? ?? ?? ?? 00 75 ?? BF " + soon.toHex());
	if (addr < 0)
		throw Error("Doram flag test missing");

	const flag = Exe.GetInt32(addr + 2);

	$$(_, 2.1, `Collect every test of the flag: the button art, two click paths, the toggle and the race panel draw`)
	const sites = Exe.FindHexN("80 3D " + flag.toHex() + " 00");
	if (sites.length !== 5)
		throw Error("Expected 5 tests of the Doram flag, found " + sites.length);

	$$(_, 2.2, `Replace each with cmp esp, esp (ZF=1, as if the flag were 0) and a 5 byte NOP`)
	for (const p of sites)
		Exe.SetHex(p, "39 E4 0F 1F 44 00 00");

	$$(_, 3, `Blank the Coming Soon art: point the mov edi at the zero that ends its name`)
	Exe.SetInt32(addr + 10, soon + NoDoramCreation.SoonArt.length);

	return true;
};

NoDoramCreation.SoonArt = "\xC0\xAF\xC0\xFA\xC0\xCE\xC5\xCD\xC6\xE4\xC0\xCC\xBD\xBA\\make_character_ver2\\img_doram_comingSoon.bmp";

///
/// \brief Disable for clients without the Doram race, and for the ones between 2017 and the
///        Coming Soon art whose creation code neither path knows
///
NoDoramCreation.validate = () =>
	(Exe.BuildDate > 20151000 && Exe.BuildDate <= 20170614) ||
	(Exe.BuildDate > 20170614 && Exe.FindText(NoDoramCreation.SoonArt, CASE_INSENSITIVE, false) > 0);
