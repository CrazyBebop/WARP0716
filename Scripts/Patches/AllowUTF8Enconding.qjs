///
/// \brief APIs the sprite stub calls through the client's own import table. All
///        of them are already imported by the target, so nothing needs adding
///        to the PE - only the slot addresses are looked up.
///
///        Memory comes from VirtualAlloc rather than the process heap: the
///        newer clients link the CRT through ucrtbase and stopped importing
///        HeapAlloc/HeapFree altogether, while VirtualAlloc/VirtualFree are
///        imported by every client this patch supports. It is also what
///        CFileMgr::Get hands back, so both load paths free the same way.
///
AllowUTF8Enconding.EmojiImports = [
	['TextOutW', 'GDI32.dll'],
	['GetTextExtentPoint32W', 'GDI32.dll'],
	['CreateCompatibleDC', 'GDI32.dll'],
	['CreateDIBSection', 'GDI32.dll'],
	['SelectObject', 'GDI32.dll'],
	['DeleteDC', 'GDI32.dll'],
	['DeleteObject', 'GDI32.dll'],
	['CreateFileA', 'KERNEL32.dll'],
	['GetFileSize', 'KERNEL32.dll'],
	['ReadFile', 'KERNEL32.dll'],
	['CloseHandle', 'KERNEL32.dll'],
	['VirtualAlloc', 'KERNEL32.dll'],
	['VirtualFree', 'KERNEL32.dll'],
	['LoadLibraryA', 'KERNEL32.dll'],
	['GetProcAddress', 'KERNEL32.dll'],
	['QueryPerformanceCounter', 'KERNEL32.dll'],
	['QueryPerformanceFrequency', 'KERNEL32.dll'],
	['wsprintfA', 'USER32.dll'],
];

///
/// \brief Literal strings placed into the data block, as [offset, hex].
///
AllowUTF8Enconding.EmojiStrings = [
	[0x168, "64 61 74 61 5C 65 6D 6F 6A 69 5C 25 58 2E 62 6D 70 00"],  // data\emoji\%X.bmp
	[0x17C, "6D 73 69 6D 67 33 32 2E 64 6C 6C 00"],  // msimg32.dll
	[0x188, "41 6C 70 68 61 42 6C 65 6E 64 00"],  // AlphaBlend
	[0x193, "67 64 69 33 32 2E 64 6C 6C 00"],  // gdi32.dll
	[0x19D, "47 64 69 41 6C 70 68 61 42 6C 65 6E 64 00"],  // GdiAlphaBlend
];

/// Entry point offsets within the sprite blob
AllowUTF8Enconding.EmojiEntryTextOut = 0x000;
AllowUTF8Enconding.EmojiEntryMeasure = 0x2F4;

/// Size of the writable data block (0x1B0 header + 64 cache slots * 0x10
/// + the group-lifetime threshold and its QPC scratch + 8 dedup slots * 0x18
/// + the file manager pointers and the size out-param)
AllowUTF8Enconding.EmojiDataSize = 0x690;

///
/// \brief Only for clients that convert text through a charset -> codepage
///        helper. Verified on 2022-04-06 and 2025; earlier clients (pre-2015)
///        draw with the ANSI APIs directly and are not supported.
///
///        Only the display resolver is required here. The stepping, input and
///        sprite stages check their own prerequisites at patch time and are
///        skipped individually when the client cannot take them, so this stays
///        applicable to every client that can benefit from any part of it.
///
AllowUTF8Enconding.validate = () =>
	Exe.FindHex(AllowUTF8Enconding.TextResolverSig) > 0;
