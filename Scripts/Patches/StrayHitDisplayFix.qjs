/**************************************************************************\
*                                                                          *
*   This file is a part of WARP project (specific to RO clients)           *
*                                                                          *
|**************************************************************************|
*                                                                          *
*   Description   : Fixes MISS and normal damage text that sometimes       *
*                   flashes oversized or in the wrong place for an         *
*                   instant (drawn once before its first update). Critical *
*                   hits are not fixed: their red burst can still appear   *
*                   in the wrong place.                                    *
*                                                                          *
|**************************************************************************|
*                                                                          *
*   Author(s)     : Cross                                                  *
*   Created Date  : 2026-11-26                                             *
*   Last Modified : 2026-11-26                                             *
*                                                                          *
\**************************************************************************/

///
/// \brief Damage numbers (CMsgEffect, 2025-07-16 vtable 0109C460) never show their pre-update frame.
///
/// The client creates the number while handling the hit and may draw it before its first OnProcess
/// (00DAC090) runs, for example when OnProcess exits early on g_updateTick == 0.
///   1. MISS (type 0Dh). SendMsg (00DB0F30) sets render scale +50h and m_scale +198h to 5.0
///      (00DB15CE / 00DB15D5); its OnProcess snaps the scale to 1.0. Both stores become 1.0.
///   2. Numbers (types 0Eh / 10h critical / 15h / 16h total). The SETPOS2 tail (00DB146E..00DB1495)
///      sets 5.0 and the raw position, then "jmp 00DB16F2". That jmp now goes through a body that
///      clears the draw flag +158h (the number render path 00DAFFF0 -> 00DB000F skips the effect
///      while it is 0). The constructor sets +158h = 1 and nothing else changes it for these types.
///   3. OnProcess dispatch (00DAC150: "cmp ecx,26h ; ja 00DAD206", ecx = type) now first sets
///      +158h = 1 for those four types, then replays the compare and the ja.
/// After the first update everything is stock: the 5x zoom, the arc and the fade are unchanged.
///
/// Not fixed: critical hits. Their red burst is a separate effect and can still be drawn once out of
/// place (see the porting guide). Critical digits (type 10h) are hidden like the others, which is
/// harmless, but the critical hit display as a whole still shows the problem.
///
/// No other roFoundry patch writes these sites (checked against the 2026-11-25 cumulative client).
///
StrayHitDisplayFix = function(_)
{
	$$(_, 1.1, `Find the MISS scale stores, the number setup tail and the OnProcess dispatch`)
	const S = StrayHitDisplayFix.findSites();

	$$(_, 2.1, `MISS starts at 1.0 instead of 5.0`)
	Exe.SetHex(S.missPhy + 10, "00 00 80 3F");   // mov dword ptr [esi+50h],1.0
	Exe.SetHex(S.missPhy + 20, "00 00 80 3F");   // mov dword ptr [esi+198h],1.0

	$$(_, 2.2, `Allocate the two bodies`)
	const [blkPhy, blkVir] = Exe.Allocate(0x40, 0x10);
	const hideVir = blkVir;
	const showVir = blkVir + 0x10;

	// hide: mov byte ptr [esi+158h],0 ; jmp <original setup target>
	const hide = ("C6 86 58 01 00 00 00 " +
		"E9 " + (S.setupTarget - (hideVir + 12)).toHex(4)).replace(/\s+/g, " ").trim();

	// show: if type in {0E,10,15,16} -> mov byte ptr [edi+158h],1 ; cmp ecx,26h ; ja <orig> ; jmp <next>
	const showHead =
		"83 F9 0E 74 0F " +            // cmp ecx,0Eh ; je set
		"83 F9 10 74 0A " +            // cmp ecx,10h ; je set
		"83 F9 15 74 05 " +            // cmp ecx,15h ; je set
		"83 F9 16 75 07 " +            // cmp ecx,16h ; jne skip
		"C6 87 58 01 00 00 01 " +      // set:  mov byte ptr [edi+158h],1
		"83 F9 26 ";                   // skip: cmp ecx,26h
	const jaAt = showVir + 30;
	const show = (showHead +
		"0F 87 " + (S.jaTarget - (jaAt + 6)).toHex(4) + " " +
		"E9 " + (S.nextVir - (jaAt + 11)).toHex(4)).replace(/\s+/g, " ").trim();

	if (hide.split(" ").length !== 12 || show.split(" ").length !== 41)
		throw Error("StrayHitDisplayFix: body size mismatch");

	Exe.SetHex(blkPhy, hide);
	Exe.SetHex(blkPhy + 0x10, show);

	$$(_, 3.1, `Redirect the setup jmp and the dispatch compare`)
	Exe.SetHex(S.setupJmpPhy, "E9 " + (hideVir - (S.setupJmpVir + 5)).toHex(4));
	Exe.SetHex(S.dispPhy, "E9 " + (showVir - (S.dispVir + 5)).toHex(4) + " 90 90 90 90");

	return true;
};

///
/// \brief Locate the three sites
///
StrayHitDisplayFix.findSites = function()
{
	// MISS case of SETPOS: mov [esi+3Ch],0 ; mov [esi+50h],5.0 ; mov [esi+198h],5.0 ;
	// movss [esi+14h],xmm0 ; movss [esi+190h],xmm0 ; mov [esi+80h],-5
	const m = Exe.FindHexN("C7 46 3C 00 00 00 00 C7 46 50 00 00 A0 40 C7 86 98 01 00 00 00 00 A0 40" +
		" F3 0F 11 46 14 F3 0F 11 86 90 01 00 00 C7 86 80 00 00 00 FB FF FF FF");
	if (m.length !== 1)
		throw Error(`StrayHitDisplayFix: MISS site found ${m.length} times`);

	// Number SETPOS2 tail: mov [esi+50h],5.0 ; mov [esi+198h],5.0 ; mov [esi+80h],-2 ;
	// call [timeGetTime] ; mov [esi+8Ch],eax ; jmp <end>
	const s = Exe.FindHexN("C7 46 50 00 00 A0 40 C7 86 98 01 00 00 00 00 A0 40 C7 86 80 00 00 00 FE FF FF FF" +
		" FF 15 ?? ?? ?? ?? 89 86 8C 00 00 00 E9 ?? ?? ?? ??");
	if (s.length !== 1)
		throw Error(`StrayHitDisplayFix: number setup site found ${s.length} times`);

	// OnProcess dispatch: mov ecx,[edi+1A8h] ; cmp ecx,26h ; ja <default> ; movzx eax,byte [ecx+tbl] ; jmp [eax*4+tbl]
	const d = Exe.FindHexN("8B 8F A8 01 00 00 83 F9 26 0F 87 ?? ?? ?? ?? 0F B6 81 ?? ?? ?? ?? FF 24 85");
	if (d.length !== 1)
		throw Error(`StrayHitDisplayFix: OnProcess dispatch found ${d.length} times`);

	const setupJmpPhy = s[0] + 39;
	const setupJmpVir = Exe.Phy2Vir(setupJmpPhy, CODE);
	const dispPhy = d[0] + 6;
	const dispVir = Exe.Phy2Vir(dispPhy, CODE);

	return {
		missPhy: m[0],
		setupJmpPhy: setupJmpPhy,
		setupJmpVir: setupJmpVir,
		setupTarget: setupJmpVir + 5 + Exe.GetInt32(setupJmpPhy + 1),
		dispPhy: dispPhy,
		dispVir: dispVir,
		jaTarget: dispVir + 9 + Exe.GetInt32(dispPhy + 5),
		nextVir: dispVir + 9
	};
};

///
/// \brief Only for clients where every site is found
///
StrayHitDisplayFix.validate = function()
{
	try
	{
		StrayHitDisplayFix.findSites();
		return true;
	}
	catch (error)
	{
		return false;
	}
};
