// TODO - Pre 2017 the patterns are completely missing

///
/// \brief Enforce Movement of g_session.field_5ADC to ensure spam skill by hotkey
///
AllowSkillSpam = function(_)
{
	$$(_, 0.1, `Always on, or switched in game with a slash command (GitHub #67)`)
	/// An accepted default comes back false, which is Always on: the patch as it always was.
	const toggle = !Warp.TestMode && Exe.GetUserInput('$skillSpamMode', D_Choice, "Skill Spam Mode",
		"Always on, or switched on and off in game with a slash command? Toggled, it starts off.",
		'Always on', {choices: ['Always on', 'Toggle with a slash command']}) === 'Toggle with a slash command';

	let cmdName = null;
	let flagVir = 0;
	if (toggle)
	{
		cmdName = Exe.GetUserInput('$skillSpamCmd', D_Text, "Skill Spam Command",
			"The slash command that switches skill spam on and off", "/skillspam", {minLen: 2, maxLen: 24, saveDefault: true});
		if (!cmdName)
			cmdName = "/skillspam";
		if (cmdName[0] !== '/' || /\s/.test(cmdName))
			throw Error("The command must start with / and have no spaces");

		[, flagVir] = Exe.AddInt32(0);
	}

	$$(_, 1, `Find the comparison`)
	let parts =
	[
		MOV(EAX, [POS4WC])    //mov eax, dword ptr [g_session.virtual_key_code]
	,
		CMP(EBX, 0x7F4)       //cmp ebx, 7F4h
	,
		CMOVZ(EAX, [POS4WC])  //cmovz eax, dword ptr [g_session.field_5ADC]
	+	MOV([POS4WC], EAX)    //mov dword ptr [g_session.virtual_key_code], eax
	];

	let addr = Exe.FindHex(parts);
	if (addr < 0 && ROC.IsZero)
	{
		parts =
		[
			""
		,
			CMP(R32, 0x7F4)       //cmp regA, 7F4h
		,
			MOV(EAX, [POS4WC])    //mov eax, dword ptr [g_session.virtual_key_code]
		+	MOV(R32, 0x5D)        //mov regB, 5Dh
		+	CMOVE(EAX, [POS4WC])  //cmovz eax, dword ptr [g_session.field_5ADC]
		+	MOV([POS4WC], EAX)    //mov dword ptr [g_session.virtual_key_code], eax
		];
		addr = Exe.FindHex(parts);
	}
	if (addr > 0)
	{
		if (toggle)
			throw Error("The slash command toggle is built for the 2025-07-16 hotkey layout only");

		$$(_, 2.1, `Prepare replacement code - CMP is for triggering Zero Flag`)
		const code =
			CMP(EBX, EBX)  //cmp ebx, ebx
		+	NOPs(parts.byteCount(1) - 2) //4 or 3 byte NOP
		;

		$$(_, 2.2, `Overwrite the original CMP`)
		Exe.SetHex(addr + parts.byteCount(0), code);
	}
	else if (Exe.BuildDate < 20180700)
	{
		throw Error("Pattern not found");
	}
	else
	{
		$$(_, 3.1, `Find the new comparison`)
		const mvReg = MOV(R32, [EBP, ROC.FullVer >= 14.29 ? NEG3WC : NEG2WC]);
		let code =
			CMP(Exe.Version < 14 ? R32 : EAX, 0x7F4) //cmp regA, 7F4h ; regA = EAX for VC14.16
		+	JE(WCp)                                  //je short _skip
		+	(ROC.FullVer == 14.29 ? '' : mvReg)      //<blank> OR mov regB, dword ptr [LOCAL.x]
		+	MOV(R32, 0x438)                          //mov regC, 438h
		+	MOV([EBP, NEG2WC], R16)                  //mov word ptr [LOCAL.y], reg16D
		+	(ROC.FullVer == 14.29 ? mvReg : '')      //mov regB, dword ptr [LOCAL.x] or <blank>
		;

		addr = Exe.FindHex(code);

		if (addr < 0) {
			addr = Exe.FindHex("0F B7 D0 0F B7 CE 3D F4 07 00 00 74");
			if (addr > 0) {
				addr += 6;
			}
		}

		if (addr < 0)
			throw Error("New Pattern not found");

		$$(_, 3.2, `Extract the comparison`)
		const cmp74 = Instr.FromAddr(addr);

		$$(_, 3.3, `Find the code where the comparison with the virtual_key_code is made`)
		code =
			TEST(R32, R32)     //test regA, regA
		+	JZ(WCp)            //jz short _skip
		+	CMP([POS4WC], R32) //cmp dword ptr [tgt], regB
		+	JE(WCp)            //je short _assign
		+	MOV(ECX, POS4WC)   //mov ecx, offset#1
		+	CALL(ALLWC)        //call assigner
		+	MOV([POS4WC], R32) //mov dword ptr [src], regB ; _assign
		;
		let addr2 = Exe.FindHex(code);
		let isModernReorder = false;

		if (addr2 < 0) {
			addr2 = Exe.FindHex("83 7D ?? 00 74 ?? 39 3D ?? ?? ?? ?? 74 ?? B9 ?? ?? ?? ?? E8");
			if (addr2 > 0) {
				isModernReorder = true;
			}
		}

		if (toggle && !isModernReorder)
			throw Error("The slash command toggle is built for the 2025-07-16 hotkey layout only");

		if (addr2 < 0 && ROC.FullVer >= 14.29)
		{
			$$(_, '3.3b', `VS2022 inlines virtual_key_code with CMOVE: find it and make it unconditional`)
			code =
				MOV(EAX, [POS4WC])    //mov eax, dword ptr [g_session.virtual_key_code]
			+	CMOVE(EAX, R32)       //cmove eax, regA ; conditional copy of field_5ADC
			;
			addr2 = Exe.FindHex(code, cmp74.Addr, cmp74.Addr + 0x80);
			if (addr2 < 0)
				throw Error("Inlined virtual_key_code CMOVE not found");

			$$(_, '3.4b', `Change CMOVE to unconditional MOV + NOP`)
			const cmoveAddr = addr2 + 5; // skip the MOV EAX,[addr] (5 bytes: A1 xx xx xx xx)
			const srcReg = Exe.GetUint8(cmoveAddr + 2) & 0x7; // extract source register from CMOVE ModR/M
			Exe.SetHex(cmoveAddr, MOV(EAX, R32.List[srcReg]) + NOP);

			$$(_, '4b', `Hook at the CMP to copy field_5ADC → virtual_key_code before comparing`)
			// For the inlined case, the CMOVE→MOV change is sufficient.
			// No AutoHook needed: the unconditional MOV ensures field_5ADC always overwrites virtual_key_code.
		}
		else if (addr2 < 0)
		{
			throw Error("virtual_key_code reference missing");
		}
		else if (!isModernReorder)
		{
			$$(_, 3.4, `Extract the first 4 instructions`)
			const test0 = Instr.FromAddr(addr2);
			let jz1 = test0.getNext();
			const rcmp = jz1.getNext();
			let jz2 = rcmp.getNext();

			$$(_, 3.5, `Update the jumps`)
			jz1.Immd -= (rcmp.Size + jz2.Size);
			jz2.Immd += (test0.Size + jz1.Size);

			$$(_, 3.6, `Reorder and apply`)
			Exe.SetHex(addr2, rcmp + jz2 + test0 + jz1);

			$$(_, 3.7, `Extract the target address`)
			const tgt = rcmp.Disp;

			$$(_, 4.1, `Construct the new function`)
			code =
				PUSH_EAX             //push eax
			+	MOV(EAX, [tgt + 4])  //mov eax, dword ptr [src]
			+	MOV([tgt], EAX)      //mov dword ptr [tgt], eax
			+	POP_EAX              //pop eax
			+	cmp74                //cmp regA, 7F4h ; regA = EAX for VC14.16
			+	RETN()               //retn
			;

			$$(_, 4.2, `Prepare the arguments for auto-hook`)
			const args =
			{
				isCall: true,
				nops: cmp74.Size - 5
			};

			$$(_, 4.3, `Add our code and call it from the original comparison address`)
			AutoHook(cmp74.Addr, code, args);
		}
		else
		{
			$$(_, 3.4, `Extract modern instructions`)
			const cmp0 = Instr.FromAddr(addr2);
			let jz1 = cmp0.getNext();
			const rcmp = jz1.getNext();
			let jz2 = rcmp.getNext();

			$$(_, 3.7, `Extract the target address`)
			const tgt = rcmp.Disp;

			const copy =
				PUSH_EAX
			+	MOV(EAX, [tgt + 4])
			+	MOV([tgt], EAX)
			+	POP_EAX
			;

			if (toggle)
			{
				$$(_, '3.5t', `Toggle: run the reordered block only while the flag is on`)
				/// Both orders live in a cave and the flag picks one, so the client is stock while
				/// the toggle is off. CMP sets the flags the original jumps test, after ours.
				const skipVir = Exe.Phy2Vir(jz1.Addr, CODE) + jz1.Size + jz1.Immd;
				const assignVir = Exe.Phy2Vir(jz2.Addr, CODE) + jz2.Size + jz2.Immd;
				const blockSize = cmp0.Size + jz1.Size + rcmp.Size + jz2.Size;
				const contVir = Exe.Phy2Vir(addr2, CODE) + blockSize;
				const cmp0Hex = Exe.GetHex(cmp0.Addr, cmp0.Size);
				const rcmpHex = Exe.GetHex(rcmp.Addr, rcmp.Size);

				const block =
					CMP(BYTE_PTR, [flagVir], 0)  //cmp byte ptr [flag], 0
				+	JE(Filler(1))                //je _stock
				+	rcmpHex                      //cmp dword ptr [tgt], regB
				+	JE(Filler(2))                //je _assign
				+	cmp0Hex                      //cmp dword ptr [ebp+x], 0
				+	JZ(Filler(3))                //jz _skip
				+	JMP(Filler(4))               //jmp _continue
				;
				const stock =
					cmp0Hex                      //_stock: the original order
				+	JZ(Filler(3))
				+	rcmpHex
				+	JE(Filler(2))
				+	JMP(Filler(4))
				;
				const [blockPhy, blockVir] = Exe.Allocate((block + stock).byteCount(), 0x10);
				Exe.SetHex(blockPhy, SetFillTargets(block + stock,
				{
					start: blockVir,
					1: blockVir + block.byteCount(),
					2: assignVir,
					3: skipVir,
					4: contVir
				}));
				Exe.SetJMP(addr2, blockVir, blockSize - 5);

				$$(_, '4.1t', `Toggle: copy the held key only while the flag is on`)
				code =
					CMP(BYTE_PTR, [flagVir], 0)  //cmp byte ptr [flag], 0
				+	' 74' + copy.byteCount().toHex(1) //je _cmp
				+	copy
				+	cmp74                        //_cmp: cmp regA, 7F4h
				+	RETN()
				;
			}
			else
			{
				$$(_, 3.5, `Update modern jumps`)
				jz1.Immd -= (rcmp.Size + jz2.Size);
				jz2.Immd += (cmp0.Size + jz1.Size);

				$$(_, 3.6, `Reorder modern and apply`)
				Exe.SetHex(addr2, rcmp + jz2 + cmp0 + jz1);

				$$(_, 4.1, `Construct the new function`)
				code =
					copy
				+	cmp74
				+	RETN()
				;
			}

			$$(_, 4.2, `Prepare the arguments for auto-hook`)
			const args =
			{
				isCall: true,
				nops: cmp74.Size - 5
			};

			$$(_, 4.3, `Add our code and call it from the original comparison address`)
			AutoHook(cmp74.Addr, code, args);
		}
	}

	if (toggle)
	{
		$$(_, 5.1, `Find CSession::GetNoParamTalkType's entry (the slash command lookup)`)
		/// thiscall, one argument: the typed command (char*), returns its talk type. Load GRF On
		/// Slash Cmd hooks this function's "unknown command" exit; the entry is a different site,
		/// so both patches can be applied together.
		const lookupPhy = Exe.FindHex(" 55 8B EC 83 EC 08 8B 81 ?? ?? 00 00 8B 91 ?? ?? 00 00 56 8B F0 89 55 FC 2B F2 89 45 F8 C1 FE 03 57 8B 7D 08");
		if (lookupPhy < 0)
			throw Error("Slash command lookup not found");
		const lookupVir = Exe.Phy2Vir(lookupPhy, CODE);

		$$(_, 5.2, `Find the chat window and its print call (the unknown command message uses them)`)
		const msgPhy = Exe.FindHex(" 68 58 0D 00 00 E8 ?? ?? ?? ?? 83 C4 04 B9 ?? ?? ?? ?? 50 6A 01 E8");
		if (msgPhy < 0)
			throw Error("Chat print call not found");
		const chatWnd = Exe.GetInt32(msgPhy + 14);
		const chatPrint = Exe.GetTgtAddr(msgPhy + 22);

		/// thiscall print(1, text, colour, 0, 0); the callee cleans its five arguments
		const chatMsg = (msg) =>
			PUSH(0) + PUSH(0) + PUSH(0xFFFF) + PUSH_STR(msg) + PUSH(1)
		+	MOV(ECX, chatWnd)
		+	CALL(Filler(9))
		;

		$$(_, 5.3, `Build the command check`)
		/// short jumps are derived from the byte counts, never counted by hand
		const rel8 = (from, to) => ((to - from) & 0xFF).toHex(1);
		const head = " 8A 06 3A 07";                 //_loop: mov al, [esi]; cmp al, [edi]
		const step = " 46 47";                       //inc esi; inc edi
		const other = POP(EDI) + POP(ESI) + JMP(Filler(1));
		const oJne = head.byteCount();               //jne _other
		const oJe = oJne + 2 + 2;                    //after jne + test al, al: je _match
		const oJmp = oJe + 2 + step.byteCount();     //jmp _loop
		const oOther = oJmp + 2;
		const oMatch = oOther + other.byteCount();
		const loop =
			head
		+	" 75" + rel8(oJne + 2, oOther)
		+	" 84 C0"
		+	" 74" + rel8(oJe + 2, oMatch)
		+	step
		+	" EB" + rel8(oJmp + 2, 0)
		+	other
		;
		const cave =
			" 55 8B EC 83 EC 08"            //stolen: push ebp; mov ebp, esp; sub esp, 8
		+	PUSH(ESI)
		+	PUSH(EDI)
		+	MOV(ESI, [EBP, 8])              //mov esi, [ebp+8] ; the typed command
		+	PUSH_STR(cmdName)               //push <our command>
		+	POP(EDI)                        //pop edi
		+	loop                            //compare, fall back to the stock lookup on any difference
		;
		const matchOff = cave.byteCount();
		const match =
			POP(EDI)                        //_match
		+	POP(ESI)
		+	" 80 35" + flagVir.toHex(4) + " 01"  //xor byte ptr [flag], 1
		+	CMP(BYTE_PTR, [flagVir], 0)     //cmp byte ptr [flag], 0
		+	JE(Filler(2))                   //je _off
		+	chatMsg("Skill spam is ON: holding a skill hotkey casts it again and again.")
		+	JMP(Filler(3))                  //jmp _ret
		;
		const offOff = matchOff + match.byteCount();
		const off = chatMsg("Skill spam is OFF.");
		const retOff = offOff + off.byteCount();
		const ret =
			" 33 C0"                        //_ret: xor eax, eax ; handled, no "invalid command"
		+	" 8B E5 5D C2 04 00"            //mov esp, ebp; pop ebp; retn 4
		;

		const all = cave + match + off + ret;
		const [cavePhy, caveVir] = Exe.Allocate(all.byteCount(), 0x10);
		Exe.SetHex(cavePhy, SetFillTargets(all,
		{
			start: caveVir,
			1: lookupVir + 6,
			2: caveVir + offOff,
			3: caveVir + retOff,
			9: chatPrint
		}));

		$$(_, 5.4, `Enter the check from the lookup's entry`)
		Exe.SetJMP(lookupPhy, caveVir, 1);
	}

	return true;
};

///
/// \brief Disable for Pre-2017 (for now).
///
AllowSkillSpam.validate = () =>
	Exe.BuildDate > 20170000;
