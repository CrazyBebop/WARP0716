		61: p11HelperVir,                       // CALL populate_table (PCPaths)
		62: p11HelperVir,                       // CALL populate_table (PCPals)
		68: p11HelperVir,                       // CALL populate_table (_CJ_IMF)
		63: p11_lua_dostring,                   // CALL lua_dostring
		64: p11ReturnVir,                       // JMP back after stolen instructions
		65: p11_lua_tolstring,                  // CALL lua_tolstring (error check)
		66: p11_lua_settop,                     // CALL lua_settop (error cleanup)
		67: p11MainVir + p11NoErrOff,           // JZ .no_errors
		69: p11_lua_getfield,                  // CALL lua_getfield (error check)
		70: 0x51A320,                          // CALL lua_pushcclosure (cj_loadfile reg)
		71: 0x51A950                           // CALL lua_setfield (cj_loadfile reg)
	};
	const p11MainPhys = p11Phys + p11Helper.byteCount();
	Exe.SetHex(p11MainPhys, SetFillTargets(p11Main, p11MainFills));

	// Fix up PUSH string addresses (absolute, not relative)
	// Each call block: PUSH off2(5) + PUSH off1(5) + PUSH EBX(1) + PUSH &str(5)...
	// The &str imm32 is at byte 12 within the block (5+5+1+1=12)
	// PCPaths string
	Exe.SetInt32(p11MainPhys + p11Call1Off + 12, p11MainVir + p11StrPCPaths);
	// PCPals string
	Exe.SetInt32(p11MainPhys + p11Call2Off + 12, p11MainVir + p11StrPCPals);
	// _CJ_IMF string
	Exe.SetInt32(p11MainPhys + p11Call3Off + 12, p11MainVir + p11StrCjImf);
	// lua_dostring code string + name string
	Exe.SetInt32(p11MainPhys + p11DoCodeOff + 1, p11MainVir + p11StrLuaCode);
	Exe.SetInt32(p11MainPhys + p11DoStrOff + 1, p11MainVir + p11StrCjName);
	Exe.SetInt32(p11MainPhys + p11ErrVarOff + 1, p11MainVir + p11StrErrVar);
	Exe.SetInt32(p11MainPhys + p11ErrTitleOff + 1, p11MainVir + p11StrErrTitle);
	// cj_loadfile registration fixups (absolute addresses)
	Exe.SetInt32(p11MainPhys + p11CjFnOff + 1, cjVir);                      // PUSH cj_loadfile_va
	Exe.SetInt32(p11MainPhys + p11CjNameOff + 1, p11MainVir + p11StrCjLoadfile); // PUSH &"cj_loadfile"

	$$(_, '0716.P11.4', `Patch InitJobSpriteNameTables to jump to trampoline`)
	// Replace 10-byte stolen instructions with JMP(5) + NOPs(5)
	const p11Jmp = SetFillTargets(JMP(Filler(1)), {
		start: p11HookVir,
		1: p11MainVir
	});
	Exe.SetHex(p11HookPhys, p11Jmp + NOPs(5));


	// ============================================================
	// Phase 11c.0: Fix GetEquipViewIndexByJob for custom jobs
	// ============================================================
	// Stock switch only handles standard jobs - custom jobs hit default
	// (weapon type 1 only). Return Novice index for all weapon types.
	$$(_, '0716.P11c.0', `Fix GetEquipViewIndexByJob for custom jobs`)
	const eviPattern = " 55 8B EC 8B 45 08 3D A1 0F";
	const eviPhys = Exe.FindHex(eviPattern, Exe.Vir2Phy(0xd724e0, CODE), Exe.Vir2Phy(0xd72500, CODE));
	if (eviPhys < 0)
		throw Error("Phase 11c.0: GetEquipViewIndexByJob entry not found");

	const eviVir = Exe.Phy2Vir(eviPhys, CODE);
	const eviReturnVir = eviVir + 6;

	let evi = "";
	evi += " 55";                                  // PUSH EBP
	evi += " 8B EC";                               // MOV EBP, ESP
	evi += " 8B 45 08";                            // MOV EAX, [EBP+8]
	evi += " 3D F9 10 00 00";                      // CMP EAX, 0x10F9
	evi += JL(Filler(240));                        // JL .not_custom
	evi += " 31 C0";                               // XOR EAX, EAX (Novice)
	const eviNotCustomOff = evi.byteCount();
	evi += JMP(Filler(241));                       // JMP return

	const [eviPhysAlloc, eviVirAlloc] = Exe.Allocate(evi.byteCount(), 0x10);
	Exe.SetHex(eviPhysAlloc, SetFillTargets(evi, {
		start: eviVirAlloc,
		240: eviVirAlloc + eviNotCustomOff,
		241: eviReturnVir
	}));
	Exe.SetHex(eviPhys, SetFillTargets(JMP(Filler(1)), {
		start: eviVir, 1: eviVirAlloc
	}) + " 90");

	// ============================================================
	// Phase 11c: PCHands query-time Lua lookup
	// ============================================================
	// Custom jobs (>= 4345) get hand prefix from PCHands Lua table.
	$$(_, '0716.P11c.1', `Find GetMapJobName2 table lookup`)
	const p11cPattern = " A1 10 24 60 01";
	const p11cPhys = Exe.FindHex(p11cPattern, Exe.Vir2Phy(0xb45820, CODE), Exe.Vir2Phy(0xb45830, CODE));
	if (p11cPhys < 0)
		throw Error("Phase 11c: GetMapJobName2 table lookup not found");

	const p11cHookVir = Exe.Phy2Vir(p11cPhys, CODE);
	const p11cReturnVir = p11cHookVir + 5;

	$$(_, '0716.P11c.2', `Build PCHands query-time trampoline`)
	let p11c = "";
	// [EBP+0x10] is a COMPACT INDEX, not a job id: the client uses
	//     idx < 0x20 ? idx : idx + 0xF6E        (0xF6E = 3950)
	// Recover the job id first, or nothing here can ever match a custom job.
	p11c += " 50";                                 // PUSH EAX
	p11c += " 8B 45 10";                           // MOV EAX,[EBP+0x10]
	p11c += " 83 F8 20";                           // CMP EAX,0x20
	p11c += JL(Filler(244));                       // JL .raw
	p11c += " 05 6E 0F 00 00";                     // ADD EAX,0xF6E
	const p11cRawOff = p11c.byteCount();           // .raw
	p11c += " 3D F9 10 00 00";                     // CMP EAX,0x10F9
	p11c += JL(Filler(241));                       // JL .restore
	// EAX = job id. Scan the baked {jobid, name*} table.
	p11c += " 56";                                 // PUSH ESI
	const p11cTabRef = p11c.byteCount();
	p11c += " BE 00 00 00 00";                     // MOV ESI,TABLE
	const p11cScanOff = p11c.byteCount();          // .scan
	p11c += " 8B 16";                              // MOV EDX,[ESI]
	p11c += " 85 D2";                              // TEST EDX,EDX
	p11c += JZ(Filler(242));                       // JZ .miss
	p11c += " 39 C2";                              // CMP EDX,EAX
	p11c += JZ(Filler(243));                       // JZ .hit
	p11c += " 83 C6 08";                           // ADD ESI,8
	p11c += JMP(Filler(245));                      // JMP .scan
	const p11cHitOff = p11c.byteCount();           // .hit
	p11c += " 8B 56 04";                           // MOV EDX,[ESI+4]
	p11c += " 5E";                                 // POP ESI
	p11c += " 58";                                 // POP EAX
	p11c += " 89 8D 54 FF FF FF";                  // MOV [EBP-0xAC],ECX  (displaced)
	p11c += JMP(Filler(236));                      // JMP 0xb45831, EDX = the name
	const p11cMissOff = p11c.byteCount();          // .miss
	p11c += " 5E";                                 // POP ESI
	const p11cRestOff = p11c.byteCount();          // .restore
	p11c += " 58";                                 // POP EAX
	p11c += JMP(Filler(230));                      // JMP .not_custom
	// ---- unreachable below; kept so the existing fixups still resolve ----
	p11c += " 81 7D 10 F9 10 00 00";              // CMP DWORD [EBP+0x10], 0x10F9
	p11c += JL(Filler(230));                       // JL .not_custom

	p11c += " 50";                                 // PUSH EAX
	p11c += " 51";                                 // PUSH ECX

	const p11cStrOff = p11c.byteCount();
	p11c += " 68 00 00 00 00";                     // PUSH &"PCHands" (fixup)
	p11c += " 68 EE D8 FF FF";                     // PUSH LUA_GLOBALSINDEX
	p11c += " A1" + g_luaState.toHex(4);           // MOV EAX, [g_luaState]
	p11c += " 50";                                 // PUSH EAX
	p11c += CALL(Filler(231));                     // CALL lua_getfield
	p11c += " 83 C4 0C";                           // ADD ESP, 12

	// Check if PCHands is a table (nil guard)
	p11c += " 6A FF";                              // PUSH -1
	p11c += " A1" + g_luaState.toHex(4);           // MOV EAX, [g_luaState]
	p11c += " 50";                                 // PUSH EAX
	p11c += CALL(Filler(238));                     // CALL lua_type (0x51AE20)
	p11c += " 83 C4 08";                           // ADD ESP, 8
	p11c += " 83 F8 05";                           // CMP EAX, 5 (LUA_TTABLE)
	p11c += JNE(Filler(235));                      // JNE .lua_failed (not a table)

	p11c += " FF 75 10";                           // PUSH [EBP+0x10]
	p11c += " 6A FF";                              // PUSH -1
	p11c += " A1" + g_luaState.toHex(4);           // MOV EAX, [g_luaState]
	p11c += " 50";                                 // PUSH EAX
	p11c += CALL(Filler(232));                     // CALL lua_rawgeti
	p11c += " 83 C4 0C";                           // ADD ESP, 12

	p11c += PUSH_0;                                // PUSH 0
	p11c += " 6A FF";                              // PUSH -1
	p11c += " A1" + g_luaState.toHex(4);           // MOV EAX, [g_luaState]
	p11c += " 50";                                 // PUSH EAX
	p11c += CALL(Filler(233));                     // CALL lua_tolstring
	p11c += " 83 C4 0C";                           // ADD ESP, 12

	p11c += " 89 C2";                              // MOV EDX, EAX

	p11c += " 6A FD";                              // PUSH -3
	p11c += " A1" + g_luaState.toHex(4);           // MOV EAX, [g_luaState]
	p11c += " 50";                                 // PUSH EAX
	p11c += CALL(Filler(234));                     // CALL lua_settop
	p11c += " 83 C4 08";                           // ADD ESP, 8

	p11c += " 85 D2";                              // TEST EDX, EDX
	p11c += JZ(Filler(235));                       // JZ .lua_failed

	p11c += " 59";                                 // POP ECX
	p11c += " 58";                                 // POP EAX
	p11c += " 89 8D 54 FF FF FF";                  // MOV [EBP-0xAC], ECX
	p11c += JMP(Filler(236));                      // JMP 0xb45831

	const p11cLuaFailOff = p11c.byteCount();
	p11c += " 59";                                 // POP ECX
	p11c += " 58";                                 // POP EAX

	const p11cNotCustomOff = p11c.byteCount();
	p11c += " A1 10 24 60 01";                     // MOV EAX, [0x01602410] (stolen)
	p11c += JMP(Filler(237));                      // JMP return

	const p11cStrPCHands = p11c.byteCount();
	p11c += " 50 43 48 61 6E 64 73 00";            // "PCHands\0"
	const p11cTable = p11c.byteCount();
	// {jobid, name*} rows, BUILT here: the five official 2025 jobs, then the operator's own
	// literal PCHands.lua rows (see CustomJobs.handsRows). Each name is "<folder>\<folder>",
	// the weapon sprite path shape. The pointers are fixed up after the allocation below.
	const handsRows = CustomJobs.handsRows(_);
	for (const r of handsRows)
		p11c += r.id.toHex(4) + " 00 00 00 00";
	p11c += " 00 00 00 00 00 00 00 00";            // terminator
	const p11cStrOffs = [];
	for (const r of handsRows)
	{
		p11cStrOffs.push(p11c.byteCount());
		// "folder" is baked as folder\folder; a "folder\\prefix" value is used as given
		const str = r.name.includes("\\") ? r.name : r.name + "\\" + r.name;
		for (let i = 0; i < str.length; i++)
			p11c += str.charCodeAt(i).toHex(1);
		p11c += " 00";
	}

	$$(_, '0716.P11c.3', `Allocate and write PCHands query-time trampoline`)
	const [p11cPhysAlloc, p11cVirAlloc] = Exe.Allocate(p11c.byteCount(), 0x10);
	Exe.SetHex(p11cPhysAlloc, SetFillTargets(p11c, {
		start: p11cVirAlloc,
		230: p11cVirAlloc + p11cNotCustomOff,
		231: p11_lua_getfield,
		232: p11_lua_rawgeti,
		233: p11_lua_tolstring,
		234: p11_lua_settop,
		235: p11cVirAlloc + p11cLuaFailOff,
		236: 0xb45831,
		237: p11cReturnVir,
		238: 0x51AE20,
		241: p11cVirAlloc + p11cRestOff,
		242: p11cVirAlloc + p11cMissOff,
		243: p11cVirAlloc + p11cHitOff,
		244: p11cVirAlloc + p11cRawOff,
		245: p11cVirAlloc + p11cScanOff
	}));
	Exe.SetInt32(p11cPhysAlloc + p11cStrOff + 1, p11cVirAlloc + p11cStrPCHands);
	Exe.SetInt32(p11cPhysAlloc + p11cTabRef + 1, p11cVirAlloc + p11cTable);
	handsRows.forEach((r, i) =>
		Exe.SetInt32(p11cPhysAlloc + p11cTable + 8 * i + 4, p11cVirAlloc + p11cStrOffs[i]));

	$$(_, '0716.P11c.4', `Redirect GetMapJobName2 to trampoline`)
	Exe.SetHex(p11cPhys, SetFillTargets(JMP(Filler(1)), {
		start: p11cHookVir, 1: p11cVirAlloc
	}));


	// ============================================================
	// Phase 11b: Costume sprite fallback (SPR + ACT + PAL)
	// ============================================================
	// (A) NULL check in GetAnimLayerByIndex - prevents crash from
	//     missing costume sprite (returns null sentinel).
	// (B) Costume path fallback in SPR/ACT/PAL loaders - strips
	//     "costume_N\" dir and "_N" suffix, retries with base path.

	$$(_, '0716.P11b.1', `Add NULL check to GetAnimLayerByIndex`)
	// CActObjectExt__GetAnimLayerByIndex (0x70f2c0) crashes when this==NULL (ECX=0).
	// Null sentinel return address: 0x01255580.
	// Patch: at function entry, TEST ECX,ECX / JZ ret_sentinel
	const animLayerPattern = " 55 8B EC 6A FF 68 51 6B E6 00";
	const animLayerPhys = Exe.FindHex(animLayerPattern, Exe.Vir2Phy(0x70f2b0, CODE), Exe.Vir2Phy(0x70f2d0, CODE));
	if (animLayerPhys < 0)
		throw Error("Phase 11b: GetAnimLayerByIndex pattern not found");

	const animLayerVir = Exe.Phy2Vir(animLayerPhys, CODE);

	// Build small trampoline: TEST ECX,ECX / JNZ original / MOV EAX, sentinel / RET
	let p11bNull = "";
	p11bNull += " 85 C9";                     // TEST ECX, ECX
	p11bNull += " 75 08";                     // JNZ +8 (to stolen instructions) - skip MOV(5)+RET(3)=8
	p11bNull += " B8 80 55 25 01";             // MOV EAX, 0x01255580 (null sentinel)
	p11bNull += " C2 04 00";                   // RET 4 (thiscall, 1 stack param)

	// Stolen instructions: PUSH EBP; MOV EBP,ESP; PUSH -1 (5 bytes)
	p11bNull += " 55";                         // PUSH EBP
	p11bNull += " 8B EC";                      // MOV EBP, ESP
	p11bNull += " 6A FF";                      // PUSH -1
	p11bNull += JMP(Filler(80));               // JMP back to animLayerVir + 5

	const [p11bNullPhys, p11bNullVir] = Exe.Allocate(p11bNull.byteCount(), 0x10);
	const p11bNullFills = {
		start: p11bNullVir,
		80: animLayerVir + 5                   // after stolen 5 bytes
	};
	Exe.SetHex(p11bNullPhys, SetFillTargets(p11bNull, p11bNullFills));

	// Redirect function entry to trampoline
	const animJmp = SetFillTargets(JMP(Filler(1)), {
		start: animLayerVir,
		1: p11bNullVir
	});
	Exe.SetHex(animLayerPhys, animJmp);

	$$(_, '0716.P11b.2', `Costume sprite fallback - retry with base path`)
	// Hook JNE after CFile_Open in CSprite__LoadSPRFile (0x728398).
	// When CFile_Open fails for a costume path, strip "costume_N\" from
	// the directory and "_N" from the filename, retry CFile_Open with
	// the base sprite path. If retry succeeds, continue loading normally.
	// If retry also fails, fall through to original error path (popup).
	//
	// Costume: sprite\인간족\몸통\여\costume_1\padawan_여_1.spr
	// Base:    sprite\인간족\몸통\여\PADAWAN_여.spr
	//
	// Hook: JNE at 0x728398 (6 bytes) → JMP trampoline (5 bytes + NOP)
	// At hook: AL = CFile_Open result, ESI = filename char*
	// EBP-0x43c = CFile object (for retry)

	const jnePattern = " 0F 85 0D 02 00 00";  // JNE +0x20D (to 0x7285ab)
	const jnePhys = Exe.FindHex(jnePattern, Exe.Vir2Phy(0x728395, CODE), Exe.Vir2Phy(0x7283a0, CODE));
	if (jnePhys < 0)
		throw Error("Phase 11b: CSprite__LoadSPRFile JNE pattern not found");

	const jneVir = Exe.Phy2Vir(jnePhys, CODE);
	const successVir = 0x7285ab;  // original JNE target (file found, continue loading)
	const errorVir = jneVir + 6;   // fall-through to error path (0x72839e)
	const cfileOpenVir = 0x573750;

	// The costume fallback shared by the SPR, ACT and PAL loaders. At the hook AL = CFile_Open's result and
	// ESI = the filename, which is the resource manager's own cache key: CResourceMgr__LoadResourceNoLock
	// passes its key string's buffer to the loader and names the new resource from that buffer afterwards.
	// So the base path is built in a copy on the stack and ESI is never written; the loaded sprite is cached
	// under its costume name and the next lookup finds it. Until 2026-10-30 the path was stripped in place:
	// the resource was filed under the base name, every costume lookup missed and loaded a fresh copy, and
	// the client ran out of memory after a few minutes (std::bad_alloc, exception 0xe06d7363).
	const costumeFallback = function(leaCFile)
	{
		const at = {};
		let c = "";
		c += " 84 C0";                            // TEST AL, AL
		c += JNZ(Filler(1));                      // JNZ success (file found)
		c += " 57";                               // PUSH EDI
		c += " 8B FE";                            // MOV EDI, ESI
		// scan the name for "costum", stepping over CP949 double-byte characters
		at.scan = c.byteCount();
		c += " 8A 07";                            // MOV AL, [EDI]
		c += " 84 C0";                            // TEST AL, AL
		c += JZ(Filler(3));                       // JZ not_costume
		c += " 3C 81";                            // CMP AL, 0x81
		c += JB(Filler(4));                       // JB ascii
		c += " 47 47";                            // INC EDI; INC EDI (lead + trail byte)
		c += JMP(Filler(2));                      // JMP scan
		at.ascii = c.byteCount();
		c += " 3C 63";                            // CMP AL, 'c'
		c += JNE(Filler(5));                      // JNE next
		c += " 80 7F 01 6F";                      // CMP BYTE [EDI+1], 'o'
		c += JNE(Filler(5));
		c += " 80 7F 02 73";                      // CMP BYTE [EDI+2], 's'
		c += JNE(Filler(5));
		c += " 80 7F 03 74";                      // CMP BYTE [EDI+3], 't'
		c += JNE(Filler(5));
		c += " 80 7F 04 75";                      // CMP BYTE [EDI+4], 'u'
		c += JNE(Filler(5));
		c += " 80 7F 05 6D";                      // CMP BYTE [EDI+5], 'm'
		c += JE(Filler(6));                       // JE found
		at.next = c.byteCount();
		c += " 47";                               // INC EDI
		c += JMP(Filler(2));                      // JMP scan
		at.notCostume = c.byteCount();
		c += " 5F";                               // POP EDI
		c += " 33 C0";                            // XOR EAX, EAX (AL = 0, as the stock failure path has it)
		c += JMP(Filler(7));                      // JMP error
		// found: EDI = the 'c' of "costume_N\" inside the name; a name that would not fit takes the error path
		at.found = c.byteCount();
		c += " 8B CE";                            // MOV ECX, ESI
		at.len = c.byteCount();
		c += " 80 39 00";                         // CMP BYTE [ECX], 0
		c += JE(Filler(9));                       // JE len_done
		c += " 41";                               // INC ECX
		c += JMP(Filler(8));                      // JMP len
		at.lenDone = c.byteCount();
		c += " 2B CE";                            // SUB ECX, ESI
		c += " 81 F9 00 01 00 00";                // CMP ECX, 0x100
		c += JAE(Filler(3));                      // JAE not_costume
		// copy the name into a 0x104-byte stack buffer without "costume_N\" ...
		c += " 81 EC 04 01 00 00";                // SUB ESP, 0x104
		c += " 8B D4";                            // MOV EDX, ESP (copy)
		c += " 8B CE";                            // MOV ECX, ESI (name)
		at.pre = c.byteCount();
		c += " 3B CF";                            // CMP ECX, EDI
		c += JAE(Filler(11));                     // JAE skip
		c += " 8A 01";                            // MOV AL, [ECX]
		c += " 88 02";                            // MOV [EDX], AL
		c += " 41 42";                            // INC ECX; INC EDX
		c += JMP(Filler(10));                     // JMP pre
		at.skip = c.byteCount();                  // skip: step past the '\' that ends "costume_N"
		c += " 8A 01";                            // MOV AL, [ECX]
		c += " 84 C0";                            // TEST AL, AL
		c += JZ(Filler(12));                      // JZ rest
		c += " 41";                               // INC ECX
		c += " 3C 5C";                            // CMP AL, '\'
		c += JNE(Filler(11));                     // JNE skip
		at.rest = c.byteCount();
		c += " 8A 01";                            // MOV AL, [ECX]
		c += " 88 02";                            // MOV [EDX], AL
		c += " 84 C0";                            // TEST AL, AL
		c += JZ(Filler(14));                      // JZ dot (EDX = the copy's terminator)
		c += " 41 42";                            // INC ECX; INC EDX
		c += JMP(Filler(12));                     // JMP rest
		// ... and without the "_N" before the extension
		at.dot = c.byteCount();
		c += " 3B D4";                            // CMP EDX, ESP
		c += JBE(Filler(16));                     // JBE retry (no '.')
		c += " 4A";                               // DEC EDX
		c += " 80 3A 2E";                         // CMP BYTE [EDX], '.'
		c += JNE(Filler(14));                     // JNE dot
		c += " 8D 4A FE";                         // LEA ECX, [EDX-2]
		c += " 3B CC";                            // CMP ECX, ESP
		c += JB(Filler(16));                      // JB retry
		c += " 80 39 5F";                         // CMP BYTE [ECX], '_'
		c += JNE(Filler(16));                     // JNE retry
		at.strip = c.byteCount();
		c += " 8A 02";                            // MOV AL, [EDX]
		c += " 88 01";                            // MOV [ECX], AL
		c += " 84 C0";                            // TEST AL, AL
		c += JZ(Filler(16));                      // JZ retry
		c += " 42 41";                            // INC EDX; INC ECX
		c += JMP(Filler(15));                     // JMP strip
		// retry: CFile_Open(copy, 0, 1, 0) on the loader's own CFile, which keeps its own copy of the name
		at.retry = c.byteCount();
		c += " 8B C4";                            // MOV EAX, ESP
		c += leaCFile;                            // LEA ECX, [EBP-x]
		c += " 6A 00 6A 01 6A 00";                // PUSH 0; PUSH 1; PUSH 0
		c += " 50";                               // PUSH EAX
		c += CALL(Filler(17));                    // CALL CFile_Open (pops its 4 arguments)
		c += " 81 C4 04 01 00 00";                // ADD ESP, 0x104 (AL kept)
		c += " 5F";                               // POP EDI
		c += " 84 C0";                            // TEST AL, AL
		c += JNZ(Filler(1));                      // JNZ success (the base file opened)
		c += JMP(Filler(7));                      // JMP error (AL = 0)
		return {
			code: c,
			fills: (vir, success, error) => ({
				start: vir, 1: success, 7: error, 17: cfileOpenVir,
				2: vir + at.scan, 3: vir + at.notCostume, 4: vir + at.ascii, 5: vir + at.next, 6: vir + at.found,
				8: vir + at.len, 9: vir + at.lenDone, 10: vir + at.pre, 11: vir + at.skip, 12: vir + at.rest,
				14: vir + at.dot, 15: vir + at.strip, 16: vir + at.retry
			})
		};
	};

	const p11bFb = costumeFallback(" 8D 8D C4 FB FF FF");    // LEA ECX, [EBP-0x43c] (the loader's CFile)

	$$(_, '0716.P11b.3', `Allocate and write costume fallback trampoline`)
	const [p11bFbPhys, p11bFbVir] = Exe.Allocate(p11bFb.code.byteCount(), 0x10);
	Exe.SetHex(p11bFbPhys, SetFillTargets(p11bFb.code, p11bFb.fills(p11bFbVir, successVir, errorVir)));

	$$(_, '0716.P11b.4', `Redirect JNE to costume fallback trampoline`)
	// Replace 6-byte JNE with 5-byte JMP + 1 NOP
	const jneRedirect = SetFillTargets(JMP(Filler(1)), {
		start: jneVir,
		1: p11bFbVir
	});
	Exe.SetHex(jnePhys, jneRedirect + " 90");

	$$(_, '0716.P11b.5', `ACT file costume fallback - same logic for CActFile__Open`)
	// CActFile__Open (0x70bac0) has same CFile_Open → JNE pattern.
	// JNE at 0x70bb6e, success=0x70bd69, error=0x70bb74, CFile at [EBP-0x8c].
	const actJnePattern = " 0F 85 F5 01 00 00";
	const actJnePhys = Exe.FindHex(actJnePattern, Exe.Vir2Phy(0x70bb6a, CODE), Exe.Vir2Phy(0x70bb78, CODE));
	if (actJnePhys < 0)
		throw Error("Phase 11b: CActFile__Open JNE pattern not found");

	const actJneVir = Exe.Phy2Vir(actJnePhys, CODE);
	const actSuccessVir = 0x70bd69;
	const actErrorVir = actJneVir + 6;  // 0x70bb74

	const p11bAct = costumeFallback(" 8D 8D 74 FF FF FF");   // LEA ECX, [EBP-0x8c]
	const [p11bActPhys, p11bActVir] = Exe.Allocate(p11bAct.code.byteCount(), 0x10);
	Exe.SetHex(p11bActPhys, SetFillTargets(p11bAct.code, p11bAct.fills(p11bActVir, actSuccessVir, actErrorVir)));

	const actRedirect = SetFillTargets(JMP(Filler(1)), {
		start: actJneVir,
		1: p11bActVir
	});
	Exe.SetHex(actJnePhys, actRedirect + " 90");

	$$(_, '0716.P11b.6', `PAL file costume fallback`)
	// CSpriteRes__LoadPalette (0x725b60) JNZ at 0x725bfe.
	// Costume_1 SPR/ACT files exist, but PAL files may not → fallback needed.
	const palJnePattern = " 0F 85 AA 01 00 00";
	const palJnePhys = Exe.FindHex(palJnePattern, Exe.Vir2Phy(0x725bfa, CODE), Exe.Vir2Phy(0x725c08, CODE));
	if (palJnePhys < 0)
		throw Error("Phase 11b: CSpriteRes__LoadPalette JNZ pattern not found");

	const palJneVir = Exe.Phy2Vir(palJnePhys, CODE);
	const palSuccessVir = 0x725dae;
	const palErrorVir = palJneVir + 6;

	const p11bPal = costumeFallback(" 8D 4D 94");            // LEA ECX, [EBP-0x6c]
	const [p11bPalPhys, p11bPalVir] = Exe.Allocate(p11bPal.code.byteCount(), 0x10);
	Exe.SetHex(p11bPalPhys, SetFillTargets(p11bPal.code, p11bPal.fills(p11bPalVir, palSuccessVir, palErrorVir)));
	Exe.SetHex(palJnePhys, SetFillTargets(JMP(Filler(1)), {
		start: palJneVir, 1: p11bPalVir
	}) + " 90");


	// ==========================================================
	// Phase 12: Skill tree tiers - handled entirely via Lua
	// ==========================================================
	// CMode__InitSkillTreeFromLua assigns tiers: root job (next=Novice) gets
	// tier 0, non-extended/non-4th jobs get tier 1. Tiers 0 and 1 merge on
	// the first tab. The Lua wrapper in PCFuncs.lua (InitSkillTreeView) reads
	// JOB_SKILL_TIER from PCIds.lua to override tiers for custom job chains.
	// No binary patches or WARP inputs needed.


	// ==========================================================
	// Phase 13: PCRace - let custom jobs opt into the Doram sprite path
	// ==========================================================
	// is_doram_job_id (0x00d9cf80) is a hardcoded switch over the stock
	// Doram class IDs {0x1079..0x107D, 0x10D4, 0x10DB}. It gates the
	// "도람족/" sprite branch in CResourceMgr__GetSpritePath plus ~40
	// other callers (DoramItemOffset, GetSpriteScale, NameplateYOffset,
	// CItemLayerRenderer, char select/create, styling shop, etc.). A
	// custom job that wants the Doram race (e.g. PCPaths[id]="summoner")
	// cannot reach the Doram branch and ends up rendered as human.
	//
	// We hook the function's failure exit at 0x00d9cfa4 - every "not a
	// stock Doram ID" path lands here, either via JA (range miss) or
	// via the jump-table default. When fired, we consult global Lua
	// table PCRace; if PCRace[jobid] is non-nil, return AL=1 (Doram).
	// Otherwise we return AL=0 like the original.
	//
	// Lua API (set in any JobInfo .lua loaded by Phase 11):
	//   PCRace = PCRace or {}
	//   PCRace[PCIds.MY_CUSTOM_DORAM] = "doram"   -- any truthy value
	//
	// GitHub: CrazyBebop/WARP0716#27

	$$(_, '0716.P13.1', `Locate is_doram_job_id failure exit`)
	const p13Pattern =
		" 55 8B EC 8B 45 08"           // PUSH EBP; MOV EBP,ESP; MOV EAX,[EBP+8]
	+	" 05 87 EF FF FF"              // ADD EAX, -0x1079
	+	" 83 F8 62"                    // CMP EAX, 0x62
	+	" 77 14"                       // JA failExit (+0x14)
	;
	const p13EntryPhys = Exe.FindHex(p13Pattern);
	if (p13EntryPhys < 0)
		throw Error("Phase 13: is_doram_job_id prologue not found");

	const p13EntryVir = Exe.Phy2Vir(p13EntryPhys, CODE);
	const p13FailVir  = p13EntryVir + 0x24;  // = 0x00d9cfa4
	const p13FailPhys = Exe.Vir2Phy(p13FailVir, CODE);

	$$(_, '0716.P13.2', `Verify failure-exit bytes`)
	const failBytes = Exe.GetHex(p13FailPhys, 6);
	if (failBytes !== " 32 C0 5D C2 04 00")
		throw Error("Phase 13: failure exit bytes mismatch - got" + failBytes);

	$$(_, '0716.P13.3', `Build PCRace trampoline`)
	// Entered with EBP still saved (POP EBP not yet executed at 0xd9cfa4).
	// jobId is at [EBP+8] (stdcall RET 4).

	const p13_lua_getfield = 0x519DF0;
	const p13_lua_rawgeti  = 0x51A650;
	const p13_lua_settop   = 0x51AAB0;
	const p13_lua_type     = 0x51AE20;

	let p13 = "";

	// MOV EAX, [g_luaState]; TEST EAX,EAX; JZ .nope
	p13 += " A1" + g_luaState.toHex(4);
	p13 += " 85 C0";
	p13 += JZ(Filler(80));

	// lua_getfield(L, LUA_GLOBALSINDEX, "PCRace")
	const p13PushStrOff = p13.byteCount();
	p13 += " 68 00 00 00 00";              // PUSH &"PCRace" (fixup below)
	p13 += " 68 EE D8 FF FF";              // PUSH -10002 (LUA_GLOBALSINDEX)
	p13 += " 50";                          // PUSH EAX (L)
	p13 += CALL(Filler(91));                // CALL lua_getfield
	p13 += " 83 C4 0C";                    // ADD ESP, 12

	// lua_type(L,-1) - must be LUA_TTABLE (5), else pop1_nope
	p13 += " 6A FF";                       // PUSH -1
	p13 += " FF 35" + g_luaState.toHex(4); // PUSH [g_luaState]
	p13 += CALL(Filler(94));                // CALL lua_type
	p13 += " 83 C4 08";                    // ADD ESP, 8
	p13 += " 83 F8 05";                    // CMP EAX, 5 (LUA_TTABLE)
	p13 += JNE(Filler(81));                 // JNE .pop1_nope

	// lua_rawgeti(L, -1, jobid)
	p13 += " FF 75 08";                    // PUSH [EBP+8] (jobid)
	p13 += " 6A FF";                       // PUSH -1
	p13 += " FF 35" + g_luaState.toHex(4); // PUSH [g_luaState]
	p13 += CALL(Filler(92));                // CALL lua_rawgeti
	p13 += " 83 C4 0C";

	// lua_type - any non-nil = Doram
	p13 += " 6A FF";
	p13 += " FF 35" + g_luaState.toHex(4);
	p13 += CALL(Filler(94));                // CALL lua_type
	p13 += " 83 C4 08";
	p13 += " 85 C0";                       // TEST EAX, EAX (LUA_TNIL == 0)
	p13 += JZ(Filler(82));                  // JZ .pop2_nope

	// Doram hit - settop(L,-3) pops table + value
	p13 += " 6A FD";                       // PUSH -3
	p13 += " FF 35" + g_luaState.toHex(4);
	p13 += CALL(Filler(93));                // CALL lua_settop
	p13 += " 83 C4 08";
	p13 += " B0 01";                       // MOV AL, 1
	p13 += " 5D";                          // POP EBP
	p13 += " C2 04 00";                    // RET 4

	// .pop2_nope: have table + value on stack
	const p13Pop2Off = p13.byteCount();
	p13 += " 6A FD";                       // PUSH -3
	p13 += " FF 35" + g_luaState.toHex(4);
	p13 += CALL(Filler(93));
	p13 += " 83 C4 08";
	p13 += JMP(Filler(80));                 // JMP .nope

	// .pop1_nope: have table on stack
	const p13Pop1Off = p13.byteCount();
	p13 += " 6A FE";                       // PUSH -2
	p13 += " FF 35" + g_luaState.toHex(4);
	p13 += CALL(Filler(93));
	p13 += " 83 C4 08";

	// .nope: XOR AL,AL; POP EBP; RET 4
	const p13NopeOff = p13.byteCount();
	p13 += " 32 C0";
	p13 += " 5D";
	p13 += " C2 04 00";

	// Data: "PCRace\0"
	const p13StrOff = p13.byteCount();
	p13 += " 50 43 52 61 63 65 00";

	$$(_, '0716.P13.4', `Allocate trampoline and patch failure exit`)
	const [p13TrPhys, p13TrVir] = Exe.Allocate(p13.byteCount(), 0x10);

	Exe.SetHex(p13TrPhys, SetFillTargets(p13, {
		start: p13TrVir,
		80: p13TrVir + p13NopeOff,
		81: p13TrVir + p13Pop1Off,
		82: p13TrVir + p13Pop2Off,
		91: p13_lua_getfield,
		92: p13_lua_rawgeti,
		93: p13_lua_settop,
		94: p13_lua_type
	}));
	// Fix up absolute PUSH &"PCRace"
	Exe.SetInt32(p13TrPhys + p13PushStrOff + 1, p13TrVir + p13StrOff);

	// Replace 6-byte failure exit with JMP rel32 → trampoline + 1 NOP
	Exe.SetHex(p13FailPhys, SetFillTargets(JMP(Filler(1)), {
		start: p13FailVir, 1: p13TrVir
	}) + " 90");


	// ==========================================================
	// Phase 14: PCMotionInheritTbl - attack motion like a stock job
	// ==========================================================
	// The attack picks its action group (10 = actions 80..87, 11 = 88..95) through a thiscall
	// (job, sex, weapon lo, weapon hi) at 0x00d72d30 that resolves the weapon type and switches on
	// the job, with per-sex weapon lists, up to 4307. Any later job (every custom job) falls to the
	// default and always plays group 10, whatever the weapon or sex.
	//
	// The entry is hooked: for a job past the stock switch, PCMotionInheritTbl[job] (any JobInfo
	// .lua loaded by Phase 11) names a stock job and the decision is made as that job, dual-wield
	// branch included. No entry keeps the stock behaviour.
	//
	// Lua API:
	//   PCMotionInheritTbl = PCMotionInheritTbl or {}
	//   PCMotionInheritTbl[PCIds.MY_CUSTOM] = 4307   -- attack like Hyper Novice
	//
	// GitHub: CrazyBebop/WARP0716#72

	$$(_, '0716.P14.1', `Locate the attack action-group decision`)
	const p14Pattern = " 55 8B EC 83 EC 08 8B 45 14 53 8B D9 56 8B 75 08 57 8B 7D 10 89 7D F8";
	const p14Phys = Exe.FindHex(p14Pattern);
	if (p14Phys < 0 || Exe.FindHex(p14Pattern, p14Phys + 1) >= 0)
		throw Error("Phase 14: attack action-group decision missing or not unique");
	const p14Vir = Exe.Phy2Vir(p14Phys, CODE);

	$$(_, '0716.P14.2', `Build PCMotionInheritTbl trampoline`)
	const p14_lua_tointeger = 0x51AC50;

	let p14 = "";
	p14 += " 55 8B EC 83 EC 08";               // stolen: PUSH EBP; MOV EBP,ESP; SUB ESP,8
	p14 += " 81 7D 08 D4 10 00 00";            // CMP DWORD PTR [EBP+8], 4308 (past the stock switch)
	p14 += JB(Filler(70));                      // JB .back
	p14 += " A1" + g_luaState.toHex(4);         // MOV EAX, [g_luaState]
	p14 += " 85 C0";                            // TEST EAX, EAX
	p14 += JZ(Filler(70));                      // JZ .back
	p14 += " 51";                               // PUSH ECX (this)

	// lua_getfield(L, LUA_GLOBALSINDEX, "PCMotionInheritTbl")
	const p14PushStrOff = p14.byteCount();
	p14 += " 68 00 00 00 00";                   // PUSH &"PCMotionInheritTbl" (fixup below)
	p14 += " 68 EE D8 FF FF";                   // PUSH -10002 (LUA_GLOBALSINDEX)
	p14 += " 50";                               // PUSH EAX (L)
	p14 += CALL(Filler(91));                    // CALL lua_getfield
	p14 += " 83 C4 0C";                         // ADD ESP, 12

	// lua_type(L,-1) must be LUA_TTABLE (5)
	p14 += " 6A FF";                            // PUSH -1
	p14 += " FF 35" + g_luaState.toHex(4);      // PUSH [g_luaState]
	p14 += CALL(Filler(94));                    // CALL lua_type
	p14 += " 83 C4 08";                         // ADD ESP, 8
	p14 += " 83 F8 05";                         // CMP EAX, 5
	p14 += JNE(Filler(71));                     // JNE .pop1

	// lua_rawgeti(L, -1, job); only a number counts (Novice is job 0, so 0 is a real answer)
	p14 += " FF 75 08";                         // PUSH [EBP+8] (job)
	p14 += " 6A FF";                            // PUSH -1
	p14 += " FF 35" + g_luaState.toHex(4);      // PUSH [g_luaState]
	p14 += CALL(Filler(92));                    // CALL lua_rawgeti
	p14 += " 83 C4 0C";                         // ADD ESP, 12
	p14 += " 6A FF";                            // PUSH -1
	p14 += " FF 35" + g_luaState.toHex(4);      // PUSH [g_luaState]
	p14 += CALL(Filler(94));                    // CALL lua_type
	p14 += " 83 C4 08";                         // ADD ESP, 8
	p14 += " 83 F8 03";                         // CMP EAX, 3 (LUA_TNUMBER)
	p14 += " B8 FF FF FF FF";                   // MOV EAX, -1 (no answer; MOV keeps the flags)
	p14 += JNE(Filler(74));                     // JNE .pop2
	p14 += " 6A FF";                            // PUSH -1
	p14 += " FF 35" + g_luaState.toHex(4);      // PUSH [g_luaState]
	p14 += CALL(Filler(95));                    // CALL lua_tointeger
	p14 += " 83 C4 08";                         // ADD ESP, 8

	// .pop2: lua_settop(L, -3) pops the value and the table; EAX = the stock job or -1
	const p14Pop2Off = p14.byteCount();
	p14 += " 50";                               // PUSH EAX
	p14 += " 6A FD";                            // PUSH -3
	p14 += " FF 35" + g_luaState.toHex(4);      // PUSH [g_luaState]
	p14 += CALL(Filler(93));                    // CALL lua_settop
	p14 += " 83 C4 08";                         // ADD ESP, 8
	p14 += " 58";                               // POP EAX
	p14 += " 85 C0";                            // TEST EAX, EAX
	p14 += JL(Filler(72));                      // JL .restore
	p14 += " 89 45 08";                         // MOV [EBP+8], EAX (decide as the stock job)

	// .restore
	const p14RestoreOff = p14.byteCount();
	p14 += " 59";                               // POP ECX
	// .back
	const p14BackOff = p14.byteCount();
	p14 += JMP(Filler(73));                     // JMP after the stolen bytes

	// .pop1: only the non-table global is on the stack
	const p14Pop1Off = p14.byteCount();
	p14 += " 6A FE";                            // PUSH -2
	p14 += " FF 35" + g_luaState.toHex(4);      // PUSH [g_luaState]
	p14 += CALL(Filler(93));                    // CALL lua_settop
	p14 += " 83 C4 08";                         // ADD ESP, 8
	p14 += JMP(Filler(72));                     // JMP .restore

	// Data: "PCMotionInheritTbl\0"
	const p14StrOff = p14.byteCount();
	p14 += " 50 43 4D 6F 74 69 6F 6E 49 6E 68 65 72 69 74 54 62 6C 00";

	$$(_, '0716.P14.3', `Allocate the trampoline and hook the entry`)
	const [p14TrPhys, p14TrVir] = Exe.Allocate(p14.byteCount(), 0x10);
	Exe.SetHex(p14TrPhys, SetFillTargets(p14, {
		start: p14TrVir,
		70: p14TrVir + p14BackOff,
		71: p14TrVir + p14Pop1Off,
		72: p14TrVir + p14RestoreOff,
		73: p14Vir + 6,
		74: p14TrVir + p14Pop2Off,
		91: p13_lua_getfield,
		92: p13_lua_rawgeti,
		93: p13_lua_settop,
		94: p13_lua_type,
		95: p14_lua_tointeger
	}));
	Exe.SetInt32(p14TrPhys + p14PushStrOff + 1, p14TrVir + p14StrOff);

	// Replace the 6-byte prologue with JMP rel32 -> trampoline + 1 NOP
	Exe.SetHex(p14Phys, SetFillTargets(JMP(Filler(1)), {
		start: p14Vir, 1: p14TrVir
	}) + " 90");


	// ==========================================================
	// Phase 15: garments draw behind a custom job like a stock job's
	// ==========================================================
	// Whether a garment draws over the body or behind it, frame by frame, is asked of the robe Lua
	// _New_DrawOnTop(robe, sex, job, act, frame) (kRO's spreditinfo\_new_2dlayerdir_f.lub) from four
	// places: the world actor 0x00D36D60, the UI avatar 0x007AD9E0, 0x007D6E40 and 0x00D58E60. Its
	// tables list, per job, the frames where the garment goes behind (the ones facing the camera), and
	// a job with no row gets "over the body" in every frame, so a custom job's wings covered its front.
	//
	// The four calls copy the one 14-letter name string, so renaming it to PCNewDrawOnTop (14 letters)
	// sends all of them to Phase 11's wrapper, which asks Gravity's function as a stock job for a custom
	// job Gravity has no row for, and passes every other job through unchanged. The fix is not written
	// into Gravity's own LAYER_ALL_TABLE_LIST because the client loads the robe Lua again when a server
	// is picked (0x00D2AAB7 calls 0x00D64530), which would put that table back.
	//
	// Lua API (optional; the default already covers a custom job with no row):
	//   PCRobeInheritTbl = PCRobeInheritTbl or {}
	//   PCRobeInheritTbl[PCIds.MY_CUSTOM] = 4252   -- garments layer like Dragon Knight

	$$(_, '0716.P15', `Send the garment layer question to PCNewDrawOnTop (Phase 11's Lua)`)
	const p15Phys = Exe.FindText("_New_DrawOnTop", PHYSICAL);
	if (p15Phys < 0)
		throw Error("Phase 15: the _New_DrawOnTop name string not found");
	Exe.SetText(p15Phys, "PCNewDrawOnTop");


	$$(_, '0716.14', `Ask about copying Lua files (the error display is asked in Phase 11, where it is used)`)
	if (!Warp.TestMode)
	{
		// A profile or session hands a D_Bool back as the text "true" / "false", and "false" is truthy:
		// test the value, never its truthiness (an answered No used to copy all seven).
		if (["true", "1"].includes(String(Exe.GetUserInput('$copyCJLub', D_Bool, "Copy Custom Job Lua",
			"Custom jobs need seven Lua files inside your client's <b>data</b> folder. "
			+ "Copy them there for you? You choose the folder next.", true))))
		{
			Exe.GetUserInput('$cjLuaDir', D_Folder, "Custom Job Lua Target",
				"Folder to copy them into. They go under <b>data\\Luafiles514\\Lua Files\\JobInfo</b> "
			  + "inside whatever you choose, so pick your client folder to use them straight away. The "
			  + "default puts them beside the patched exe, and you move them across with it.",
				System.DirPath(Warp.TgtExe), {saveDefault: true});
		}
	}

	return true;
};

///
/// \brief Extra steps when the patch is applied (Copy the Lua files if requested)
///
CustomJobs.onApplied = function()
{
	const _ = 'CustomJobs.onApplied';

	if (!Warp.TestMode && ["true", "1"].includes(String(Exe.GetSavedInput('$copyCJLub'))))   // "false" is truthy: test the value
	{
		$$(_, 1.1, `Prepare the directory paths`)

		/// The target defaults to a data folder beside the OUTPUT exe, which is where this has always
		/// put them - NOT the client folder, despite what the old prompt implied. $cjLuaDir overrides
		/// it. Falling back rather than requiring it keeps a profile or session that answered the
		/// question before this option existed working exactly as it did.
		const suffix = "/Luafiles514/Lua Files/JobInfo";
		const srcDir = Warp.Path + "Inputs" + suffix;
		const root = Exe.GetSavedInput('$cjLuaDir') || System.DirPath(Warp.TgtExe);
		let tgtDir = root + "/data" + suffix;

		$$(_, 1.2, `Create the target directory`)
		const ready = System.MkDir(tgtDir);
		if (!ready)
			return;

		$$(_, 2, `Copy all the lua files to the target directory`)
		for (const prefix of
		[
			"PCIds",
			"PCPaths",
			"PCImfs",
			"PCHands",
			"PCPals",
			"PCNames",
			"PCFuncs"
		])
			System.Copy(srcDir + "/" + prefix + ".lua", tgtDir);
	}
};

