///
/// \brief Set the delay between walk-click inputs.
///
///        This was TWO patches until 2026-08-10: "Remove Walk Delay" (NOPped the guard) and
///        "Customize Walk Delay" (wrote a value). They were the same knob:
///
///            original      81 C1 58 02 00 00   add ecx, 258h   ; ecx = last + 600
///            NoWalkDelay   90 90 90 90 90 90   (NOPped)        ; ecx = last
///            Custom(0)     81 C1 00 00 00 00   add ecx, 0      ; ecx = last
///
///        Both leave `cmp eax, ecx` comparing now against the last stamp with nothing added, so
///        they are identical at 0. Merged into one value-based patch; entering 0 reproduces the
///        old "Remove Walk Delay" byte for byte in effect.
///
WalkDelay = function(_)
{
	$$(_, 1.1, `Find the delay addition`)
	const reg = (Exe.Version === 6 ? EDX : ECX); //VC6 uses EDX
	const code =
		ADD(reg, 0x258)   //add regA, 258h ; 600ms
	+   CMP(EAX, reg)     //cmp eax, regA ; regA is Either edx OR ecx
	;

	const addr = Exe.FindHex(code);
	if (addr < 0)
		throw Error("Delay addition missing");

	//
	// ★★★★★ THERE USED TO BE A SECOND SITE HERE. IT IS NOT A WALK DELAY. DO NOT ADD IT BACK.
	//        GitHub #39.
	//
	// For post-20170329 clients this patch also searched for `add ecx, 15Eh / cmp eax, ecx` and
	// treated it as a second walk delay. On 2025-07-16 that resolves to 0x00D47790, inside
	// C3dActorPC__DispatchActionEvent (0x00D473B0) - a jump table over ~150 action-event ids.
	// Ghidra bails on it ("Could not recover jumptable"), so the whole region is unanalyzed and
	// neither get_function_by_address nor get_xrefs_to finds anything there. Resolving the table
	// by hand (ptr table 0x00D47E64, index table 0x00D47EBC, 22 targets over 150 ids) the body
	// holding it is slot 18, reached by EXACTLY ONE id: 91.
	//
	//     call [timeGetTime]
	//     mov  ecx, [ebx+0x520]
	//     add  ecx, 15Eh          <-- the "second walk delay" that never was
	//     cmp  eax, ecx
	//     jbe  <bail>             ; too soon
	//     mov  [ebx+0x520], eax   ; stamp
	//     push 0x8A               ; re-dispatch as event 138
	//     call [eax+0x18]         ; -> C3dActorPC__OnActionEventDispatch (0x00D3C500)
	//
	// So event 91 is an AUTO-REPEAT rate-limited to ~3/sec, which is simply not a walk delay. A
	// patch that sets "the delay between walk-click inputs" has no business writing to it, so it
	// is left at its stock 350ms.
	//
	// ★★ RETRACTED, 2026-08-10: this site was briefly believed to CAUSE #39. It does not. Tested
	//    with this site at stock 350ms and the walk delay below at 0, and #39 still reproduced -
	//    the character walked up to the NPC. #39 is dose-dependent on the WALK DELAY ITSELF
	//    (below), exactly as the reporter said in the issue: "10ms seems the sweet spot, I tried
	//    lower than 10 and the issue persist". Confirmed at 10ms on our client too.
	//

	$$(_, 2.1, `Get the delay value from the user`)
	const varName = '$walkDelay';
	const result = Exe.GetUserInput(varName, D_Uint16, "Walk Delay",
		"Delay in milliseconds between walk-click inputs. The client default is 600.<br><br>" +
		"Lower is more responsive, but <b>do not go below 10</b>. Below that the character will " +
		"walk onto an NPC's cell while its dialog or shop window is open. 10 is the lowest value " +
		"confirmed working, on both the reporter's server and ours.<br><br>" +
		"0 is accepted and gives the old 'Remove Walk Delay' behaviour exactly, including that bug.",
		600, {min: 0, max: 1000, saveDefault: true});

	if (result === false)
		Cancel("Delay", 600);

	$$(_, 2.2, `Write it into the immediate`)
	Exe.SetFromVar(addr + 2, varName);

	return true;
};

///
/// \brief Wrapper. 'Remove Walk Delay' (NoWalkDelay) was retired on 2026-08-10 - it was this same
///        patch with the value pinned to 0, so it is now just an input of 0.
///
CustomWalkDelay = WalkDelay;
