	clawProcess.h(" 56");                             // PUSH ESI
	clawProcess.h(" 57");                             // PUSH EDI
	clawProcess.h(" 89 CF");                          // MOV EDI, ECX
	clawProcess.h(" 8D 45 F8");                       // LEA EAX, [EBP-8]
	clawProcess.h(" 50");                             // PUSH EAX
	clawProcess.j(CALL, nowNsV);                  // CALL nowNsV
	clawProcess.h(" 8B 4D F8");                       // MOV ECX, DWORD [EBP-8]
	clawProcess.h(" 83 C4 04");                       // ADD ESP, 4
	clawProcess.h(" 2B 8F D0 00 00 00");              // SUB ECX, DWORD [EDI+0xD0]
	clawProcess.h(" 8B 45 FC");                       // MOV EAX, DWORD [EBP-4]
	clawProcess.h(" 1B 87 D4 00 00 00");              // SBB EAX, DWORD [EDI+0xD4]
	clawProcess.h(" 6A 00");                          // PUSH 0
	clawProcess.h(" 68 40 42 0F 00");                 // PUSH 0xF4240
	clawProcess.h(" 50");                             // PUSH EAX
	clawProcess.h(" 51");                             // PUSH ECX
	clawProcess.j(CALL, allDivV);                 // CALL allDivV
	clawProcess.h(" 8B 8F EC 00 00 00");              // MOV ECX, DWORD [EDI+0xEC]
	clawProcess.h(" 89 C3");                          // MOV EBX, EAX
	clawProcess.h(" 8B 87 E8 00 00 00");              // MOV EAX, DWORD [EDI+0xE8]
	clawProcess.h(" 89 D6");                          // MOV ESI, EDX
	clawProcess.h(" 83 C0 1E");                       // ADD EAX, 0x1E
	clawProcess.h(" 83 D1 00");                       // ADC ECX, 0
	clawProcess.h(" 39 C3");                          // CMP EBX, EAX
	clawProcess.j(JNE, ".t1");                    // JNE .t1
	clawProcess.h(" 39 CE");                          // CMP ESI, ECX
	clawProcess.j(JE, ".spawn");                  // JE .spawn
	clawProcess.at(".t1");
	clawProcess.h(" 39 CE");                          // CMP ESI, ECX
	clawProcess.j(JL, ".kept");                   // JL .kept
	clawProcess.j(JG, ".spawn");                  // JG .spawn
	clawProcess.h(" 39 C3");                          // CMP EBX, EAX
	clawProcess.j(JB, ".kept");                   // JB .kept
	clawProcess.at(".spawn");
	clawProcess.h(" 89 F9");                          // MOV ECX, EDI
	clawProcess.j(CALL, clawSpawnV);              // CALL clawSpawnV
	clawProcess.h(" 89 9F E8 00 00 00");              // MOV DWORD [EDI+0xE8], EBX
	clawProcess.h(" 89 B7 EC 00 00 00");              // MOV DWORD [EDI+0xEC], ESI
	clawProcess.at(".kept");
	clawProcess.h(" 8D B7 00 01 00 00");              // LEA ESI, [EDI+0x100]
	clawProcess.h(" 89 F3");                          // MOV EBX, ESI
	clawProcess.h(" 8B 87 DC 00 00 00");              // MOV EAX, DWORD [EDI+0xDC]
	clawProcess.h(" 8D 04 86");                       // LEA EAX, [ESI+EAX*4]
	clawProcess.h(" 89 45 FC");                       // MOV DWORD [EBP-4], EAX
	clawProcess.at(".rm");
	clawProcess.h(" 3B 75 FC");                       // CMP ESI, DWORD [EBP-4]
	clawProcess.j(JAE, ".rmDone");                // JAE .rmDone
	clawProcess.h(" 8B 06");                          // MOV EAX, DWORD [ESI]
	clawProcess.h(" 0F 57 C0");                       // XORPS XMM0, XMM0
	clawProcess.h(" 0F 2F 80 CC 00 00 00");           // COMISS XMM0, DWORD [EAX+0xCC]
	clawProcess.j(JBE, ".keep");                  // JBE .keep
	clawProcess.h(" 50");                             // PUSH EAX
	clawProcess.j(CALL, strFreeV);                // CALL strFreeV
	clawProcess.h(" 83 C4 04");                       // ADD ESP, 4
	clawProcess.j(JMP, ".next");                  // JMP .next
	clawProcess.at(".keep");
	clawProcess.h(" 89 03");                          // MOV DWORD [EBX], EAX
	clawProcess.h(" 83 C3 04");                       // ADD EBX, 4
	clawProcess.at(".next");
	clawProcess.h(" 83 C6 04");                       // ADD ESI, 4
	clawProcess.j(JMP, ".rm");                    // JMP .rm
	clawProcess.at(".rmDone");
	clawProcess.h(" 8D 87 00 01 00 00");              // LEA EAX, [EDI+0x100]
	clawProcess.h(" 29 C3");                          // SUB EBX, EAX
	clawProcess.h(" C1 EB 02");                       // SHR EBX, 2
	clawProcess.h(" 89 9F DC 00 00 00");              // MOV DWORD [EDI+0xDC], EBX
	clawProcess.h(" 31 F6");                          // XOR ESI, ESI
	clawProcess.at(".up");
	clawProcess.h(" 3B B7 DC 00 00 00");              // CMP ESI, DWORD [EDI+0xDC]
	clawProcess.j(JAE, ".upDone");                // JAE .upDone
	clawProcess.h(" FF B4 B7 00 01 00 00");           // PUSH DWORD [EDI+ESI*4+0x100]
	clawProcess.h(" 89 F9");                          // MOV ECX, EDI
	clawProcess.j(CALL, clawPosV);                // CALL clawPosV
	clawProcess.h(" 8B 8C B7 00 01 00 00");           // MOV ECX, DWORD [EDI+ESI*4+0x100]
	clawProcess.h(" 6A 00");                          // PUSH 0
	clawProcess.h(" 6A 00");                          // PUSH 0
	clawProcess.h(" 6A 00");                          // PUSH 0
	clawProcess.j(CALL, strProcessV);             // CALL strProcessV
	clawProcess.h(" 46");                             // INC ESI
	clawProcess.j(JMP, ".up");                    // JMP .up
	clawProcess.at(".upDone");
	clawProcess.h(" FF 87 D8 00 00 00");              // INC DWORD [EDI+0xD8]
	clawProcess.h(" 5F");                             // POP EDI
	clawProcess.h(" 5E");                             // POP ESI
	clawProcess.h(" 5B");                             // POP EBX
	clawProcess.h(" 89 EC");                          // MOV ESP, EBP
	clawProcess.h(" 5D");                             // POP EBP
	clawProcess.h(" C3");                             // RET
	const clawProcessV = clawProcess.put();

	/// Render (+0x10): every claw with the camera
	const clawRender = new Asm();
	clawRender.h(" 56");                             // PUSH ESI
	clawRender.h(" 57");                             // PUSH EDI
	clawRender.h(" 89 CF");                          // MOV EDI, ECX
	clawRender.h(" 31 F6");                          // XOR ESI, ESI
	clawRender.at(".next");
	clawRender.h(" 3B B7 DC 00 00 00");              // CMP ESI, DWORD [EDI+0xDC]
	clawRender.j(JAE, ".ret");                   // JAE .ret
	clawRender.h(" B9 " + (modeMgr).toHex(4));       // MOV ECX, modeMgr
	clawRender.j(CALL, getModeVir);              // CALL getModeVir
	clawRender.h(" 8B 8C B7 00 01 00 00");           // MOV ECX, DWORD [EDI+ESI*4+0x100]
	clawRender.h(" 8B 80 D0 00 00 00");              // MOV EAX, DWORD [EAX+0xD0]
	clawRender.h(" 05 98 00 00 00");                 // ADD EAX, 0x98
	clawRender.h(" 50");                             // PUSH EAX
	clawRender.j(CALL, strRenderV);              // CALL strRenderV
	clawRender.h(" 46");                             // INC ESI
	clawRender.j(JMP, ".next");                  // JMP .next
	clawRender.at(".ret");
	clawRender.h(" 5F");                             // POP EDI
	clawRender.h(" 5E");                             // POP ESI
	clawRender.h(" C3");                             // RET
	const clawRenderV = clawRender.put();

	/// Destroy (+0x14): free every claw
	const clawDestroy = new Asm();
	clawDestroy.h(" 56");                             // PUSH ESI
	clawDestroy.h(" 57");                             // PUSH EDI
	clawDestroy.h(" 89 CF");                          // MOV EDI, ECX
	clawDestroy.h(" 31 F6");                          // XOR ESI, ESI
	clawDestroy.at(".next");
	clawDestroy.h(" 3B B7 DC 00 00 00");              // CMP ESI, DWORD [EDI+0xDC]
	clawDestroy.j(JAE, ".done");                  // JAE .done
	clawDestroy.h(" FF B4 B7 00 01 00 00");           // PUSH DWORD [EDI+ESI*4+0x100]
	clawDestroy.j(CALL, strFreeV);                // CALL strFreeV
	clawDestroy.h(" 83 C4 04");                       // ADD ESP, 4
	clawDestroy.h(" 46");                             // INC ESI
	clawDestroy.j(JMP, ".next");                  // JMP .next
	clawDestroy.at(".done");
	clawDestroy.h(" C7 87 DC 00 00 00 00 00 00 00");  // MOV DWORD [EDI+0xDC], 0
	clawDestroy.h(" 5F");                             // POP EDI
	clawDestroy.h(" 5E");                             // POP ESI
	clawDestroy.h(" C3");                             // RET
	const clawDestroyV = clawDestroy.put();

	/// IsAlive (+0x18), kRO 2026 0x006EFC90: the owner still there and at most +0x2C seconds since Init
	const clawAlive = new Asm();
	clawAlive.h(" 55");                             // PUSH EBP
	clawAlive.h(" 89 E5");                          // MOV EBP, ESP
	clawAlive.h(" 83 EC 10");                       // SUB ESP, 0x10
	clawAlive.h(" 53");                             // PUSH EBX
	clawAlive.h(" 56");                             // PUSH ESI
	clawAlive.h(" 57");                             // PUSH EDI
	clawAlive.h(" 89 CF");                          // MOV EDI, ECX
	clawAlive.j(CALL, baseAliveVir);            // CALL baseAliveVir
	clawAlive.h(" 84 C0");                          // TEST AL, AL
	clawAlive.j(JE, ".dead");                   // JE .dead
	clawAlive.h(" 8D 45 F0");                       // LEA EAX, [EBP-0x10]
	clawAlive.h(" 50");                             // PUSH EAX
	clawAlive.j(CALL, nowNsV);                  // CALL nowNsV
	clawAlive.h(" 83 C4 04");                       // ADD ESP, 4
	clawAlive.h(" 8B 47 2C");                       // MOV EAX, DWORD [EDI+0x2C]
	clawAlive.h(" B9 E8 03 00 00");                 // MOV ECX, 0x3E8
	clawAlive.h(" F7 E9");                          // IMUL ECX
	clawAlive.h(" 89 45 FC");                       // MOV DWORD [EBP-4], EAX
	clawAlive.h(" 89 D3");                          // MOV EBX, EDX
	clawAlive.h(" 8B 75 F0");                       // MOV ESI, DWORD [EBP-0x10]
	clawAlive.h(" 8B 4D F4");                       // MOV ECX, DWORD [EBP-0xC]
	clawAlive.h(" 2B B7 D0 00 00 00");              // SUB ESI, DWORD [EDI+0xD0]
	clawAlive.h(" 1B 8F D4 00 00 00");              // SBB ECX, DWORD [EDI+0xD4]
	clawAlive.h(" 6A 00");                          // PUSH 0
	clawAlive.h(" 68 40 42 0F 00");                 // PUSH 0xF4240
	clawAlive.h(" 51");                             // PUSH ECX
	clawAlive.h(" 56");                             // PUSH ESI
	clawAlive.j(CALL, allDivV);                 // CALL allDivV
	clawAlive.h(" 89 C1");                          // MOV ECX, EAX
	clawAlive.h(" 8B 45 FC");                       // MOV EAX, DWORD [EBP-4]
	clawAlive.h(" 39 C8");                          // CMP EAX, ECX
	clawAlive.j(JNE, ".c1");                    // JNE .c1
	clawAlive.h(" 39 D3");                          // CMP EBX, EDX
	clawAlive.j(JE, ".alive");                  // JE .alive
	clawAlive.at(".c1");
	clawAlive.h(" 39 D3");                          // CMP EBX, EDX
	clawAlive.j(JL, ".dead");                   // JL .dead
	clawAlive.j(JG, ".alive");                  // JG .alive
	clawAlive.h(" 39 C8");                          // CMP EAX, ECX
	clawAlive.j(JB, ".dead");                   // JB .dead
	clawAlive.at(".alive");
	clawAlive.h(" B0 01");                          // MOV AL, 1
	clawAlive.j(JMP, ".ret");                   // JMP .ret
	clawAlive.at(".dead");
	clawAlive.h(" 30 C0");                          // XOR AL, AL
	clawAlive.at(".ret");
	clawAlive.h(" 5F");                             // POP EDI
	clawAlive.h(" 5E");                             // POP ESI
	clawAlive.h(" 5B");                             // POP EBX
	clawAlive.h(" 89 EC");                          // MOV ESP, EBP
	clawAlive.h(" 5D");                             // POP EBP
	clawAlive.h(" C3");                             // RET
	const clawAliveV = clawAlive.put();

	/// d. The class vtables: CEffect's with the slots above (2026's +0x78 destructor is 07-16's
	///    +0x70: 2026 put two slots in at +0x58). Orb and bomb share one; the path is in the object.
	const vtOf = (over) =>
	{
		const s = [];
		for (let k = 0; k < 32; k++)
			s.push(over[4 * k] ?? vt32(fxBaseVt, k));
		const [p, v] = Exe.Allocate(4 * 33, 4);
		Exe.SetHex(p, vt32(fxBaseVt, -1).toHex(4) + s.map(x => x.toHex(4)).join(""));
		return v + 4;
	};
	const bzVt = vtOf({0x04: bzInitV, 0x0C: bzProcessV, 0x10: bzRenderV, 0x14: bzDestroyV, 0x18: bzAliveV,
		0x40: bzDelayV, 0x70: coDtorAt(0x100)});
	const clawVt = vtOf({0x04: clawInitV, 0x0C: clawProcessV, 0x10: clawRenderV, 0x14: clawDestroyV,
		0x18: clawAliveV, 0x70: coDtorAt(0x1C0)});

	/// The factories: static {vtable, class vtable, +0xDC, +0xE0, size}. The world deletes its
	/// factories through slot 0 when it is torn down: a no-op here, these are never freed.
	const facDtorV = putCode(" C2 04 00");      // RET 4
	const [fvP, fvV] = Exe.Allocate(8, 4);
	Exe.SetHex(fvP, facDtorV.toHex(4) + coCreateV.toHex(4));
	const facOf = (cls, dc, e0, size) =>
	{
		const [p, v] = Exe.Allocate(20, 4);
		Exe.SetHex(p, [fvV, cls, dc, e0, size].map(x => x.toHex(4)).join(""));
		return v;
	};
	const facOrb = facOf(bzVt, Exe.AddText(orbPath)[1], orbPath.length, 0x100);
	const facBomb = facOf(bzVt, Exe.AddText(bombPath)[1], bombPath.length, 0x100);
	const facClaw = facOf(clawVt, 0, 0, 0x1C0);

	/// e. The registration. 07-16's own registration gives these three ids the generic .str effect
	///    (CEffectAllocator<CEZ2STREffect>: the .str its property table names, played where it is
	///    spawned) and stops at the first id already taken, so ours cannot go first; 2026 registers
	///    its classes for them in the same function instead. So after the stock registration (its
	///    first 10 bytes run in regTramp) each id's factory in the world's map is replaced with ours.
	const coIdRows = [[0x989, facOrb], [0x9A2, facClaw], [0x9A4, facBomb]];
	const [ciP, coIds] = Exe.Allocate(8 * coIdRows.length + 4, 4);
	Exe.SetHex(ciP, coIdRows.map(([id, f]) => id.toHex(4) + f.toHex(4)).join("") + (0).toHex(4));

	/// the registration's first 10 bytes, then the rest of it
	const regTramp = new Asm();
	regTramp.h(" 55");                             // PUSH EBP
	regTramp.h(" 89 E5");                          // MOV EBP, ESP
	regTramp.h(" 6A FF");                          // PUSH -1
	regTramp.h(" 68 " + (regSeh).toHex(4));        // PUSH regSeh
	regTramp.j(JMP, regBackVir);               // JMP regBackVir
	const regTrampV = regTramp.put();

	/// the effect world's factory registration, then the three ids take our factories (the result kept): 07-16's own registration gives them the generic .str effect (CEffectAllocator<CEZ2STREffect>), so an id already in the world's map (+0x08, a std::map<int, factory*>) has its factory replaced and the old one deleted; one not there is registered
	const regWrap = new Asm();
	regWrap.h(" 51");                             // PUSH ECX
	regWrap.j(CALL, regTrampV);               // CALL regTrampV
	regWrap.h(" 59");                             // POP ECX
	regWrap.h(" 50");                             // PUSH EAX
	regWrap.h(" 53");                             // PUSH EBX
	regWrap.h(" 56");                             // PUSH ESI
	regWrap.h(" 57");                             // PUSH EDI
	regWrap.h(" 89 CB");                          // MOV EBX, ECX
	regWrap.h(" BE " + (coIds).toHex(4));         // MOV ESI, coIds
	regWrap.at(".next");
	regWrap.h(" 8B 06");                          // MOV EAX, DWORD [ESI]
	regWrap.h(" 85 C0");                          // TEST EAX, EAX
	regWrap.j(JE, ".done");                   // JE .done
	regWrap.h(" 8B 53 08");                       // MOV EDX, DWORD [EBX+8]
	regWrap.h(" 8B 4A 04");                       // MOV ECX, DWORD [EDX+4]
	regWrap.h(" 31 FF");                          // XOR EDI, EDI
	regWrap.at(".walk");
	regWrap.h(" 80 79 0D 00");                    // CMP BYTE [ECX+0xD], 0
	regWrap.j(JNE, ".walked");                // JNE .walked
	regWrap.h(" 39 41 10");                       // CMP DWORD [ECX+0x10], EAX
	regWrap.j(JL, ".right");                  // JL .right
	regWrap.h(" 89 CF");                          // MOV EDI, ECX
	regWrap.h(" 8B 09");                          // MOV ECX, DWORD [ECX]
	regWrap.j(JMP, ".walk");                  // JMP .walk
	regWrap.at(".right");
	regWrap.h(" 8B 49 08");                       // MOV ECX, DWORD [ECX+8]
	regWrap.j(JMP, ".walk");                  // JMP .walk
	regWrap.at(".walked");
	regWrap.h(" 85 FF");                          // TEST EDI, EDI
	regWrap.j(JE, ".add");                    // JE .add
	regWrap.h(" 39 47 10");                       // CMP DWORD [EDI+0x10], EAX
	regWrap.j(JNE, ".add");                   // JNE .add
	regWrap.h(" 8B 4F 14");                       // MOV ECX, DWORD [EDI+0x14]
	regWrap.h(" 8B 56 04");                       // MOV EDX, DWORD [ESI+4]
	regWrap.h(" 89 57 14");                       // MOV DWORD [EDI+0x14], EDX
	regWrap.h(" 85 C9");                          // TEST ECX, ECX
	regWrap.j(JE, ".adv");                    // JE .adv
	regWrap.h(" 6A 01");                          // PUSH 1
	regWrap.h(" 8B 01");                          // MOV EAX, DWORD [ECX]
	regWrap.h(" FF 10");                          // CALL DWORD [EAX]
	regWrap.j(JMP, ".adv");                   // JMP .adv
	regWrap.at(".add");
	regWrap.h(" FF 76 04");                       // PUSH DWORD [ESI+4]
	regWrap.h(" 50");                             // PUSH EAX
	regWrap.h(" 89 D9");                          // MOV ECX, EBX
	regWrap.j(CALL, fxRegisterVir);           // CALL fxRegisterVir
	regWrap.at(".adv");
	regWrap.h(" 83 C6 08");                       // ADD ESI, 8
	regWrap.j(JMP, ".next");                  // JMP .next
	regWrap.at(".done");
	regWrap.h(" 5F");                             // POP EDI
	regWrap.h(" 5E");                             // POP ESI
	regWrap.h(" 5B");                             // POP EBX
	regWrap.h(" 58");                             // POP EAX
	regWrap.h(" C3");                             // RET
	const regWrapV = regWrap.put();
	Exe.SetJMP(fxRegPhy, regWrapV);
	Exe.SetHex(fxRegPhy + 5, " 90 90 90 90 90");

	$$(_, 8.7, `Chop Chop's whirlwind: kRO 2026's CWhirlwindEffect`)
	/// Chop Chop launches effect 2444 on the caster, and for that id the 2026 launcher builds a
	/// CWhirlwindEffect: a CRagEffect plus a period (+0x11CA8, 250) and a deadline (+0x11CB0, an
	/// int64 on the clock of 8.6, 0), which Chop Chop sets to 500 and 1000 ms ahead. Each tick it
	/// follows the caster and turns it, its facing (+0x4C) MulDiv(remaining % period, 360, period),
	/// until the deadline, then gives the caster back the facing it kept, x 1000, in the caster's
	/// property map (+0x11C) under key 25 when it was made (unless a whirlwind was already running).
	/// 07-16 has CRagEffect at the same size, its owner at +0x138 (2026 +0x13C), and its Init is not
	/// virtual, so: the class is 07-16's CRagEffect vtable with the destructor and the tick replaced,
	/// the launcher builds it for 2444 and keeps the facing there (the new effect is not in the
	/// caster's list yet in either client), and Chop Chop's row arms it (whirlArm). The routines
	/// follow kRO 2026 0x00708490 / 0x00708330 / 0x00E15E90 / 0x007085C0 / 0x00708610 one for one
	/// (tools/druid_re/whirl_asm.py).
	const lnSite = coFind(" 81 FE 45 03 00 00 0F 85 ?? ?? ?? ?? 68 ?? ?? ?? ?? 68 B0 1C 01 00 E8", "the effect launcher's class choice");
	coFind(" 8B C1 89 45 E4 8B 75 08 83 FE 7F 0F 85", "the effect launcher's actor slot [EBP-0x1C]");
	const rcPhy = lnSite + 12;
	const rcVir = Exe.Phy2Vir(rcPhy, CODE);                        //Rolling Cutter's CRollingCutterRagEffect
	const plainVir = rcVir + Exe.GetInt32(lnSite + 8);             //the plain CRagEffect
	const plainPhy = Exe.Vir2Phy(plainVir, CODE);
	if (Exe.FindHex(" 68 A8 1C 01 00 E8 ?? ?? ?? ?? 83 C4 04 89 45 EC C7 45 FC 01 00 00 00 85 C0 0F 84 ?? ?? ?? ?? 8B C8 E8",
			plainPhy, plainPhy + 38) !== plainPhy || Exe.FindHex(" 8B F8 EB 02 33 FF C7 45 FC FF FF FF FF", rcPhy + 39, rcPhy + 52) !== rcPhy + 39)
		throw Error("EnableDruidClasses: the effect launcher's paths moved");
	const opNewVir = callAt(plainPhy + 5);                         //operator new
	const ragCtorVir = callAt(plainPhy + 33);                      //CRagEffect::CRagEffect
	const nullVir = Exe.Phy2Vir(rcPhy + 43, CODE);                 //xor edi,edi: no effect
	const builtVir = Exe.Phy2Vir(rcPhy + 45, CODE);                //the shared Init and attach (EDI = effect)
	const ragCtorPhy = Exe.Vir2Phy(ragCtorVir, CODE);
	const rvtAt = Exe.FindHex(" 8B F1 89 75 F0 E8 ?? ?? ?? ?? C7 45 FC 00 00 00 00 C7 06", ragCtorPhy, ragCtorPhy + 0x40);
	if (rvtAt < 0)
		throw Error("EnableDruidClasses: CRagEffect's vtable missing");
	const ragVt = Exe.GetInt32(rvtAt + 19);
	const rcDtor = coFind(" 8B F1 89 75 F0 C7 06 ?? ?? ?? ?? C7 45 FC FF FF FF FF E8 ?? ?? ?? ?? F6 45 08 01 74 0E 68 B0 1C 01 00 56 E8",
		"CRollingCutterRagEffect's destructor");
	const ragDtorBodyVir = callAt(rcDtor + 18);                    //~CRagEffect
	const rcProcVir = vt32(Exe.GetInt32(rcDtor + 7), 1);           //CRollingCutterRagEffect's tick
	const rcProcPhy = Exe.Vir2Phy(rcProcVir, CODE);
	const lbAt = Exe.FindHex(" 8D 9F 1C 01 00 00 89 45 EC 8B CB 8D 45 F0 89 55 E8 50 8D 45 D4 50 E8", rcProcPhy, rcProcPhy + 0x300);
	const insAt = Exe.FindHex(" 8B CB 50 FF 75 D8 FF 75 D4 E8", rcProcPhy, rcProcPhy + 0x300);
	const xlenAt = Exe.FindHex(" 8B E5 5D C3 E8 ?? ?? ?? ?? CC", rcProcPhy, rcProcPhy + 0x300);
	if (lbAt < 0 || insAt < 0 || xlenAt < 0)
		throw Error("EnableDruidClasses: the property map calls missing");
	const lowerBoundVir = callAt(lbAt + 22);                       //std::map<int, int64>::lower_bound (thiscall)
	const insertNodeVir = callAt(insAt + 9);                       //its node insert
	const xlenVir = callAt(xlenAt + 4);                            //"map/set too long"
	const hasEffectVir = Exe.Phy2Vir(coFind(" 55 8B EC 8B 91 44 01 00 00 56 8B 02 3B C2 74 18 8B 75 08 8B 48 08 85 C9 74 08"
		+ " 39 B1 68 01 00 00 74 0D 8B 00 3B C2 75 EB 32 C0 5E 5D C2 04 00 B0 01", "the actor's HasEffect(id)"), CODE);
	const ftol3Vir = Exe.Phy2Vir(coFind(" 83 3D ?? ?? ?? ?? 06 7C 1A B8 01 00 00 00 C5 F9 92 C8 62 F1 7D 89 7A C0", "__ftol3"), CODE);
	const [thP, thousandV] = Exe.Allocate(4, 4);
	Exe.SetInt32(thP, 0x447A0000);                                 //1000.0f
	/// The vtable is written once the destructor and the tick exist; whirlArm and the launcher's
	/// branch take its address, so it is reserved first.
	const [wvtP, wvtV] = Exe.Allocate(4 * 20, 4);
	const whirlVt = wvtV + 4;

	/// a. The routines (tools/druid_re/whirl_asm.py, from its Intel-syntax source).
	/// Process (vtable +0x04), kRO 2026 0x00708490: follow the actor, turn it MulDiv(remaining % period, 360, period), alive until the deadline, then its facing back from key 25
	const whirlProcess = new Asm();
	whirlProcess.h(" 55");                             // PUSH EBP
	whirlProcess.h(" 89 E5");                          // MOV EBP, ESP
	whirlProcess.h(" 83 EC 14");                       // SUB ESP, 0x14
	whirlProcess.h(" 56");                             // PUSH ESI
	whirlProcess.h(" 89 CE");                          // MOV ESI, ECX
	whirlProcess.h(" 8B 8E 38 01 00 00");              // MOV ECX, DWORD [ESI+0x138]
	whirlProcess.h(" 85 C9");                          // TEST ECX, ECX
	whirlProcess.j(JNE, ".go");                    // JNE .go
	whirlProcess.h(" 30 C0");                          // XOR AL, AL
	whirlProcess.h(" 5E");                             // POP ESI
	whirlProcess.h(" 89 EC");                          // MOV ESP, EBP
	whirlProcess.h(" 5D");                             // POP EBP
	whirlProcess.h(" C3");                             // RET
	whirlProcess.at(".go");
	whirlProcess.h(" 8B 41 10");                       // MOV EAX, DWORD [ECX+0x10]
	whirlProcess.h(" 89 46 10");                       // MOV DWORD [ESI+0x10], EAX
	whirlProcess.h(" 8B 41 14");                       // MOV EAX, DWORD [ECX+0x14]
	whirlProcess.h(" 89 46 14");                       // MOV DWORD [ESI+0x14], EAX
	whirlProcess.h(" 8B 41 18");                       // MOV EAX, DWORD [ECX+0x18]
	whirlProcess.h(" 53");                             // PUSH EBX
	whirlProcess.h(" 89 46 18");                       // MOV DWORD [ESI+0x18], EAX
	whirlProcess.h(" 8D 45 F8");                       // LEA EAX, [EBP-8]
	whirlProcess.h(" 57");                             // PUSH EDI
	whirlProcess.h(" 50");                             // PUSH EAX
	whirlProcess.j(CALL, nowNsV);                  // CALL nowNsV
	whirlProcess.h(" 8B 8E B0 1C 01 00");              // MOV ECX, DWORD [ESI+0x11CB0]
	whirlProcess.h(" 83 C4 04");                       // ADD ESP, 4
	whirlProcess.h(" 8B 5D F8");                       // MOV EBX, DWORD [EBP-8]
	whirlProcess.h(" 29 D9");                          // SUB ECX, EBX
	whirlProcess.h(" 8B 86 B4 1C 01 00");              // MOV EAX, DWORD [ESI+0x11CB4]
	whirlProcess.h(" 8B 7D FC");                       // MOV EDI, DWORD [EBP-4]
	whirlProcess.h(" 19 F8");                          // SBB EAX, EDI
	whirlProcess.h(" 6A 00");                          // PUSH 0
	whirlProcess.h(" 68 40 42 0F 00");                 // PUSH 0xF4240
	whirlProcess.h(" 50");                             // PUSH EAX
	whirlProcess.h(" 51");                             // PUSH ECX
	whirlProcess.j(CALL, allDivV);                 // CALL allDivV
	whirlProcess.h(" 8B 8E A8 1C 01 00");              // MOV ECX, DWORD [ESI+0x11CA8]
	whirlProcess.h(" 31 D2");                          // XOR EDX, EDX
	whirlProcess.h(" 85 C0");                          // TEST EAX, EAX
	whirlProcess.h(" 51");                             // PUSH ECX
	whirlProcess.h(" 0F 48 C2");                       // CMOVS EAX, EDX
	whirlProcess.h(" 99");                             // CDQ
	whirlProcess.h(" F7 F9");                          // IDIV ECX
	whirlProcess.h(" 68 68 01 00 00");                 // PUSH 0x168
	whirlProcess.h(" 52");                             // PUSH EDX
	whirlProcess.h(" FF 15 " + (mulDivIat).toHex(4));  // CALL DWORD [mulDivIat]
	whirlProcess.h(" 66 0F 6E C0");                    // MOVD XMM0, EAX
	whirlProcess.h(" 8B 86 38 01 00 00");              // MOV EAX, DWORD [ESI+0x138]
	whirlProcess.h(" 0F 5B C0");                       // CVTDQ2PS XMM0, XMM0
	whirlProcess.h(" F3 0F 11 40 4C");                 // MOVSS DWORD [EAX+0x4C], XMM0
	whirlProcess.h(" 8B 8E B0 1C 01 00");              // MOV ECX, DWORD [ESI+0x11CB0]
	whirlProcess.h(" 8B 86 B4 1C 01 00");              // MOV EAX, DWORD [ESI+0x11CB4]
	whirlProcess.h(" 39 CB");                          // CMP EBX, ECX
	whirlProcess.j(JNE, ".c1");                    // JNE .c1
	whirlProcess.h(" 39 C7");                          // CMP EDI, EAX
	whirlProcess.j(JE, ".done");                   // JE .done
	whirlProcess.at(".c1");
	whirlProcess.h(" 39 C7");                          // CMP EDI, EAX
	whirlProcess.j(JG, ".done");                   // JG .done
	whirlProcess.j(JL, ".alive");                  // JL .alive
	whirlProcess.h(" 39 CB");                          // CMP EBX, ECX
	whirlProcess.j(JAE, ".done");                  // JAE .done
	whirlProcess.at(".alive");
	whirlProcess.h(" 5F");                             // POP EDI
	whirlProcess.h(" 5B");                             // POP EBX
	whirlProcess.h(" B0 01");                          // MOV AL, 1
	whirlProcess.h(" 5E");                             // POP ESI
	whirlProcess.h(" 89 EC");                          // MOV ESP, EBP
	whirlProcess.h(" 5D");                             // POP EBP
	whirlProcess.h(" C3");                             // RET
	whirlProcess.at(".done");
	whirlProcess.h(" 8B BE 38 01 00 00");              // MOV EDI, DWORD [ESI+0x138]
	whirlProcess.h(" 8D 45 FC");                       // LEA EAX, [EBP-4]
	whirlProcess.h(" 50");                             // PUSH EAX
	whirlProcess.h(" 8D 45 EC");                       // LEA EAX, [EBP-0x14]
	whirlProcess.h(" C7 45 FC 19 00 00 00");           // MOV DWORD [EBP-4], 0x19
	whirlProcess.h(" 50");                             // PUSH EAX
	whirlProcess.h(" 8D 8F 1C 01 00 00");              // LEA ECX, [EDI+0x11C]
	whirlProcess.j(CALL, lowerBoundVir);           // CALL lowerBoundVir
	whirlProcess.h(" 8B 45 F4");                       // MOV EAX, DWORD [EBP-0xC]
	whirlProcess.h(" 80 78 0D 00");                    // CMP BYTE [EAX+0xD], 0
	whirlProcess.j(JNE, ".nf");                    // JNE .nf
	whirlProcess.h(" 83 78 10 19");                    // CMP DWORD [EAX+0x10], 0x19
	whirlProcess.j(JG, ".nf");                     // JG .nf
	whirlProcess.h(" 8B 8F 1C 01 00 00");              // MOV ECX, DWORD [EDI+0x11C]
	whirlProcess.j(JMP, ".cmp");                   // JMP .cmp
	whirlProcess.at(".nf");
	whirlProcess.h(" 8B 87 1C 01 00 00");              // MOV EAX, DWORD [EDI+0x11C]
	whirlProcess.h(" 89 C1");                          // MOV ECX, EAX
	whirlProcess.at(".cmp");
	whirlProcess.h(" 39 C8");                          // CMP EAX, ECX
	whirlProcess.j(JNE, ".found");                 // JNE .found
	whirlProcess.h(" 0F 57 C0");                       // XORPS XMM0, XMM0
	whirlProcess.h(" 66 0F 13 45 F8");                 // MOVLPD QWORD [EBP-8], XMM0
	whirlProcess.h(" 8B 4D F8");                       // MOV ECX, DWORD [EBP-8]
	whirlProcess.j(JMP, ".set");                   // JMP .set
	whirlProcess.at(".found");
	whirlProcess.h(" 8B 48 18");                       // MOV ECX, DWORD [EAX+0x18]
	whirlProcess.h(" 8B 40 1C");                       // MOV EAX, DWORD [EAX+0x1C]
	whirlProcess.at(".set");
	whirlProcess.h(" 66 0F 6E C1");                    // MOVD XMM0, ECX
	whirlProcess.h(" 30 C0");                          // XOR AL, AL
	whirlProcess.h(" 0F 5B C0");                       // CVTDQ2PS XMM0, XMM0
	whirlProcess.h(" F3 0F 5E 05 " + (thousandV).toHex(4)); // DIVSS XMM0, DWORD [thousandV]
	whirlProcess.h(" F3 0F 11 47 4C");                 // MOVSS DWORD [EDI+0x4C], XMM0
	whirlProcess.h(" 5F");                             // POP EDI
	whirlProcess.h(" 5B");                             // POP EBX
	whirlProcess.h(" 5E");                             // POP ESI
	whirlProcess.h(" 89 EC");                          // MOV ESP, EBP
	whirlProcess.h(" 5D");                             // POP EBP
	whirlProcess.h(" C3");                             // RET
	const whirlProcessV = whirlProcess.put();

	/// the deleting destructor (vtable +0x00), kRO 2026 0x00E15E90: the CRagEffect part, then 0x11CB8 bytes when asked
	const whirlDtor = new Asm();
	whirlDtor.h(" 55");                             // PUSH EBP
	whirlDtor.h(" 89 E5");                          // MOV EBP, ESP
	whirlDtor.h(" 56");                             // PUSH ESI
	whirlDtor.h(" 89 CE");                          // MOV ESI, ECX
	whirlDtor.j(CALL, ragDtorBodyVir);          // CALL ragDtorBodyVir
	whirlDtor.h(" F6 45 08 01");                    // TEST BYTE [EBP+8], 1
	whirlDtor.j(JE, ".ret");                    // JE .ret
	whirlDtor.h(" 68 B8 1C 01 00");                 // PUSH 0x11CB8
	whirlDtor.h(" 56");                             // PUSH ESI
	whirlDtor.j(CALL, opDeleteVir);             // CALL opDeleteVir
	whirlDtor.h(" 83 C4 08");                       // ADD ESP, 8
	whirlDtor.at(".ret");
	whirlDtor.h(" 89 F0");                          // MOV EAX, ESI
	whirlDtor.h(" 5E");                             // POP ESI
	whirlDtor.h(" 5D");                             // POP EBP
	whirlDtor.h(" C2 04 00");                       // RET 4
	const whirlDtorV = whirlDtor.put();

	/// whirlSave(actor) stdcall, kRO 2026 0x00708330 before its CRagEffect Init: unless the actor carries an effect 2444, its facing x 1000 into its property map under key 25
	const whirlSave = new Asm();
	whirlSave.h(" 55");                             // PUSH EBP
	whirlSave.h(" 89 E5");                          // MOV EBP, ESP
	whirlSave.h(" 83 EC 30");                       // SUB ESP, 0x30
	whirlSave.h(" 53");                             // PUSH EBX
	whirlSave.h(" 56");                             // PUSH ESI
	whirlSave.h(" 57");                             // PUSH EDI
	whirlSave.h(" 8B 7D 08");                       // MOV EDI, DWORD [EBP+8]
	whirlSave.h(" 68 8C 09 00 00");                 // PUSH 0x98C
	whirlSave.h(" 89 F9");                          // MOV ECX, EDI
	whirlSave.j(CALL, hasEffectVir);            // CALL hasEffectVir
	whirlSave.h(" 84 C0");                          // TEST AL, AL
	whirlSave.j(JNE, ".ret");                   // JNE .ret
	whirlSave.h(" F3 0F 10 47 4C");                 // MOVSS XMM0, DWORD [EDI+0x4C]
	whirlSave.h(" F3 0F 59 05 " + (thousandV).toHex(4)); // MULSS XMM0, DWORD [thousandV]
	whirlSave.j(CALL, ftol3Vir);                // CALL ftol3Vir
	whirlSave.h(" 89 45 E8");                       // MOV DWORD [EBP-0x18], EAX
	whirlSave.h(" 8D 9F 1C 01 00 00");              // LEA EBX, [EDI+0x11C]
	whirlSave.h(" 8D 45 F0");                       // LEA EAX, [EBP-0x10]
	whirlSave.h(" 89 55 E4");                       // MOV DWORD [EBP-0x1C], EDX
	whirlSave.h(" 50");                             // PUSH EAX
	whirlSave.h(" 8D 45 D0");                       // LEA EAX, [EBP-0x30]
	whirlSave.h(" C7 45 F0 19 00 00 00");           // MOV DWORD [EBP-0x10], 0x19
	whirlSave.h(" 50");                             // PUSH EAX
	whirlSave.h(" 89 D9");                          // MOV ECX, EBX
	whirlSave.j(CALL, lowerBoundVir);           // CALL lowerBoundVir
	whirlSave.h(" 8B 45 D8");                       // MOV EAX, DWORD [EBP-0x28]
	whirlSave.h(" 80 78 0D 00");                    // CMP BYTE [EAX+0xD], 0
	whirlSave.j(JNE, ".ins");                   // JNE .ins
	whirlSave.h(" 83 78 10 19");                    // CMP DWORD [EAX+0x10], 0x19
	whirlSave.j(JLE, ".store");                 // JLE .store
	whirlSave.at(".ins");
	whirlSave.h(" 81 7B 04 FF FF FF 07");           // CMP DWORD [EBX+4], 0x7FFFFFF
	whirlSave.j(JE, ".long");                   // JE .long
	whirlSave.h(" 8B 33");                          // MOV ESI, DWORD [EBX]
	whirlSave.h(" 6A 20");                          // PUSH 0x20
	whirlSave.j(CALL, opNewVir);                // CALL opNewVir
	whirlSave.h(" 83 C4 04");                       // ADD ESP, 4
	whirlSave.h(" 8B 4D F0");                       // MOV ECX, DWORD [EBP-0x10]
	whirlSave.h(" 89 48 10");                       // MOV DWORD [EAX+0x10], ECX
	whirlSave.h(" C7 40 18 00 00 00 00");           // MOV DWORD [EAX+0x18], 0
	whirlSave.h(" C7 40 1C 00 00 00 00");           // MOV DWORD [EAX+0x1C], 0
	whirlSave.h(" 89 30");                          // MOV DWORD [EAX], ESI
	whirlSave.h(" 89 70 04");                       // MOV DWORD [EAX+4], ESI
	whirlSave.h(" 89 70 08");                       // MOV DWORD [EAX+8], ESI
	whirlSave.h(" 66 C7 40 0C 00 00");              // MOV WORD PTR [EAX+0xC], 0
	whirlSave.h(" 89 D9");                          // MOV ECX, EBX
	whirlSave.h(" 50");                             // PUSH EAX
	whirlSave.h(" FF 75 D4");                       // PUSH DWORD [EBP-0x2C]
	whirlSave.h(" FF 75 D0");                       // PUSH DWORD [EBP-0x30]
	whirlSave.j(CALL, insertNodeVir);           // CALL insertNodeVir
	whirlSave.at(".store");
	whirlSave.h(" 8B 4D E8");                       // MOV ECX, DWORD [EBP-0x18]
	whirlSave.h(" 89 48 18");                       // MOV DWORD [EAX+0x18], ECX
	whirlSave.h(" 8B 4D E4");                       // MOV ECX, DWORD [EBP-0x1C]
	whirlSave.h(" 89 48 1C");                       // MOV DWORD [EAX+0x1C], ECX
	whirlSave.at(".ret");
	whirlSave.h(" 5F");                             // POP EDI
	whirlSave.h(" 5E");                             // POP ESI
	whirlSave.h(" 5B");                             // POP EBX
	whirlSave.h(" 89 EC");                          // MOV ESP, EBP
	whirlSave.h(" 5D");                             // POP EBP
	whirlSave.h(" C2 04 00");                       // RET 4
	whirlSave.at(".long");
	whirlSave.j(CALL, xlenVir);                 // CALL xlenVir
	const whirlSaveV = whirlSave.put();

	/// b. The vtable: 07-16's CRagEffect slots (19, its RTTI locator before them), the destructor and
	///    the tick replaced. CRollingCutterRagEffect, the other CRagEffect of this kind, shares slot 2.
	if (vt32(Exe.GetInt32(rcDtor + 7), 2) !== vt32(ragVt, 2))
		throw Error("EnableDruidClasses: CRagEffect's vtable is not the expected one");
	let wvt = vt32(ragVt, -1).toHex(4);
	for (let k = 0; k < 19; k++)
		wvt += (k === 0 ? whirlDtorV : k === 1 ? whirlProcessV : vt32(ragVt, k)).toHex(4);
	Exe.SetHex(wvtP, wvt);

	/// whirlArm(effect, ms, period) stdcall, kRO 2026 0x007085C0 + 0x00708610: the deadline ms ahead on the clock, the period; only on a CWhirlwindEffect
	const whirlArm = new Asm();
	whirlArm.h(" 55");                             // PUSH EBP
	whirlArm.h(" 89 E5");                          // MOV EBP, ESP
	whirlArm.h(" 83 EC 08");                       // SUB ESP, 8
	whirlArm.h(" 56");                             // PUSH ESI
	whirlArm.h(" 8B 75 08");                       // MOV ESI, DWORD [EBP+8]
	whirlArm.h(" 85 F6");                          // TEST ESI, ESI
	whirlArm.j(JE, ".ret");                    // JE .ret
	whirlArm.h(" 81 3E " + (whirlVt).toHex(4));    // CMP DWORD [ESI], whirlVt
	whirlArm.j(JNE, ".ret");                   // JNE .ret
	whirlArm.h(" 8D 45 F8");                       // LEA EAX, [EBP-8]
	whirlArm.h(" 50");                             // PUSH EAX
	whirlArm.j(CALL, nowNsV);                  // CALL nowNsV
	whirlArm.h(" 83 C4 04");                       // ADD ESP, 4
	whirlArm.h(" 8B 45 0C");                       // MOV EAX, DWORD [EBP+0xC]
	whirlArm.h(" BA 40 42 0F 00");                 // MOV EDX, 0xF4240
	whirlArm.h(" F7 EA");                          // IMUL EDX
	whirlArm.h(" 03 45 F8");                       // ADD EAX, DWORD [EBP-8]
	whirlArm.h(" 13 55 FC");                       // ADC EDX, DWORD [EBP-4]
	whirlArm.h(" 89 86 B0 1C 01 00");              // MOV DWORD [ESI+0x11CB0], EAX
	whirlArm.h(" 89 96 B4 1C 01 00");              // MOV DWORD [ESI+0x11CB4], EDX
	whirlArm.h(" 8B 45 10");                       // MOV EAX, DWORD [EBP+0x10]
	whirlArm.h(" 89 86 A8 1C 01 00");              // MOV DWORD [ESI+0x11CA8], EAX
	whirlArm.at(".ret");
	whirlArm.h(" 5E");                             // POP ESI
	whirlArm.h(" 89 EC");                          // MOV ESP, EBP
	whirlArm.h(" 5D");                             // POP EBP
	whirlArm.h(" C2 0C 00");                       // RET 0xC
	const whirlArmV = whirlArm.put();

	/// the launcher's class choice (replaces cmp esi,0x345 / jne): Rolling Cutter as stock; 2444 a CWhirlwindEffect (0x11CB8 bytes, CRagEffect(), its vtable, period 250, deadline 0) and, with an actor, Init's part; else the plain CRagEffect
	const whirlNew = new Asm();
	whirlNew.h(" 81 FE 45 03 00 00");              // CMP ESI, 0x345
	whirlNew.j(JE, rcVir);                     // JE rcVir
	whirlNew.h(" 81 FE 8C 09 00 00");              // CMP ESI, 0x98C
	whirlNew.j(JNE, plainVir);                 // JNE plainVir
	whirlNew.h(" 68 B8 1C 01 00");                 // PUSH 0x11CB8
	whirlNew.j(CALL, opNewVir);                // CALL opNewVir
	whirlNew.h(" 83 C4 04");                       // ADD ESP, 4
	whirlNew.h(" 89 45 EC");                       // MOV DWORD [EBP-0x14], EAX
	whirlNew.h(" C7 45 FC 01 00 00 00");           // MOV DWORD [EBP-4], 1
	whirlNew.h(" 85 C0");                          // TEST EAX, EAX
	whirlNew.j(JE, nullVir);                   // JE nullVir
	whirlNew.h(" 89 C1");                          // MOV ECX, EAX
	whirlNew.j(CALL, ragCtorVir);              // CALL ragCtorVir
	whirlNew.h(" 89 C7");                          // MOV EDI, EAX
	whirlNew.h(" C7 07 " + (whirlVt).toHex(4));    // MOV DWORD [EDI], whirlVt
	whirlNew.h(" C7 87 A8 1C 01 00 FA 00 00 00");  // MOV DWORD [EDI+0x11CA8], 0xFA
	whirlNew.h(" C7 87 B0 1C 01 00 00 00 00 00");  // MOV DWORD [EDI+0x11CB0], 0
	whirlNew.h(" C7 87 B4 1C 01 00 00 00 00 00");  // MOV DWORD [EDI+0x11CB4], 0
	whirlNew.h(" 8B 45 E4");                       // MOV EAX, DWORD [EBP-0x1C]
	whirlNew.h(" 85 C0");                          // TEST EAX, EAX
	whirlNew.j(JE, ".on");                     // JE .on
	whirlNew.h(" 50");                             // PUSH EAX
	whirlNew.j(CALL, whirlSaveV);              // CALL whirlSaveV
	whirlNew.at(".on");
	whirlNew.j(JMP, builtVir);                 // JMP builtVir
	const whirlNewV = whirlNew.put();

	/// c. The launcher builds it for 2444 (its 12 bytes cmp esi,0x345 / jne are the hook), and d. Chop
	///    Chop's row (8.1's "whirl" op) calls whirlArm through the cell 8.4 left for it.
	Exe.SetJMP(lnSite, whirlNewV);
	Exe.SetHex(lnSite + 5, " 90 90 90 90 90 90 90");
	Exe.SetInt32(whirlCellP, whirlArmV);

	$$(_, 8.8, `The skill-effect height, as the 2026 client computes it (mounts)`)
	/// The height an actor's skill effects are placed at (eight calls in the skill-effect positioner,
	/// one in the rising particles). kRO 2026's (0x00E1A720) is 07-16's (0x00C43FE0) plus the actor's
	/// size factor on most results (07-16's 0x00C43FE0 has the flag but not the factor; the factor
	/// itself is 07-16's 0x00C43070, which 2026 inlines here) and, for a rider that is not a baby or
	/// a Doram, a table of the CPc's appearance job (written first thing in SetAppearance; +0x4CC here,
	/// +0x4E4 there): DRUID, KARNOS, ALITEA, Novice, 4001, 4190, 23 and 4307 give 2 x factor, 4306,
	/// 4215 and 24 give 0, the rest 6 x factor (07-16: always 6). 07-16's function now jumps to the
	/// port (tools/druid_re/height_asm.py), which calls 07-16's own job tests.
	const ehSig = " 56 6A FF 8B F1 E8 ?? ?? ?? ?? 3D AE 0F 00 00 7F 14 ?? ?? ?? ?? 00 00 83 F8 0D ?? ?? ?? ?? 00 00 83 F8 15"
		+ " EB 3C 3D B6 10 00 00 7F 1E ?? ?? ?? ?? 00 00 2D B6 0F 00 00 83 F8 5A 77 2B 0F B6 80 ?? ?? ?? ?? FF 24 85 ?? ?? ?? ??"
		+ " 2D B7 10 00 00 ?? ?? ?? ?? 00 00 83 E8 01 ?? ?? ?? ?? 00 00 83 E8 01 ?? ?? ?? ?? 00 00 6A FF 8B CE E8 ?? ?? ?? ??"
		+ " 50 B9 ?? ?? ?? ?? E8 ?? ?? ?? ?? 85 C0 75 26 6A FF 8B CE E8 ?? ?? ?? ?? 50 B9 ?? ?? ?? ?? E8 ?? ?? ?? ?? 84 C0 75 0E"
		+ " ?? ?? ?? ?? 00 00 3B 05 ?? ?? ?? ?? 75 67 6A FF 8B CE E8 ?? ?? ?? ?? 50 B9 ?? ?? ?? ?? E8 ?? ?? ?? ?? 84 C0 74 19"
		+ " 80 BE CC 02 00 00 00 74 08 D9 05 ?? ?? ?? ?? 5E C3 D9 05 ?? ?? ?? ?? 5E C3 6A FF 8B CE E8 ?? ?? ?? ?? 50 B9 ?? ?? ?? ??"
		+ " E8 ?? ?? ?? ?? 8A 8E CC 02 00 00 84 C0 74 14 84 C9 74 08";
	const ehPhy = coFind(ehSig, "the skill-effect height");
	const jobMgrVa = Exe.GetInt32(ehPhy + 0x72);                  //mov ecx, the job tests' object
	const validWrapVir = callAt(ehPhy + 0x76);
	const validIdVir = callAt(ehPhy + 0x8E);
	const accountVa = Exe.GetInt32(ehPhy + 0x9F);                 //cmp eax, [the player's account id]
	const isBabyVir = callAt(ehPhy + 0xB4);
	const isDoramVir = callAt(ehPhy + 0xE5);
	const scaleVir = Exe.Phy2Vir(coFind(" 55 8B EC F7 81 E8 00 00 00 10 00 00 00 74 6C 0F B6 89 F0 00 00 00 8D 14 8D 5A 00 00 00"
		+ " 81 FA 0E 01 00 00 76 17", "the actor's size factor"), CODE);
	const appPhy = coFind(" 55 8B EC 53 56 8B 75 08 57 FF 75 0C 8B F9 89 B7", "SetAppearance's job store");
	const appJobOff = Exe.GetInt32(appPhy + 16);                   //mov [edi+off],esi: the appearance job
	const tdPcVir = Exe.FindText(".?AVCPc@@");
	const tdActorVir = Exe.FindText(".?AVCGameActor@@");
	if (tdPcVir <= 0 || tdActorVir <= 0)
		throw Error("EnableDruidClasses: the CPc / CGameActor type descriptors missing");
	const tdPc = tdPcVir - 8;
	const tdActor = tdActorVir - 8;
	const dynCastVir = callAt(coFind(" 6A 00 68" + tdPc.toHex(4) + " 68" + tdActor.toHex(4) + " 6A 00 57 E8", "a CGameActor -> CPc cast") + 15);
	const ehF = [6.0, 4.0, -1.0, -3.0, -2.0].map(x => { const v = new DataView(new ArrayBuffer(4)); v.setFloat32(0, x, true); return v.getUint32(0, true); });
	const [ehFP, ehFV] = Exe.Allocate(4 * ehF.length, 4);
	Exe.SetHex(ehFP, ehF.map(x => x.toHex(4)).join(""));
	const [sixV, fourV, minus1V, minus3V, minus2V] = [0, 4, 8, 12, 16].map(o => ehFV + o);

	/// the skill-effect height (thiscall actor -> ST0), kRO 2026 0x00E1A720 with 07-16's calls; 07-16's own function jumps here
	const effHeight = new Asm();
	effHeight.h(" 55");                             // PUSH EBP
	effHeight.h(" 89 E5");                          // MOV EBP, ESP
	effHeight.h(" 51");                             // PUSH ECX
	effHeight.h(" 56");                             // PUSH ESI
	effHeight.h(" 89 CE");                          // MOV ESI, ECX
	effHeight.h(" C7 45 FC 00 00 80 3F");           // MOV DWORD [EBP-4], 0x3F800000
	effHeight.h(" 8D 45 FC");                       // LEA EAX, [EBP-4]
	effHeight.h(" 50");                             // PUSH EAX
	effHeight.h(" 89 F1");                          // MOV ECX, ESI
	effHeight.j(CALL, scaleVir);                // CALL scaleVir
	effHeight.h(" 6A FF");                          // PUSH -1
	effHeight.h(" 89 F1");                          // MOV ECX, ESI
	effHeight.j(CALL, getJobVir);               // CALL getJobVir
	effHeight.h(" 3D AE 0F 00 00");                 // CMP EAX, 0xFAE
	effHeight.j(JG, ".a");                      // JG .a
	effHeight.j(JE, ".six");                    // JE .six
	effHeight.h(" 83 F8 0D");                       // CMP EAX, 0xD
	effHeight.j(JE, ".six");                    // JE .six
	effHeight.h(" 83 F8 15");                       // CMP EAX, 0x15
	effHeight.j(JE, ".six");                    // JE .six
	effHeight.j(JMP, ".cont");                  // JMP .cont
	effHeight.at(".a");
	effHeight.h(" 3D B6 10 00 00");                 // CMP EAX, 0x10B6
	effHeight.j(JG, ".b");                      // JG .b
	effHeight.j(JE, ".six");                    // JE .six
	effHeight.h(" 3D B6 0F 00 00");                 // CMP EAX, 0xFB6
	effHeight.j(JE, ".six");                    // JE .six
	effHeight.h(" 8D 88 10 F0 FF FF");              // LEA ECX, [EAX-0xFF0]
	effHeight.h(" 83 F9 0F");                       // CMP ECX, 0xF
	effHeight.j(JBE, ".six");                   // JBE .six
	effHeight.h(" 3D C4 0F 00 00");                 // CMP EAX, 0xFC4
	effHeight.j(JE, ".four");                   // JE .four
	effHeight.h(" 3D CC 0F 00 00");                 // CMP EAX, 0xFCC
	effHeight.j(JE, ".four");                   // JE .four
	effHeight.h(" 8D 88 F3 EF FF FF");              // LEA ECX, [EAX-0x100D]
	effHeight.h(" 83 F9 03");                       // CMP ECX, 3
	effHeight.j(JBE, ".four");                  // JBE .four
	effHeight.j(JMP, ".cont");                  // JMP .cont
	effHeight.at(".b");
	effHeight.h(" 8D 88 49 EF FF FF");              // LEA ECX, [EAX-0x10B7]
	effHeight.h(" 83 F9 02");                       // CMP ECX, 2
	effHeight.j(JBE, ".six");                   // JBE .six
	effHeight.j(JMP, ".cont");                  // JMP .cont
	effHeight.at(".four");
	effHeight.h(" D9 45 FC");                       // FLD DWORD [EBP-4]
	effHeight.h(" D8 0D " + (fourV).toHex(4));      // FMUL DWORD [fourV]
	effHeight.h(" 5E");                             // POP ESI
	effHeight.h(" 89 EC");                          // MOV ESP, EBP
	effHeight.h(" 5D");                             // POP EBP
	effHeight.h(" C3");                             // RET
	effHeight.at(".cont");
	effHeight.h(" 6A FF");                          // PUSH -1
	effHeight.h(" 89 F1");                          // MOV ECX, ESI
	effHeight.j(CALL, getJobVir);               // CALL getJobVir
	effHeight.h(" 50");                             // PUSH EAX
	effHeight.h(" B9 " + (jobMgrVa).toHex(4));      // MOV ECX, jobMgrVa
	effHeight.j(CALL, validWrapVir);            // CALL validWrapVir
	effHeight.h(" 85 C0");                          // TEST EAX, EAX
	effHeight.j(JNE, ".c2");                    // JNE .c2
	effHeight.h(" 6A FF");                          // PUSH -1
	effHeight.h(" 89 F1");                          // MOV ECX, ESI
	effHeight.j(CALL, getJobVir);               // CALL getJobVir
	effHeight.h(" 50");                             // PUSH EAX
	effHeight.h(" B9 " + (jobMgrVa).toHex(4));      // MOV ECX, jobMgrVa
	effHeight.j(CALL, validIdVir);              // CALL validIdVir
	effHeight.h(" 84 C0");                          // TEST AL, AL
	effHeight.j(JNE, ".c2");                    // JNE .c2
	effHeight.h(" 8B 86 10 01 00 00");              // MOV EAX, DWORD [ESI+0x110]
	effHeight.h(" 3B 05 " + (accountVa).toHex(4));  // CMP EAX, DWORD [accountVa]
	effHeight.j(JNE, ".zero");                  // JNE .zero
	effHeight.at(".c2");
	effHeight.h(" 6A FF");                          // PUSH -1
	effHeight.h(" 89 F1");                          // MOV ECX, ESI
	effHeight.j(CALL, getJobVir);               // CALL getJobVir
	effHeight.h(" 50");                             // PUSH EAX
	effHeight.h(" B9 " + (jobMgrVa).toHex(4));      // MOV ECX, jobMgrVa
	effHeight.j(CALL, isBabyVir);               // CALL isBabyVir
	effHeight.h(" 84 C0");                          // TEST AL, AL
	effHeight.j(JE, ".nb");                     // JE .nb
	effHeight.h(" 80 BE CC 02 00 00 00");           // CMP BYTE [ESI+0x2CC], 0
	effHeight.j(JE, ".m1");                     // JE .m1
	effHeight.h(" D9 05 " + (fourV).toHex(4));      // FLD DWORD [fourV]
	effHeight.h(" 5E");                             // POP ESI
	effHeight.h(" 89 EC");                          // MOV ESP, EBP
	effHeight.h(" 5D");                             // POP EBP
	effHeight.h(" C3");                             // RET
	effHeight.at(".m1");
	effHeight.h(" D9 05 " + (minus1V).toHex(4));    // FLD DWORD [minus1V]
	effHeight.h(" 5E");                             // POP ESI
	effHeight.h(" 89 EC");                          // MOV ESP, EBP
	effHeight.h(" 5D");                             // POP EBP
	effHeight.h(" C3");                             // RET
	effHeight.at(".nb");
	effHeight.h(" 6A FF");                          // PUSH -1
	effHeight.h(" 89 F1");                          // MOV ECX, ESI
	effHeight.j(CALL, getJobVir);               // CALL getJobVir
	effHeight.h(" 50");                             // PUSH EAX
	effHeight.h(" B9 " + (jobMgrVa).toHex(4));      // MOV ECX, jobMgrVa
	effHeight.j(CALL, isDoramVir);              // CALL isDoramVir
	effHeight.h(" 8A 8E CC 02 00 00");              // MOV CL, BYTE [ESI+0x2CC]
	effHeight.h(" 84 C0");                          // TEST AL, AL
	effHeight.j(JE, ".nd");                     // JE .nd
	effHeight.h(" D9 45 FC");                       // FLD DWORD [EBP-4]
	effHeight.h(" 84 C9");                          // TEST CL, CL
	effHeight.j(JE, ".d2");                     // JE .d2
	effHeight.h(" D8 0D " + (minus3V).toHex(4));    // FMUL DWORD [minus3V]
	effHeight.h(" 5E");                             // POP ESI
	effHeight.h(" 89 EC");                          // MOV ESP, EBP
	effHeight.h(" 5D");                             // POP EBP
	effHeight.h(" C3");                             // RET
	effHeight.at(".d2");
	effHeight.h(" D8 0D " + (minus2V).toHex(4));    // FMUL DWORD [minus2V]
	effHeight.h(" 5E");                             // POP ESI
	effHeight.h(" 89 EC");                          // MOV ESP, EBP
	effHeight.h(" 5D");                             // POP EBP
	effHeight.h(" C3");                             // RET
	effHeight.at(".nd");
	effHeight.h(" 84 C9");                          // TEST CL, CL
	effHeight.j(JE, ".zero");                   // JE .zero
	effHeight.h(" 6A 00");                          // PUSH 0
	effHeight.h(" 68 " + (tdPc).toHex(4));          // PUSH tdPc
	effHeight.h(" 68 " + (tdActor).toHex(4));       // PUSH tdActor
	effHeight.h(" 6A 00");                          // PUSH 0
	effHeight.h(" 56");                             // PUSH ESI
	effHeight.j(CALL, dynCastVir);              // CALL dynCastVir
	effHeight.h(" 83 C4 14");                       // ADD ESP, 0x14
	effHeight.h(" 85 C0");                          // TEST EAX, EAX
	effHeight.j(JE, ".six");                    // JE .six
	effHeight.h(" 8B 80 " + (appJobOff).toHex(4));  // MOV EAX, DWORD [EAX+appJobOff]
	effHeight.h(" 3D 77 10 00 00");                 // CMP EAX, 0x1077
	effHeight.j(JA, ".t2");                     // JA .t2
	effHeight.j(JE, ".zero");                   // JE .zero
	effHeight.h(" 83 F8 18");                       // CMP EAX, 0x18
	effHeight.j(JA, ".t3");                     // JA .t3
	effHeight.j(JE, ".zero");                   // JE .zero
	effHeight.h(" 85 C0");                          // TEST EAX, EAX
	effHeight.j(JE, ".two");                    // JE .two
	effHeight.h(" 83 F8 17");                       // CMP EAX, 0x17
	effHeight.j(JE, ".two");                    // JE .two
	effHeight.j(JMP, ".six");                   // JMP .six
	effHeight.at(".t3");
	effHeight.h(" 3D A1 0F 00 00");                 // CMP EAX, 0xFA1
	effHeight.j(JE, ".two");                    // JE .two
	effHeight.h(" 3D 5E 10 00 00");                 // CMP EAX, 0x105E
	effHeight.j(JE, ".two");                    // JE .two
	effHeight.j(JMP, ".six");                   // JMP .six
	effHeight.at(".t2");
	effHeight.h(" 3D D2 10 00 00");                 // CMP EAX, 0x10D2
	effHeight.j(JE, ".zero");                   // JE .zero
	effHeight.h(" 3D D3 10 00 00");                 // CMP EAX, 0x10D3
	effHeight.j(JE, ".two");                    // JE .two
	effHeight.h(" 3D FF 10 00 00");                 // CMP EAX, 0x10FF
	effHeight.j(JE, ".two");                    // JE .two
	effHeight.h(" 3D 01 11 00 00");                 // CMP EAX, 0x1101
	effHeight.j(JE, ".two");                    // JE .two
	effHeight.h(" 3D 03 11 00 00");                 // CMP EAX, 0x1103
	effHeight.j(JE, ".two");                    // JE .two
	effHeight.at(".six");
	effHeight.h(" D9 45 FC");                       // FLD DWORD [EBP-4]
	effHeight.h(" D8 0D " + (sixV).toHex(4));       // FMUL DWORD [sixV]
	effHeight.h(" 5E");                             // POP ESI
	effHeight.h(" 89 EC");                          // MOV ESP, EBP
	effHeight.h(" 5D");                             // POP EBP
	effHeight.h(" C3");                             // RET
	effHeight.at(".two");
	effHeight.h(" D9 45 FC");                       // FLD DWORD [EBP-4]
	effHeight.h(" D8 C0");                          // FADD ST(0), ST(0)
	effHeight.h(" 5E");                             // POP ESI
	effHeight.h(" 89 EC");                          // MOV ESP, EBP
	effHeight.h(" 5D");                             // POP EBP
	effHeight.h(" C3");                             // RET
	effHeight.at(".zero");
	effHeight.h(" D9 EE");                          // FLDZ
	effHeight.h(" 5E");                             // POP ESI
	effHeight.h(" 89 EC");                          // MOV ESP, EBP
	effHeight.h(" 5D");                             // POP EBP
	effHeight.h(" C3");                             // RET
	const effHeightV = effHeight.put();
	Exe.SetJMP(ehPhy, effHeightV);

	$$(_, 9.1, `Register the Druid line's statuses`)
	/// RegisterAll for the statuses, riding the stock status registrar's own Register call.
	const stRows = statuses.map(([id, fac]) => id.toHex(4) + fac.toHex(4)).join("") + (0).toHex(4);
	const [stTP, stTV] = Exe.Allocate(stRows.byteCount(), 4);
	Exe.SetHex(stTP, stRows);
	let st = "";
	st += " 56 BE" + stTV.toHex(4);      // PUSH ESI / MOV ESI, rows
	const stLoop = st.byteCount();
	st += " 8B 06 85 C0";                // MOV EAX, [ESI] / TEST EAX, EAX
	st += JZ(Filler(1));                 // JZ .done
	st += " 83 EC 28 8B CC";             // SUB ESP, 0x28 / MOV ECX, ESP
	st += " C7 01" + efImpl.toHex(4);    // MOV DWORD [ECX], impl vtable
	st += " 8B 56 04 89 51 04";          // MOV EDX, [ESI+4] / MOV [ECX+4], EDX
	st += " 89 49 24 50";                // MOV [ECX+0x24], ECX / PUSH EAX
	st += " B9" + efStatic.toHex(4);     // MOV ECX, the registrar's static
	st += CALL(Filler(2));               // CALL Register
	st += " 83 C6 08";                   // ADD ESI, 8
	st += JMP(Filler(3));                // JMP .loop
	const stDone = st.byteCount();
	st += " 5E C3";                      // .done: POP ESI / RET
	const [stP, stV] = Exe.Allocate(st.byteCount(), 0x10);
	Exe.SetHex(stP, SetFillTargets(st, {start: stV, 1: stV + stDone, 2: efRegisterVir, 3: stV + stLoop}));

	const erCall = erPhy + 40;
	let ride6 = "";
	ride6 += CALL(Filler(1));            // CALL Register          the stock registration
	ride6 += " 60 9C";                   // PUSHAD / PUSHFD
	ride6 += CALL(Filler(2));            // CALL our statuses
	ride6 += " 9D 61";                   // POPFD / POPAD
	ride6 += JMP(Filler(3));             // JMP back
	Exe.SetJMP(erCall, putCode(ride6, {1: efRegisterVir, 2: stV, 3: Exe.Phy2Vir(erCall + 5, CODE)}));

	$$(_, 9.2, `Register the Druid line's skill actions`)
	/// One vtable + factory per distinct row (most rows share one).
	const factories = {};
	const regRows = [];
	for (const [id, flag0, cast, motion, flag3, aura, slot14] of actions)
	{
		const slots = [];
		for (let k = 0; k < 18; k++)
			slots.push(baseSlot(k));
		if (flag0)
			slots[0] = stub("al1", " B0 01 C3");             // MOV AL, 1 / RET
		if (cast !== 8)
			slots[1] = retInt(cast);
		if (motion !== 7)
			slots[2] = (motion === 0) ? baseSlot(14) : retInt(motion);   //base slot 14 is xor eax,eax / ret
		if (flag3)
			slots[3] = stub("al1r4", " B0 01 C2 04 00");     // MOV AL, 1 / RET 4
		if (aura)
			slots[8] = auraStub(aura);
		if (slot14)
			slots[14] = retInt(slot14);
		const fx = skillFx[id];             // the skill's effects (8.3): they replace the base no-ops
		if (fx)                              // and a plain cast aura (slot 8)
			for (const k in fx)
				slots[+k] = fx[k];

		const key = slots.join(",");
		if (factories[key] === undefined)
		{
			const vt = baseCol.toHex(4) + slots.map(v => v.toHex(4)).join("");
			const [vtP, vtV] = Exe.Allocate(vt.byteCount(), 4);
			Exe.SetHex(vtP, vt);

			let fac = "";
			fac += " 6A 04";                     // PUSH 4
			fac += CALL(Filler(1));              // CALL operator new
			fac += " 83 C4 04";                  // ADD ESP, 4
			fac += " 85 C0";                     // TEST EAX, EAX
			fac += " 74 06";                     // JZ .ret
			fac += " C7 00" + (vtV + 4).toHex(4); // MOV DWORD [EAX], vtable
			fac += " C3";                        // .ret: RET
			const [fP, fV] = Exe.Allocate(fac.byteCount(), 0x10);
			Exe.SetHex(fP, SetFillTargets(fac, {start: fV, 1: newVir}));
			factories[key] = fV;
		}
		regRows.push(id.toHex(4) + factories[key].toHex(4));
	}
	const [rtP, rtV] = Exe.Allocate(regRows.length * 8 + 4, 4);
	Exe.SetHex(rtP, regRows.join("") + (0).toHex(4));

	/// RegisterAll: for each {id, factory} build the std::function on the stack the way the stock
	/// registrars do and call Register(id, function), which copies it and pops both (ret 0x2C).
	let reg = "";
	reg += " 56";                        // PUSH ESI
	reg += " BE" + rtV.toHex(4);         // MOV ESI, rows
	const regLoop = reg.byteCount();
	reg += " 8B 06";                     // MOV EAX, [ESI]         skill id
	reg += " 85 C0";                     // TEST EAX, EAX
	reg += JZ(Filler(1));                // JZ .done
	reg += " 83 EC 28";                  // SUB ESP, 0x28          the std::function
	reg += " 8B CC";                     // MOV ECX, ESP
	reg += " C7 01" + implVt.toHex(4);   // MOV DWORD [ECX], impl vtable
	reg += " 8B 56 04";                  // MOV EDX, [ESI+4]
	reg += " 89 51 04";                  // MOV [ECX+4], EDX       the factory
	reg += " 89 49 24";                  // MOV [ECX+0x24], ECX    stored inline
	reg += " 50";                        // PUSH EAX               skill id
	reg += " B9" + regStatic.toHex(4);   // MOV ECX, the registrar's static
	reg += CALL(Filler(2));              // CALL Register
	reg += " 83 C6 08";                  // ADD ESI, 8
	reg += JMP(Filler(3));               // JMP .loop
	const regDone = reg.byteCount();
	reg += " 5E";                        // POP ESI
	reg += " C3";                        // RET
	const [regP, regV] = Exe.Allocate(reg.byteCount(), 0x10);
	Exe.SetHex(regP, SetFillTargets(reg, {start: regV, 1: regV + regDone, 2: registerVir, 3: regV + regLoop}));

	/// Ride the stock registrar: its own Register call first, then ours, all registers kept.
	let ride5 = "";
	ride5 += CALL(Filler(1));            // CALL Register          the stock registration
	ride5 += " 60 9C";                   // PUSHAD / PUSHFD
	ride5 += CALL(Filler(2));            // CALL RegisterAll
	ride5 += " 9D 61";                   // POPFD / POPAD
	ride5 += JMP(Filler(3));             // JMP back
	const [r5P, r5V] = Exe.Allocate(ride5.byteCount(), 0x10);
	Exe.SetHex(r5P, SetFillTargets(ride5, {start: r5V, 1: registerVir, 2: regV, 3: Exe.Phy2Vir(regCall + 5, CODE)}));
	Exe.SetJMP(regCall, r5V);

	$$(_, 10.1, `Offer the English skill and job files`)
	/// The skill tree, skill names, descriptions and job names come from loose Lua files, not the exe.
	/// Inputs/DruidClasses carries ROenglishRE's five (llchrisll's English translation) with the
	/// Druid line added (tools/druid_re/ro_druid_merge.py; Inputs/DruidClasses/README.txt). Asked
	/// last, after every byte edit is staged, so cancelling here cannot leave the patch half applied.
	/// ★ The answer comes back in three shapes (measured 2026-10-21): the WARP window returns a
	/// boolean, a profile or saved session the TEXT "true" / "false" ("false" is truthy), and an
	/// unanswered headless build false. So the value is tested, never its truthiness. Not a
	/// D_Choice: the WARP window returns false for a D_Choice whose default is accepted unchanged,
	/// so a default "Copy them" never copied there. The decision is kept on the patch for onApplied.
	const isYes = (v) => ["true", "1"].includes(String(v));
	EnableDruidClasses.luaDir = null;
	if (!Warp.TestMode && isYes(Exe.GetUserInput('$copyDruidLua', D_Bool, "Copy the English Druid skill files",
			"The Druid line's skill tree, skill names, descriptions and job names come from five Lua files "
		  + "in your client's <b>data</b> folder, not from the exe. Copy the English ones bundled with this "
		  + "patch? You pick the folder next.<br><br>"
		  + "They are ROenglishRE's files (llchrisll's English translation, 2026-10-07) with the Druid line "
		  + "added. A copy already in that folder is kept first in <b>EnableDruidClasses_backup</b> beside "
		  + "its data folder. The client reads loose files only when it is patched with "
		  + "<b>Read data folder first</b>.<br><br>"
		  + "<b>If WARPGATE installs your English translation (its LANG tab), choose No.</b> That "
		  + "translation carries the Druid line in these five files itself. Copies laid over it count as "
		  + "your own edits, so WARPGATE would ask before giving you any later fix to them.",
			true)))
	{
		Exe.GetUserInput('$druidLuaDir', D_Folder, "Where to put the Druid skill files",
			"Folder to copy them into. They go under <b>data\\luafiles514\\lua files</b> inside whatever you "
		  + "choose, so pick your client folder to use them straight away. The default puts them beside the "
		  + "patched exe, and you move them across with it.",
			System.DirPath(Warp.TgtExe), {saveDefault: true});
		/// The folder the operator gave, else the patched exe's folder (as Custom Jobs does).
		EnableDruidClasses.luaDir = Exe.GetSavedInput('$druidLuaDir') || System.DirPath(Warp.TgtExe);
	}

	$$(_, 10.2, `Offer the rAthena server patch (a fresh rAthena only)`)
	/// rAthena master has no Druid line: its server code is datawulf's (rathena#9765). examples/EnableDruidClasses
	/// carries ONE file, for a fresh rAthena (plain master): that code with our changes on top
	/// (tools/druid_re/make_druid_server_patches.py, re-cut before every release). Since 2026-11-06 no file for
	/// datawulf's own branches ships, and a server that applied an earlier copy gets an update file from the
	/// guide. WARP cannot run git, so the operator applies it on the server; this only puts the file in their hands.
	/// The choice keeps its 10-21 label so a saved answer still picks the file.
	/// ★ A D_Choice accepted at its default comes back false, as does a headless build, so Skip is the
	/// default and every unrecognised answer lands on it (an answer saved for the old datawulf-branch choice too).
	const SERVER_PATCHES = {
		"Plain rAthena master (adds the whole Druid line)": "EnableDruidClasses.master.patch",
	};
	const SKIP = "Skip, my server already has it";
	EnableDruidClasses.serverPatch = null;
	const pick = Warp.TestMode ? false : Exe.GetUserInput('$druidServerPatch', D_Choice, "rAthena server patch",
		"The Druid line also needs your server to know it. For a fresh rAthena (plain master), which has no "
	  + "Druid line yet, the server patch is written to a folder you pick next, to apply on the server with "
	  + "<b>git apply</b> and then rebuild it. It adds datawulf's Druid line (rathena#9765) with ours on top."
	  + "<br><br>Already applied an earlier copy? Choose Skip: the guide has an update file for it.",
		SKIP, {choices: [SKIP].concat(Object.keys(SERVER_PATCHES))});
	if (SERVER_PATCHES[pick])
	{
		Exe.GetUserInput('$druidServerDir', D_Folder, "Where to put the server patch",
			"Folder to write <b>" + SERVER_PATCHES[pick] + "</b> into. Carry it to your rAthena tree and apply "
		  + "it from the root of that tree. The default is beside the patched exe.",
			System.DirPath(Warp.TgtExe), {saveDefault: true});
		EnableDruidClasses.serverPatch = SERVER_PATCHES[pick];
		EnableDruidClasses.serverDir = Exe.GetSavedInput('$druidServerDir') || System.DirPath(Warp.TgtExe);
	}

	return true;
};

///
/// \brief Copy the bundled skill and job files once the exe has been written (when asked to).
///
/// The folder is the one answered in this build (10.1); a folder saved by an earlier build copies
/// nothing on its own. A copy already in the target is kept in the backup only when it is not ours
/// and no backup of it exists yet, so building again never backs up our own files or replaces the
/// operator's original. A missing folder means skip, never fail: the exe is already written.
///
/// ★ onApplied is called with `this` UNBOUND, so everything is reached by name.
///
EnableDruidClasses.onApplied = function()
{
	const _ = 'EnableDruidClasses.onApplied';
	if (Warp.TestMode)
		return;

	$$(_, 0.1, `Write the rAthena server patch the operator picked (10.2)`)
	const sp = EnableDruidClasses.serverPatch;
	const spSrc = sp && (Warp.Path + "examples/EnableDruidClasses/" + sp);
	if (sp && System.IsFile(spSrc) && System.MkDir(EnableDruidClasses.serverDir))
		System.Copy(spSrc, EnableDruidClasses.serverDir, true);

	const root = EnableDruidClasses.luaDir;
	if (!root)
		return;

	$$(_, 1.1, `Keep any copy already there that is not ours, then copy the five files`)
	const lua = "/data/luafiles514/lua files";
	const srcRoot = Warp.Path + "Inputs/DruidClasses" + lua;
	const bakRoot = root + "/EnableDruidClasses_backup" + lua;
	const hexOf = (path) =>
	{
		const f = new BinFile(path, 'r');
		if (!f.Valid)
			return null;
		const hex = f.ReadHex();
		f.Close();
		return hex;
	};

	for (const [dir, name] of [["/skillinfoz", "skillid.lub"],
	                           ["/skillinfoz", "skillinfolist.lub"],
	                           ["/skillinfoz", "skilldescript.lub"],
	                           ["/skillinfoz", "skilltreeview.lub"],
	                           ["/datainfo",   "pcjobname.lub"]])
	{
		const tgtDir = root + lua + dir;
		const src = srcRoot + dir + "/" + name;
		if (System.IsFile(tgtDir + "/" + name) && !System.IsFile(bakRoot + dir + "/" + name)
		 && hexOf(tgtDir + "/" + name) !== hexOf(src))
		{
			if (!System.MkDir(bakRoot + dir))
				return;
			System.Copy(tgtDir + "/" + name, bakRoot + dir);
		}
		if (!System.MkDir(tgtDir))
			return;
		System.Copy(src, tgtDir, true);
	}
};

///
/// \brief Only the 2025-07-16 client, whose job fillers this was measured on.
///
EnableDruidClasses.validate = function()
{
	return Exe.FindHex(" 81 F9 09 11 00 00") > 0 && Exe.FindHex(" 8D B1 50 80 00 00") > 0;
};
