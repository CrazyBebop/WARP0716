AllowDualCustomWeaponSprites = function(_)
{
	return AllowDualWeaponSprites(_ || "AllowDualCustomWeaponSprites");
};

AllowDualCustomWeaponSprites.validate = function()
{
	return AllowDualWeaponSprites.validate();
};
