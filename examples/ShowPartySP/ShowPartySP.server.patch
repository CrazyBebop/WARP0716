 }
 
 
+#ifdef SHOW_PARTY_SP  // WARP0716 #34
+/**
+ * Re-push an arriving member's HP+SP to the other party members on their map.
+ *
+ * The inline push in clif_parse_LoadEndAck is too early on a first login: it arrives in the
+ * same batch as the member-online notification, and the client drops an update for a row it
+ * has not built yet, leaving that member's SP half empty until something moves their HP.
+ * Verified in game 2026-08-26 - the identical push paints correctly once the row exists, so
+ * this is a timing fix rather than another attempt at the same cause.
+ * @param id: the arriving player's id
+ */
+static TIMER_FUNC(clif_party_sp_repush){
+	map_session_data* sd = map_id2sd( id );
+
+	if( sd == nullptr || sd->status.party_id == 0 ){
+		return 0;
+	}
+
+	struct party_data* pd = party_search( sd->status.party_id );
+
+	if( pd == nullptr ){
+		return 0;
+	}
+
+	for( int32 i = 0; i < MAX_PARTY; i++ ){
+		map_session_data* psd = pd->data[i].sd;
+
+		if( psd != nullptr && psd != sd && psd->m == sd->m ){
+			clif_hpmeter_single( *psd, sd->id, sd->battle_status.hp, sd->battle_status.max_hp );
+			// ...and the other direction. The arriving client builds ITS party rows in the same
+			// batch, so the inline others->arrival push in LoadEndAck is dropped just as often as
+			// the arrival->others one was, and the newcomer saw every existing member with an
+			// empty SP half until that member's SP next moved. Measured 2026-09-02 with two
+			// clients; an @heal on the standing member filled the half in the same frame.
+			clif_hpmeter_single( *sd, psd->id, psd->battle_status.hp, psd->battle_status.max_hp );
+		}
+	}
+
+	return 0;
+}
+#endif
+
+
 /// Notification from the client, that it has finished map loading and is about to display player's character (CZ_NOTIFY_ACTORINIT).
 /// 007d
 void clif_parse_LoadEndAck(int32 fd,map_session_data *sd)
@@ -10821,6 +10889,36 @@ void clif_parse_LoadEndAck(int32 fd,map_session_data *sd)
 	if(sd->status.party_id) {
 		party_send_movemap(sd);
 		clif_party_hp( *sd ); // Show hp after displacement [LuzZza]
+#ifdef SHOW_PARTY_SP  // WARP0716 #34
+		// clif_party_hp above only tells the OTHER members our HP+SP; it never sends
+		// us theirs. An idle party member already standing on the map therefore shows
+		// no SP bar until their next HP change. Push each same-map member's current
+		// HP+SP to us now (clif_hpmeter_single resolves the id to fill SP) so idle
+		// members fill in on load, matching what we broadcast about ourselves.
+		if( struct party_data* pd = party_search( sd->status.party_id ) ){
+			for( int i = 0; i < MAX_PARTY; i++ ){
+				map_session_data* psd = pd->data[i].sd;
+				if( psd != nullptr && psd != sd && psd->m == sd->m ){
+					clif_hpmeter_single( *sd, psd->id, psd->battle_status.hp, psd->battle_status.max_hp );
+					// ...and the mirror, which the block above was missing: tell THEM about US.
+					// clif_party_hp() above is PARTY_AREA_WOS, so it reaches nobody outside
+					// area_size, and a player already standing on the map is left showing the
+					// arriving member with an empty SP half (their gauge still holds the client
+					// patch's maxsp=1 seed) until the arrival's HP or SP next changes.
+					// Measured in game 2026-08-26 with two clients: whoever logged in SECOND saw
+					// everything, and the one already standing there saw no SP for the newcomer
+					// until an @heal moved it, at which point the bar filled in the same frame.
+					clif_hpmeter_single( *psd, sd->id, sd->battle_status.hp, sd->battle_status.max_hp );
+				}
+			}
+		}
+
+		// ...and once more shortly after. On a FIRST login the loop above is too early:
+		// it arrives with the member-online notification and the client drops an update
+		// for a row it has not built yet. Harmless when the inline push already worked,
+		// because it writes the same values.
+		add_timer( gettick() + 1000, clif_party_sp_repush, sd->id, 0 );
+#endif
 	}
 
 	if( sd->bg_id ) clif_bg_hp(sd); // BattleGround System
