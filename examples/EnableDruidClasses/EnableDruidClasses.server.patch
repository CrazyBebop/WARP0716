diff --git a/src/custom/druid_transform.hpp b/src/custom/druid_transform.hpp
new file mode 100644
index 000000000..f03759e88
--- /dev/null
+++ b/src/custom/druid_transform.hpp
@@ -0,0 +1,37 @@
+// Copyright (c) rAthena Dev Teams - Licensed under GNU GPL
+// For more information, see LICENCE in the main folder
+
+#ifndef CUSTOM_DRUID_TRANSFORM_HPP
+#define CUSTOM_DRUID_TRANSFORM_HPP
+
+// WARP0716 Enable Druid classes (2026): DR_WEREWOLF / DR_WERERAPTOR in the official packet order.
+//
+// The generic toggle (StatusSkillImpl) evaluates sc_start / status_change_end inside the
+// clif_skill_nodamage call, so the client receives the status change BEFORE the skill packet.
+// The kRO 2026 client plays the transformation effect from the skill packet only while the
+// actor is not yet transformed, so in that order it plays on release instead of on transform.
+// Official servers send the skill packet first; this handler does the same and then starts or
+// ends the status. Included by skills/druid/skill_factory_druid.cpp.
+
+class SkillDruidTransform : public SkillImpl {
+public:
+	SkillDruidTransform(e_skill skill_id) : SkillImpl(skill_id) {}
+
+	void castendNoDamageId(block_list *src, block_list *target, uint16 skill_lv, t_tick tick, int32& flag) const override {
+		sc_type type = skill_get_sc(getSkillId());
+
+		if (type == SC_NONE)
+			return;
+
+		status_change* tsc = status_get_sc(target);
+
+		clif_skill_nodamage(src, *target, getSkillId(), skill_lv);
+
+		if (tsc != nullptr && tsc->hasSCE(type))
+			status_change_end(target, type);
+		else
+			sc_start(src, target, type, 100, skill_lv, skill_get_time(getSkillId(), skill_lv));
+	}
+};
+
+#endif /* CUSTOM_DRUID_TRANSFORM_HPP */
