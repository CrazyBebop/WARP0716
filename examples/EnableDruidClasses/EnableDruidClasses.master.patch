+	int32 hits = 2;
+
+	if (sc != nullptr) {
+		if (sc->hasSCE(SC_ALPHA_PHASE) || sc->hasSCE(SC_INSANE3)) {
+			hits = 7;
+		} else if (sc->hasSCE(SC_INSANE2)) {
+			hits = 5;
+		} else if (sc->hasSCE(SC_INSANE)) {
+			hits = 3;
+		}
+	}
+
+	dmg.div_ = hits;
+}
